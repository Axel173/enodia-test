#!/bin/sh
# cgi-bin/token — отдаёт CSRF-токен синхронизатора. Фронт получает его GET-запросом
# (за HTTP-Basic) и кладёт в тело каждого POST-действия; cgi-bin/action сверяет.
# Зачем именно так: uhttpd НЕ пробрасывает в CGI кастомные заголовки / Origin /
# Referer (проверено на железе) — защиту на заголовке не построить. Токен в файле
# /tmp (RAM, mode 600): кросс-сайт его не прочитает (SOP + Basic-auth на /cgi-bin),
# значит чужая страница не сможет подделать POST, даже если браузер сам пришлёт
# закешированные Basic-креды. Токен hex (URL-safe, без проблем с urlencode).
echo "Content-Type: application/json; charset=utf-8"
echo "Cache-Control: no-store"
echo ""
TOKFILE=/tmp/enodia-panel-token
# Генерим из /proc/sys/kernel/random/uuid (32 hex после удаления дефисов): на этом
# busybox НЕТ `od`/`hexdump`, а uuid есть всегда и URL-safe.
# umask В СУБШЕЛЛЕ + переименование, а не `>` с chmod следом: перенаправление создаёт файл по
# umask процесса (у uhttpd это 0644), и токен успевал полежать с чужими правами до chmod.
# Временное имя с $$ — чтобы два одновременных запроса не писали в один файл; mv внутри /tmp
# атомарен, поэтому читатель видит либо прежний токен, либо целый новый, но не полстроки.
# РОТАЦИИ (TTL) У ТОКЕНА НЕТ — СОЗНАТЕЛЬНО, хотя внешний аудит её просил. Токен живёт до ребута,
# и возраст ему ничего не добавляет: он не секрет доступа, а СИНХРОНИЗАТОР — доказывает, что POST
# сформировала наша страница, а не чужая. Чужая страница не прочитает его ни через минуту, ни через
# неделю (SOP + Basic на /cgi-bin), а тот, кто уже читает /tmp роутера, — root, и токен ему не
# нужен. Сам по себе токен не пускает никуда: за ним стоят Basic и, если включён, второй фактор.
# Зато у ротации есть цена: живой POST может попасть ровно в момент смены. Панель это переживёт
# (tokPost делает ОДИН авто-ретрай на «неверный токен»), но импорт бэкапа переслал бы при этом
# заново до 2 МБ тела. Платить этим за свойство, которого у токена и нет, — не за что.
if [ ! -s "$TOKFILE" ]; then
	( umask 077; cat /proc/sys/kernel/random/uuid 2>/dev/null | tr -d '-' > "$TOKFILE.$$" )
	mv -f "$TOKFILE.$$" "$TOKFILE" 2>/dev/null || rm -f "$TOKFILE.$$"
fi
printf '{"token":"%s"}\n' "$(cat "$TOKFILE" 2>/dev/null)"
