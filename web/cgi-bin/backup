#!/bin/sh
# cgi-bin/backup — экспорт/импорт настроек панели одним файлом (.tar.gz). EOL строго LF.
#
#  GET  ?secrets=0  -> архив ТОЛЬКО поведенческих настроек (флаги, правила, списки, БЕЗ ключей):
#                      безопаснее шарить, но сервера/ключи не входят.
#  GET  ?secrets=1  -> ПОЛНЫЙ бэкап (включая awg.conf/configs/*, notify.conf и т.п. — КЛЮЧИ!).
#  POST (token + content=base64(.tar.gz)) -> импорт: распаковка во временный каталог с
#       проверкой путей (запрет '..'/абсолютных), затем whitelist-копирование в $ENODIA_STATE и
#       apply-bypass apply. Транспорт/несущую НЕ трогает (активация — отдельно в панели).
#
# Защита импорта: CSRF-токен (как cgi-bin/action), лимит тела, отбраковка небезопасных
# путей в архиве ДО распаковки, копирование ТОЛЬКО известных имён (имя файла из кода, не
# из архива → traversal невозможен). За HTTP-Basic, как вся панель.
ENODIA_DIR=/data/usr/app/enodia
ENODIA_STATE=${ENODIA_STATE:-/data/usr/app/enodia-state}
TOKFILE=/tmp/enodia-panel-token
# 2FA-гейт (totp.sh) — см. разбор в cgi-bin/status. Здесь он особенно уместен: полный бэкап
# несёт ключи VPN, а импорт переписывает настройки роутера.
[ -f /data/usr/app/enodia/totp.sh ] && { TOTP_LIB=1; . /data/usr/app/enodia/totp.sh; totp_gate_deny; }

# jesc — ЕДИНСТВЕННЫЙ конвейер «вывод скрипта → строка внутри JSON» (json-lib.sh; шим — как у
# остальных CGI). Здесь он нужен ровно одному месту: вердикт «что здесь не заработает» цитирует
# имя транспорта и выходов, а эти файлы приезжают ИЗ ЗАГРУЖЕННОГО АРХИВА, то есть их содержимое
# нам не подконтрольно. Кавычка в `.transport` без экранирования ломала бы JSON ответа, и панель
# показала бы «импорт не удался» поверх удавшегося импорта.
if [ -f "$ENODIA_DIR/json-lib.sh" ]; then . "$ENODIA_DIR/json-lib.sh"; fi
command -v jesc >/dev/null 2>&1 || {
	jtrim() { cat; }
	jesc() { tr -d '\033\r' | sed 's/\[[0-9;]*m//g' | tr '\n\t' '  ' | cut -c1-"$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
}

# Поведенческие настройки (БЕЗ секретов). Переживают ребут, лежат в $ENODIA_STATE.
# ПРАВИЛО СПИСКА: сюда входит ВСЁ, что человек настроил руками и что не является ключом/паролем.
# Список не выводится из кода сам (busybox), поэтому новая подсистема со своим персистом ОБЯЗАНА
# дописать себя СЮДА — иначе бэкап молча её не заметит, и это выяснится только при восстановлении.
# Так уже случилось: правила «Сайты и домены», группы, гео-категории и доп-выходы не входили в
# архив, и переустановка стёрла их без следа (ipset и dnsmasq-сниппеты живут в ОЗУ, восстановить
# было неоткуда). Дальше — по экранам панели, чтобы список можно было сверять глазами.
SETTINGS=".failover-mode .failover-escalate .transport-home .failover-home"          # режим и failover
SETTINGS="$SETTINGS .full-tunnel .bypass-ips .bypass-ifaces .bypass-guest"           # «мимо VPN»
SETTINGS="$SETTINGS .fullvpn-ips .fullvpn-ifaces .fullvpn-guest"                     # «целиком в VPN»
SETTINGS="$SETTINGS .bypass-dst .vpn-dst .port-rules .keep-vpn-ips .enodia-custom.conf" # правила: IP (оба направления!), порты, исключения из выреза, домены
SETTINGS="$SETTINGS groups geo/actions.tsv"                                          # группы правил и гео-категории
SETTINGS="$SETTINGS .dhcp-static"                                                    # закреплённые за устройствами адреса (DHCP-резервации)
SETTINGS="$SETTINGS .slots .byedpi-args .byedpi-args-s2 .byedpi-args-s3 .byedpi-args-s4"  # доп-выходы и их стратегии десинка
# `.zapret-cats` СНЯТ СОЗНАТЕЛЬНО (и возвращать не надо): писателей у файла нет с тех пор, как
# выбор категорий десинка переехал в гео-реестр, а zapret.sh при ближайшем `apply` видит файл и
# запускает разовую миграцию (migrate_cats) — то есть восстановление архива на УЖЕ мигрированной
# установке ре-триггерило бы её и возвращало «в десинк» тем категориям, которые человек снял.
# Обратная сторона принята: бэкап ЕЩЁ НЕ мигрированной установки старый выбор не увозит
# (переименованный `.zapret-cats.migrated` в архив тоже не входит) — миграция всё равно случится.
SETTINGS="$SETTINGS .zapret-on .zapret-args .desync-ips"                             # Zapret (+ устройства целиком в десинк)
SETTINGS="$SETTINGS .probe-pool .probe-pool-s2 .probe-pool-s3 .probe-pool-s4 .probe-pool-zapret"  # пулы проб браузер-свипа (+ эталоны калибровки)
SETTINGS="$SETTINGS .split-runet .notify-off"                                        # раздельный резолв рунета; «уведомления выключены»
SETTINGS="$SETTINGS .doh-on .doh-proto .doh-resolver .doh-auto .doh-nextdns-id"      # шифрованный DNS
SETTINGS="$SETTINGS .doh-custom-url .doh-custom-sni .doh-custom-ips"                 # ...и СВОЙ резолвер (адрес + якоря)
SETTINGS="$SETTINGS .dns-hosts .ipv6-block .tun-mtu .go-memlimit"                    # DNS-hosts, IPv6-блок, MTU, потолок ОЗУ демона
SETTINGS="$SETTINGS iplist.conf iplist.custom lists"                                 # списки и их источники
SETTINGS="$SETTINGS .gh-ref .gh-strict .gh-bin-tag .update-interval .subs-interval"  # обновления
SETTINGS="$SETTINGS .prefs .panel-layout"                                            # язык, тема, порядок карточек
SETTINGS="$SETTINGS .traffic-daily"                                                  # история трафика (посуточно)
# --- ЧТО НЕ ВХОДИТ И ПОЧЕМУ ------------------------------------------------------------------
# Блок ниже — не комментарий «на память», а ВТОРАЯ ПОЛОВИНА whitelist'а и единственный способ
# отличить «забыли дописать» от «решили не возить». Формат строки строгий и машиночитаемый:
#   `# EXCLUDE: <имя> — <причина>`; его сверяет local/check-consistency.ps1 (проверка C18): всякий
# персист проекта обязан быть ЛИБО в SETTINGS/SECRETS, ЛИБО здесь. Переменной не заводим намеренно
# — она уехала бы на флеш и парсилась на каждый HTTP-запрос ради того, что шеллу не нужно.
#
# EXCLUDE: .totp .totp-sessions .totp-pending .totp-recovery — бэкап не должен быть обходом второго фактора (.totp-recovery = коды восстановления, .totp-pending = секрет в процессе привязки)
# EXCLUDE: .panel-tls .panel-wan .panel-wan-ip — восстановление НЕ должно само открывать роутер в интернет (тот же класс, что server/.on)
# EXCLUDE: .support-key .support-relay — канал «режима поддержки»; импорт не должен его воскрешать
# EXCLUDE: .srv-checks — кэш проверок серверов, протухает за минуты
# EXCLUDE: .traffic-last — НЕ история, а СЫРОЙ замер счётчиков /proc/net/dev ЭТОЙ загрузки ЭТОГО
#   роутера (история — соседний .traffic-daily, он в архиве). Восстановленный, он делает первую же
#   дельту ложной: traffic-acct.sh сравнивает текущий счётчик с ним и трактует «меньше» как
#   обнуление ⇒ засчитывает в «сегодня» ВЕСЬ счётчик WAN с буста. Импорт с ДРУГОГО роутера ломает
#   это в любом направлении — и когда чужое число больше (ветка «обнуление»), и когда меньше
#   (дельта = разница двух чужих счётчиков), и когда у WAN там другое имя (eth0 против eth1).
#   Ровно тот симптом, который уже чинили как «сегодня 14.2 ГБ на свежей установке». Без файла
#   первый тик просто пропускает интервал (≤5 мин) — это штатное поведение первого запуска.
# EXCLUDE: .dns-seed-cache — «последний рабочий адрес server-host»: производное резолва (чинится первым же успешным подъёмом), к тому же на ДРУГОМ роутере это чужие адреса
# EXCLUDE: .ip-owner — снимок «кому принадлежал адрес, когда завели правило»: на ДРУГОМ роутере
#          MAC'и другие, и каждое восстановленное правило получило бы ложное «правила от другого
#          устройства». Отсутствие предупреждения безобиднее, чем предупреждение неверное.
# EXCLUDE: .bin-store .bin-manifest — про ЖЕЛЕЗО (внешний накопитель, размеры бинарей), не про настройки
# EXCLUDE: geo/.snap-* — снимки гео: пересобираются из источников, а импорт ограничен 2 МБ тела
# EXCLUDE: .zapret-cats .zapret-cats.migrated — мёртвый файл и его надгробие, см. комментарий выше
# EXCLUDE: .iplist.snapshot .iplist.count — производные наполнения tunnel-cidr
# EXCLUDE: .endpoint-bypass .endpoint-bypass-s* — авто-категория адресов эндпоинта, ставит сам плагин
# EXCLUDE: .last.bak.conf .last.bak.name — рабочие маркеры автооткла switch-vpn
# EXCLUDE: .subs-last — отметка времени последней закачки подписок
# EXCLUDE: .byedpi-test.conf .byedpi-test.json .byedpi-test.state — рабочие файлы CLI-тестера стратегий (конфиг кандидата, результаты прогона)
# EXCLUDE: .gh-repo — ЧУЖОЙ репозиторий-источник кода. В отличие от соседнего `.gh-ref` (тот
#          выбирает ветку/тег ВНУТРИ нашего репо) этот файл решает, ОТКУДА приедут исполняемые
#          файлы, и `SHA256SUMS` тут не страховка — суммы качаются из ТОГО ЖЕ репозитория.
#          Архив настроек люди пересылают в чат ⇒ импорт не имеет права молча переставить
#          источник кода. Заводится он руками на тестовом роутере, UI у него нет.
# EXCLUDE: .gh-backup — снимок скриптов ПЕРЕД обновлением (ротация 2): это откат апдейтера, а ~3 МБ манифеста в архив настроек не возят
# EXCLUDE: .proto-install.* .zapret-install.* .gh-update.* .uninstall.* — логи и состояния разовых операций
# EXCLUDE: .cron-saved — cron-строки, снятые ДЕАКТИВАЦИЕЙ этого роутера (их возвращает «включить»):
#          это состояние разовой операции, а не настройка, и на ДРУГОМ роутере оно ничего не значит
# EXCLUDE: .events .events-read — журнал уведомлений НЕ возим: тело события несёт ВНЕШНИЙ IP роутера
#          дословно (письмо о смене WAN-IP) и адреса серверов, а «настройки без ключей» — это архив,
#          который люди пересылают в чат. Возвращать — только в SECRETS и только осознанно.
# EXCLUDE: geo/providers.tsv — реестр провайдеров гео дормант: панель дропдауна не имеет,
#          svc_lines() жёстко отдаёт v2fly. Добавление завело бы вторую мёртвую запись.
# Секреты + конфиги + активные маркеры/рабочие файлы (входят только при secrets=1).
# .subs = URL-подписки (кред), .sub-names = имена серверов подписки — с конфигами (полный бэкап).
# server/ = «доступ домой»: ключ сервера, параметры обфускации, порт И ПРИВАТНЫЕ КЛЮЧИ ПИРОВ.
# Только в полный бэкап: без него переезд на другой роутер означал бы переиздание конфигов на
# всех телефонах (ключ пира восстановить неоткуда — он хранится здесь и нигде больше).
# .transport = какой транспорт был активен: рядом с .active/.xray-active/.hy2-active (какой
# КОНФИГ активен), потому что без конфигов оно бессмысленно. Сам импорт транспорт не поднимает.
SECRETS="awg.conf amnezia_for_awg.conf awg0.conf notify.conf xray.json hysteria.yaml .active .xray-active .hy2-active .transport .subs .sub-names .sub-picks configs xray-configs hy2-configs server"

if [ "$REQUEST_METHOD" = "POST" ]; then
	echo "Content-Type: application/json; charset=utf-8"
	echo "Cache-Control: no-store"
	echo ""
	fail() { printf '{"ok":false,"msg":"%s"}\n' "$1"; exit 0; }

	len=${CONTENT_LENGTH:-0}
	case "$len" in ''|*[!0-9]*) len=0 ;; esac
	{ [ "$len" -gt 0 ] && [ "$len" -le 2097152 ]; } || fail "пустой или слишком большой архив (>2 МБ)"
	body=$(head -c "$len")
	field() { echo "$body" | tr '&' '\n' | grep "^$1=" | head -1 | cut -d= -f2-; }
	# Слэш удваиваем ДО подстановки `\xXX`: `printf %b` разворачивает любые escape-последовательности,
	# а не только наши (разбор — в шапке urldecode у cgi-bin/action). Копия обязана быть побайтово
	# равна тамошней — стережёт C37.
	urldecode() { printf '%b' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/+/ /g; s/%\(..\)/\\x\1/g')"; }

	tok=$(field token)
	echo "$tok" | grep -qE '^[0-9a-f]+$' || fail "нет токена"
	{ [ -s "$TOKFILE" ] && [ "$tok" = "$(cat "$TOKFILE")" ]; } || fail "неверный токен (перезагрузи панель)"

	tmp="/tmp/restore.$$"
	rm -rf "$tmp" 2>/dev/null; mkdir -p "$tmp" || fail "нет места в /tmp"
	urldecode "$(field content)" | base64 -d 2>/dev/null > "$tmp/b.tgz"
	[ -s "$tmp/b.tgz" ] || { rm -rf "$tmp"; fail "битый или пустой архив (base64)"; }

	# Анти-traversal: отбраковываем архив, если ХОТЬ одна запись абсолютная или содержит '..'.
	# ЧЕСТНО ПРО ЭТУ СТРОКУ (замерено на BE7000 23.08.2026, стенд local/backup-import-test.sh):
	# на busybox она НЕ СРАБАТЫВАЕТ НИКОГДА, потому что грепает УЖЕ НОРМАЛИЗОВАННЫЙ листинг —
	# `../evil` tar печатает как `evil`, `sub/../../evil` как `evil`, `/etc/evil` как `etc/evil`.
	# Реально от побега защищает САМ tar: распаковка нормализует так же, и члены ложатся ВНУТРЬ
	# $tmp (проверено тремя архивами, собранными на ПК, — busybox такие не соберёт). Вторая
	# половина защиты — копирование по whitelist'у ИМЁН ИЗ КОДА ниже: что бы ни лежало в архиве,
	# в $ENODIA_STATE уедет только известное имя. Строку оставляем: она стоит ноль и остаётся верной для
	# сборок tar, которые имена НЕ нормализуют, — но полагаться на неё как на единственный рубеж
	# нельзя, и знать это надо ДО того, как кто-то решит «traversal у нас закрыт грепом».
	if tar -tzf "$tmp/b.tgz" 2>/dev/null | grep -qE '(^/|(^|/)\.\.(/|$))'; then
		rm -rf "$tmp"; fail "архив содержит небезопасные пути — отклонён"
	fi
	# Анти-SYMLINK: имя-проверка выше видит лишь ИМЯ члена (оно безопасно), но член может быть
	# СИМЛИНКОМ (configs -> /  или notify.conf -> /etc/shadow). Тогда (а) cp -rp/-p ниже прочитал
	# бы сквозь него произвольный файл хоста, либо (б) tar записал бы ПОСЛЕДУЮЩИЙ член СКВОЗЬ линк
	# НАРУЖУ $tmp. Отбраковываем по типу в длинном листинге ДО распаковки (первый символ mode:
	# «-» файл / «d» каталог допустимы; l/h/c/b/p/s = симлинк/хардлинк/спецфайл — отказ).
	if tar -tzvf "$tmp/b.tgz" 2>/dev/null | grep -qE '^[lhcbps]'; then
		rm -rf "$tmp"; fail "архив содержит симлинки/спецфайлы — отклонён"
	fi
	# …И ХАРДЛИНКИ, которых проверка ВЫШЕ не видит вообще. ЗАМЕРЕНО на BE7000 23.08.2026 — busybox
	# печатает два вида ссылок ПО-РАЗНОМУ, и режим выдаёт только один из них:
	#   lrwxrwxrwx 0/0 0 … ./sym  -> /etc/shadow    симлинк  — ловится по «l»
	#   -rw-r--r-- 0/0 0 … ./orig -> ./hard         ХАРДЛИНК — режим как у обычного файла
	# А ссылаться член может и на путь ХОСТА: распаковка идёт из-под root, `link("/etc/shadow",
	# "notify.conf")` пройдёт, и whitelist-копирование ниже утащит чужой файл в $ENODIA_STATE — откуда его
	# отдаст экспорт (`?secrets=1`). Общий признак у обоих видов один — СТРЕЛКА в листинге; наш
	# экспорт её не порождает никогда (tar czf по списку обычных файлов). Ценой этого имя файла
	# с подстрокой « -> » внутри архива тоже будет отвергнуто — но законный архив такого имени не
	# содержит: имена в whitelist'е приходят ИЗ КОДА, а имена конфигов панель пропускает через
	# `^[A-Za-z0-9._-]{1,80}$` (cgi-bin/action), где нет ни пробела, ни «>».
	if tar -tzvf "$tmp/b.tgz" 2>/dev/null | grep -q ' -> '; then
		rm -rf "$tmp"; fail "архив содержит ссылки на другие файлы — отклонён"
	fi
	( cd "$tmp" && tar -xzf b.tgz ) 2>/dev/null || { rm -rf "$tmp"; fail "не удалось распаковать архив"; }
	# Бэкстоп (на случай, если busybox tar -tv не пометил тип): появились симлинки после распаковки —
	# отбраковываем ДО whitelist-копирования (cp прошёл бы сквозь них к файлам хоста).
	if find "$tmp" -type l 2>/dev/null | grep -q .; then
		rm -rf "$tmp"; fail "в архиве найдены симлинки — отклонён"
	fi
	# Тот же бэкстоп для хардлинков — по ЧИСЛУ ССЫЛОК: у честного файла, распакованного в /tmp,
	# оно ровно 1. Считаем САМИ, потому что `find -links` в busybox 1.25.1 НЕТ ВООБЩЕ, а на
	# неизвестную опцию find печатает usage и ВОЗВРАЩАЕТ 0 ⇒ гард на нём был бы ТИХИМ no-op
	# (именно так первая версия этой проверки и «проходила» тест — поймано стендом
	# local/backup-import-test.sh 23.08.2026; с тех пор за классом следит C39).
	# Читаем ОДНИМ вызовом `ls -lR`, а не stat'ом на каждый файл: в архиве бывает под сотню
	# конфигов, и сотня форков в CGI — это секунды на ровном месте. Поле 2 у busybox `ls -l` —
	# число ссылок, строки файлов начинаются с «-» (симлинки «l» сюда не попадают, их снял
	# бэкстоп выше). Это ВТОРОЙ рубеж: первый — проверка по стрелке до распаковки.
	if ls -lR "$tmp" 2>/dev/null | awk '/^-/ && $2 != 1 { found = 1 } END { exit !found }'; then
		rm -rf "$tmp"; fail "в архиве найдены жёсткие ссылки — отклонён"
	fi

	# ПРЕЖНЕЕ ИМЯ В СТАРОМ АРХИВЕ. Имена копируются ИЗ КОДА (только так traversal невозможен), и
	# именно поэтому архив, снятый ДО ребрендинга, приносит `.awg-custom.conf`, а цикл ниже ищет
	# `.enodia-custom.conf` — доменные правила молча не восстановились бы при зелёном «импорт
	# прошёл», и счётчик их бы даже не посчитал. Сценарий не гипотетический: «снять старое →
	# поставить новое → вернуть настройки» — ровно то, что предлагает финальный экран мастера,
	# и ровно то, чего ребрендинг требует от каждого, кто уже стоял. Переименовался РОВНО один
	# файл whitelist'а, поэтому пара одна; она умрёт вместе со старыми архивами.
	# Переименовываем В РАСПАКОВАННОМ КАТАЛОГЕ, а не расширяем whitelist: список имён обязан
	# остаться единственной истиной о том, что вообще едет в $ENODIA_STATE.
	# `-f`, а НЕ `-e`: под этим именем в архиве может лежать КАТАЛОГ, и переименовав его мы
	# сами бы протащили каталог туда, где domain.sh ждёт файл.
	if [ -f "$tmp/.awg-custom.conf" ] && [ ! -e "$tmp/.enodia-custom.conf" ]; then
		mv "$tmp/.awg-custom.conf" "$tmp/.enodia-custom.conf" 2>/dev/null
	fi

	# Копируем ТОЛЬКО известные имена (из кода). Файл -> заменяем; каталог -> вливаем содержимое.
	restored=0
	for f in $SETTINGS $SECRETS; do
		[ -e "$tmp/$f" ] || continue
		if [ -d "$tmp/$f" ]; then
			mkdir -p "$ENODIA_STATE/$f" 2>/dev/null
			# Обычные имена — ОДНИМ `cp` (как было): в xray-configs бывает под сотню файлов, и
			# поштучный вызов стоил бы сотню форков в CGI. А вот dot-файлы busybox-глоб `*` НЕ
			# БЕРЁТ, и раньше на этой побочке держалось ровно одно НУЖНОЕ исключение — `server/.on`
			# (импорт архива не должен САМ открывать «доступ домой», это решает человек). Держать
			# нужное поведение на побочке нельзя: первый же dot-файл, заведённый новой подсистемой,
			# молча не восстановился бы — а замечают такое, только когда бэкап уже понадобился.
			# Поэтому dot-файлы верхнего уровня перебираем ЯВНО, а исключение НАЗВАНО. Вложенные
			# dot-файлы (`lists/*/.enabled`) и раньше приезжали: `cp -r` на КАТАЛОГ берёт его
			# содержимое целиком, глоб решает только верхний уровень. Несовпавший глоб busybox
			# отдаёт БУКВАЛЬНО ⇒ гард `[ -e ]`.
			_any=0
			if cp -rp "$tmp/$f"/* "$ENODIA_STATE/$f"/ 2>/dev/null; then _any=1; fi
			for _e in "$tmp/$f"/.[!.]* "$tmp/$f"/..?*; do
				[ -e "$_e" ] || continue
				case "$f/${_e##*/}" in
					server/.on) continue ;;   # «VPN-сервер включён» — включает человек, не архив
				esac
				if cp -rp "$_e" "$ENODIA_STATE/$f"/ 2>/dev/null; then _any=1; fi
			done
			if [ "$_any" = 1 ]; then restored=$((restored+1)); fi
		else
			# Имя может быть ВЛОЖЕННЫМ (geo/actions.tsv — берём реестр гео, но не снимки рядом
			# с ним): на свежей установке каталога ещё нет, и cp молча ушёл бы в никуда.
			case "$f" in */*) mkdir -p "$ENODIA_STATE/${f%/*}" 2>/dev/null ;; esac
			cp -p "$tmp/$f" "$ENODIA_STATE/$f" 2>/dev/null && restored=$((restored+1))
		fi
	done
	rm -rf "$tmp"
	[ "$restored" -gt 0 ] || fail "в архиве нет распознанных настроек (не наш бэкап?)"

	# Права на секреты (boot/repair-эквивалент). Транспорт не трогаем. Вырезы «мимо VPN» тоже
	# переигрываем, но НЕ здесь: их место — сразу за ядром маркировки (порядок heal.sh 5 → 5.5),
	# и гейт «выбран ли транспорт вообще» у них общий с ядром — см. цепочку ниже.
	chmod 600 "$ENODIA_STATE"/*.conf "$ENODIA_STATE"/xray.json "$ENODIA_STATE"/hysteria.yaml 2>/dev/null
	chmod 600 "$ENODIA_STATE"/configs/* "$ENODIA_STATE"/xray-configs/* "$ENODIA_STATE"/hy2-configs/* 2>/dev/null
	# Ключи «доступа домой» (server/) — распакованы правами архива; выставляем свои.
	# Флаг server/.on намеренно НЕ восстанавливается — исключение НАЗВАНО в цикле копирования выше
	# (раньше оно держалось на побочке busybox-глоба, что то же самое ровно до первого нового
	# dot-файла): восстановление бэкапа не должно САМО открывать порт роутера в интернет.
	chmod 700 "$ENODIA_STATE"/server 2>/dev/null; chmod 600 "$ENODIA_STATE"/server/* 2>/dev/null
	# ПРИМЕНЯЕМ, а не отсылаем к ребуту. Персист восстановлен, но ВСЁ живое состояние эфемерно:
	# ipset в RAM, dnsmasq-сниппеты в /tmp, а доменные правила панель читает из /etc. Раньше здесь
	# переигрывались только вырезы, и это было хуже, чем звучало: /etc/dnsmasq.d/enodia-custom.conf
	# импорт не трогал вовсе ⇒ карточка «Сайты и домены» показывала ПУСТОЙ список. Человек читал
	# это как «бэкап не сохранил правила», добавлял домен заново — и persist_save копировал пустой
	# живой файл ПОВЕРХ только что восстановленного персиста. Правила терялись насовсем.
	# Порядок цепочки — тот же, что в heal.sh: это единственное место, где он описан.
	# Фоном, потому что гео и группы идут секундами, а CGI обязан ответить сразу — иначе таймаут
	# в панели, и человек жмёт «Импорт» второй раз. Идиома фона на busybox: start-stop-daemon
	# -S -b -m -p (нет ни nohup, ни setsid; `-m -p` обязательны, иначе матч по /bin/sh даст
	# ложное «уже выполняется»).
	cat > /tmp/enodia-restore-apply.sh <<'RESTORE'
#!/bin/sh
ENODIA_DIR=/data/usr/app/enodia
cd "$ENODIA_DIR" || exit 1
exec >>/tmp/enodia-restore.log 2>&1
echo "=== $(date '+%Y-%m-%d %H:%M:%S') применение импортированных настроек ==="
# ВЫБРАН ЛИ ТРАНСПОРТ ВООБЩЕ. Установка «только панель» — ШТАТНОЕ первое состояние роутера (и
# ровно то, в котором чаще всего импортируют бэкап: перенос настроек на новый роутер). До выбора
# протокола роутер обязан работать КАК СТОК — наших правил в ядре нет вовсе. Импорт настроек не
# имеет права это нарушить: он восстанавливает ФАЙЛЫ, а не решает за человека, что включить.
# Гасим ровно то же, что heal.sh гасит на `active_t=none`: ядро маркировки (5) и вырезы (5.5).
# Остальное транспорта не требует и осмысленно само по себе (блокировка, DNS-оверрайды, десинк,
# резервации, списки) — его применяем всегда, иначе импорт молчал бы о том, что реально умеет.
# Ответ у оркестратора (`transport.sh configured`), своей копии признака не заводим; код 2 =
# старая копия скрипта ⇒ считаем «выбран», поведение прежнее.
TCFG=1
if [ -f ./transport.sh ]; then
    sh ./transport.sh configured >/dev/null 2>&1
    [ "$?" = 1 ] && TCFG=0
fi
[ "$TCFG" = 1 ] || echo "транспорт не выбран — ядро маркировки и вырезы не ставлю (роутер работает как сток)"
# 1. Доменные правила: персист -> живой файл -> наборы. restore ПЕРВЫМ и обязательно раньше, чем
#    панель успеет позвать domain.sh, иначе persist_save затрёт восстановленное пустым файлом.
[ -f ./domain.sh ] && { sh ./domain.sh restore; sh ./domain.sh apply; }
# 2. Группы и гео: реестры на /data восстановлены, всё применение эфемерно.
[ -f ./groups.sh ] && [ -s groups/groups.tsv ] && sh ./groups.sh apply
[ -f ./geo.sh ] && [ -s geo/actions.tsv ] && sh ./geo.sh reapply
# 3. Ядро маркировки — ПОСЛЕ групп и гео: слот-наборы grp_vpn_sN/geo_vpn_sN создаются там, и до
#    их появления mark-core метить нечего. Несущие доп-выходов НЕ трогаем: их поднимает панель
#    или ближайший ребут — рвать живой транспорт ради импорта настроек нельзя.
#    Сразу за ядром — вырезы «мимо VPN»/«целиком в VPN»/порты (порядок heal.sh 5 → 5.5:
#    последнее слово о ПОРЯДКЕ цепочек mangle остаётся за apply-bypass::ensure_prerouting_order).
#    Обоих зовём ЧЕРЕЗ `sh` и гардим по НАЛИЧИЮ файла — общая форма вызова во всём проекте
#    (разбор у plugin_for в transport.sh): гард на бите исполнения дал бы здесь молчаливый
#    пропуск ядра маркировки, то есть импорт «прошёл успешно» и правил в ядре нет.
if [ "$TCFG" = 1 ]; then
    [ -f ./mark-core.sh ] && sh ./mark-core.sh
    [ -f ./apply-bypass.sh ] && sh ./apply-bypass.sh apply >/dev/null 2>&1
fi
# 4. Десинк. Верб именно `apply`, а НЕ `rewire`: rewire только дособирает правила (ensure_set +
#    rules_add + conntrack) и демона не поднимает — подъём nfqws живёт ТОЛЬКО в cmd_apply
#    (`proc_alive || spawn_nfqws`). На роутере, где десинк был настроен, но после импорта демон
#    не бежит, правила NFQUEUE стояли БЕЗ демона: трафик не рвётся (--queue-bypass), десинк молча
#    не работает, а панель рапортует успех. cmd_apply сам гейтится на .zapret-on и на наличие
#    бинаря, DNS не трогает (set_direct_dns — привилегия zapret-как-ТРАНСПОРТА, не наша).
[ -f ./zapret.sh ] && [ -f ./.zapret-on ] && sh ./zapret.sh apply
# 5. Остальной персист того же класса «в архиве есть, применение эфемерно».
[ -f ./dns-hosts.sh ] && [ -s .dns-hosts ] && sh ./dns-hosts.sh apply
[ -f ./dns-split.sh ] && [ -f .split-runet ] && sh ./dns-split.sh apply
[ -f ./net-tune.sh ] && sh ./net-tune.sh apply
# 5b. Расписание обновлений. Маркеры .update-interval/.subs-interval из архива — это НАМЕРЕНИЕ;
#     истина для cron наступает только после `update-sched.sh apply`. Без него человек видел в
#     панели свой интервал, а роутер продолжал жить по установочному расписанию.
[ -f ./update-sched.sh ] && sh ./update-sched.sh apply >/dev/null 2>&1
# 5c. Пулы менеджера источников — ОФЛАЙН-подъём из снимков, приехавших в архиве (каталог `lists`
#     входит в whitelist). Иначе после импорта источники в панели есть, а сами пулы пусты до
#     ближайшего планового обновления — у zapret-cidr/zapret-dom это неделя. Сеть здесь НЕ нужна:
#     reapply читает lists/<cat>/.snapshot с флеша. Список категорий — ЕДИНЫЙ, из lists-lib.sh
#     (ls_opt_cats): та же идиома, что в heal.sh 5.8, четвёртого цикла по категориям не заводим.
if [ -f ./lists-update.sh ]; then
    _optc="adblock ipblock zapret-cidr zapret-dom"      # шим-фолбэк: старый lists-lib.sh без ls_opt_cats
    [ -f ./lists-lib.sh ] && _optc=$( . ./lists-lib.sh 2>/dev/null; ls_opt_cats 2>/dev/null )
    [ -n "$_optc" ] || _optc="adblock ipblock zapret-cidr zapret-dom"
    for _bc in $_optc; do
        [ -f "lists/$_bc/.enabled" ] || continue
        sh ./lists-update.sh reapply "$_bc" >/dev/null 2>&1 || true
    done
fi
# 5d. Закреплённые адреса: в архиве приехал персист резерваций, а сниппет `dhcp-host=` живёт в
#     ramfs — без переигрыша dnsmasq о них не узнает до ближайшего ребута, и восстановленные
#     правила по адресам поехали бы вместе с адресами. `norestart` — общий рестарт идёт шагом 6.
[ -f ./dhcp-static.sh ] && [ -s .dhcp-static ] && sh ./dhcp-static.sh apply norestart >/dev/null 2>&1
# 6. Рестарт dnsmasq — через агрегатор ipset=-строк, он же единственная точка рестарта для
#    подсистем. groups/geo зовут его сами внутри apply, здесь он финал и страховка.
#    ПОСЛЕ 5c: zapret-dom кладёт свои ipset=-строки, и до рестарта они не действуют.
[ -f ./dns-merge.sh ] && sh ./dns-merge.sh reload
# 7. Прогрев ПОСЛЕ рестарта: до него ipset=-правила ещё не загружены и резолв лёг бы мимо.
[ -f ./domain.sh ] && sh ./domain.sh warm
# 8. NSS/ECM-offload держит уже установленные соединения на прежнем маршруте. Флаш ОДИН на весь
#    импорт: он рвёт трансляции всему дому, звать его по подсистеме нельзя. Сброс — у владельца
#    (ct-lib.sh): на ядре 4.4 утилиты conntrack нет, и импорт применялся лишь к НОВЫМ соединениям.
ENODIA_DIR="$ENODIA_DIR"; if [ -f "$ENODIA_DIR/ct-lib.sh" ]; then . "$ENODIA_DIR/ct-lib.sh"; fi
if command -v ct_flush >/dev/null 2>&1; then ct_flush; else conntrack -F >/dev/null 2>&1; fi
# 9. И только теперь — СЕТЕВАЯ дозакачка списков, самым последним и фоном. Снимки из п.5c уже
#    подняли пулы, так что спешить некуда; зато источник мог смениться вместе с импортом, и
#    висеть неделю до планового обновления пул не должен. Каждая категория — свой фоновый
#    процесс с пидфайлом (start-stop-daemon -m -p обязателен: без него матч по /bin/sh даёт
#    ложное «уже выполняется»).
if [ -f ./lists-update.sh ]; then
    for _bc in $_optc; do
        [ -f "lists/$_bc/.enabled" ] || continue
        start-stop-daemon -S -b -m -p "/tmp/lists-$_bc.pid" \
            -x /bin/sh -- "$ENODIA_DIR/lists-update.sh" update "$_bc" >/dev/null 2>&1
    done
fi
[ -f ./iplist-update.sh ] && start-stop-daemon -S -b -m -p /tmp/iplist-restore.pid \
    -x /bin/sh -- "$ENODIA_DIR/iplist-update.sh" >/dev/null 2>&1
# 9б. ГЕО — тоже сетевой докачкой, и здесь она не «на всякий случай», а ЕДИНСТВЕННЫЙ путь.
#     У списков офлайн-подъём из снимка (п.5c) уже дал рабочий пул, а у гео снимки `geo/.snap-*`
#     в бэкап НЕ ВХОДЯТ намеренно (тело импорта ограничено 2 МБ) ⇒ `geo.sh reapply` в п.2
#     восстанавливать было НЕ ИЗ ЧЕГО и он честно ничего не сделал. Замерено на импорте
#     BE7000→AX3600: приехали 4 категории (среди них `cn → мимо` — то, чем лечится Mi Home), а
#     сетов geo_block/geo_bypass не появилось вовсе, и висело бы так до ребута или до планового
#     обновления. Тот же шаг, что делает heal.sh 5.13 (там reapply И фоновый update) — просто
#     здесь reapply без сети бесполезен, поэтому важен именно этот.
#     Пидфайл — ОБЩИЙ с heal (`/tmp/geo-update.pid`): имя тут принадлежит ЗАДАЧЕ, а не тому, кто
#     её завёл (так же живут `/tmp/lists-<cat>.pid` у heal, импорта и панели), и заодно это
#     бесплатное взаимное исключение — cron heal бежит раз в минуту и мог бы стартовать второй фетч.
[ -f ./geo.sh ] && [ -s geo/actions.tsv ] && start-stop-daemon -S -b -m -p /tmp/geo-update.pid \
    -x /bin/sh -- "$ENODIA_DIR/geo.sh" update >/dev/null 2>&1
echo "=== применение завершено ==="
RESTORE
	chmod +x /tmp/enodia-restore-apply.sh 2>/dev/null
	start-stop-daemon -S -b -m -p /tmp/enodia-restore-apply.pid \
		-x /bin/sh -- /tmp/enodia-restore-apply.sh >/dev/null 2>&1
	# ЧТО ИЗ ВОССТАНОВЛЕННОГО ЗДЕСЬ НЕ ЗАРАБОТАЕТ. Бэкап переносит НАМЕРЕНИЕ (какой транспорт, какие
	# доп-выходы, включён ли шифрованный DNS), а бинарей он не несёт и нести не может — они на два
	# порядка тяжелее. Импорт на СВЕЖУЮ установку («только панель») и на ДРУГУЮ модель — штатный
	# сценарий переезда, и до сих пор он кончался молча нерабочей конфигурацией: замерено на AX3600
	# 16.08.2026 — приехали `.transport=awg` без бинарей AmneziaWG и zapret-выход на ядро 4.4, где
	# NFQUEUE вырезан вовсе. Панель честно писала «VPN не активен» и ни слова о причине, а человек
	# читал это как «бэкап не восстановился».
	# Владелец ответа «что здесь может работать» ОДИН — `transport.sh list` (у awg «готов» = ОБА
	# бинаря, у zapret внутри уже спрошен `zapret.sh nfq-ok`), «установлена ли связка» —
	# `packages.sh list-json`. Своих проверок не заводим. Причину называем РАЗНУЮ: «нет компонента»
	# лечится кнопкой, «ядро не умеет NFQUEUE» не лечится ничем, и путать их нельзя.
	# Нет оркестратора (роутер старше него / файл потерян при частичном обновлении) — молчим:
	# пустой `_ready` иначе означал бы «ничего не работает», и человек с ЖИВЫМ туннелем получил бы
	# совет ставить то, что у него уже стоит. Общее правило проекта: нет владельца ответа — ведём
	# себя как раньше, байт-в-байт.
	_warn=""; _ready=""; _hasorc=0
	if [ -f "$ENODIA_DIR/transport.sh" ]; then _hasorc=1; _ready=$(sh "$ENODIA_DIR/transport.sh" list 2>/dev/null); fi
	# Причину называем РАЗНУЮ: «нет компонента» лечится кнопкой, «ядро не умеет NFQUEUE» не лечится
	# ничем. Отсутствие самого zapret.sh — это ПЕРВОЕ, а не второе: код 127 от `sh` не означает
	# вердикт о ядре, и путать их нельзя (иначе панель ставит диагноз, который нечем проверить).
	_why() {
		if [ "$1" = zapret ] && [ -f "$ENODIA_DIR/zapret.sh" ] \
		   && ! sh "$ENODIA_DIR/zapret.sh" nfq-ok >/dev/null 2>&1; then
			echo "ядро этого роутера не умеет NFQUEUE"
		else
			echo "компонента нет — поставьте в «Компонентах»"
		fi
	}
	_t=$(cat "$ENODIA_STATE/.transport" 2>/dev/null | tr -d ' \r\n')
	if [ "$_hasorc" = 1 ] && [ -n "$_t" ] && ! echo "$_ready" | grep -qx "$_t"; then
		_warn="$_warn Транспорт «$_t» выбран, но не запустится: $(_why "$_t")."
	fi
	# Слоты читаем ЧЕРЕЗ реестр (`list-enabled`: id⇥транспорт⇥конфиг⇥fallback), а не из `.slots`:
	# владелец формата один. Цикл — по подстановке, а НЕ `| while read`: в busybox правая часть
	# конвейера бежит в СУБШЕЛЛЕ, и накопленный там $_warn потерялся бы целиком.
	if [ "$_hasorc" = 1 ] && [ -f "$ENODIA_DIR/slots.sh" ]; then
		for _s in $(sh "$ENODIA_DIR/slots.sh" list-enabled 2>/dev/null | awk '{print $1":"$2}'); do
			_sid=${_s%%:*}; _stp=${_s##*:}
			[ -n "$_stp" ] || continue
			echo "$_ready" | grep -qx "$_stp" && continue
			_warn="$_warn Доп-выход №$_sid ($_stp) не заработает: $(_why "$_stp")."
		done
	fi
	# Спрашиваем ТОЧЕЧНЫЙ верб, а НЕ `list-json`: тот на каждую связку зовёт `gh-update.sh bin-ver`,
	# а он при отсутствующем кэше `.bin-manifest` уходит КАЧАТЬ манифест с GitHub — тремя кругами,
	# включая аварийный десинк. Свежая установка + импорт (наш главный сценарий) — ровно тот случай,
	# когда кэша ещё нет: ответ CGI завис бы на десятки секунд, панель словила бы таймаут, а человек
	# нажал бы «Импорт» второй раз. `pkg-state` ходит только по файловой системе.
	if [ "$(cat "$ENODIA_STATE/.doh-on" 2>/dev/null)" = on ] \
	   && [ "$(sh "$ENODIA_DIR/packages.sh" pkg-state doh 2>/dev/null)" = absent ]; then
		_warn="$_warn Шифрованный DNS включён, но его компонента нет — поставьте в «Компонентах»."
	fi
	if [ -f "$ENODIA_STATE/.panel-tls" ] \
	   && [ "$(sh "$ENODIA_DIR/packages.sh" pkg-state tls 2>/dev/null)" = absent ]; then
		_warn="$_warn HTTPS панели включён, но его компонента нет — поставьте в «Компонентах»."
	fi
	# Экранируем ВЕСЬ вердикт разом: внутри него имена транспорта и выходов, приехавшие из чужого
	# архива (см. шапку про jesc).
	# ЛИМИТ У jesc — В БАЙТАХ (`cut -c` в busybox режет байтами), а текст кириллический: 2000 байт
	# ≈ 1000 символов. Считаем по максимуму: транспорт + ТРИ доп-выхода (слоты 2..4) + DoH + TLS =
	# шесть строк ≈ 1200 байт. С прежними 600 хвост молча обрезался бы, и человек не узнал бы ровно
	# то, ради чего вердикт и заведён (замер: три предупреждения = уже ~500 байт).
	if [ -n "$_warn" ]; then
		_warn=$(printf '%s' " ВНИМАНИЕ, здесь заработает не всё:$_warn" | jesc 2000)
	fi
	printf '{"ok":true,"msg":"Восстановлено объектов: %s. Применяю правила — это занимает до минуты, обновите страницу. Списки источников поднимаются из снимков сразу, свежие версии докачиваются фоном. Сервер и протокол импорт не переключает — выберите их в панели.%s"}\n' "$restored" "$_warn"
	exit 0
fi

# --- GET: экспорт ---------------------------------------------------------------
withsec=0
case "$QUERY_STRING" in *secrets=1*) withsec=1 ;; esac
list="$SETTINGS"
[ "$withsec" = 1 ] && list="$SETTINGS $SECRETS"
present=""
for f in $list; do [ -e "$ENODIA_STATE/$f" ] && present="$present $f"; done

ts=$(date +%Y%m%d-%H%M%S 2>/dev/null)
case "$ts" in ''|*[!0-9-]*) ts=backup ;; esac

if [ -z "$present" ]; then
	echo "Content-Type: text/plain; charset=utf-8"
	echo "Cache-Control: no-store"
	echo ""
	echo "Нет настроек для экспорта (свежая установка?)."
	exit 0
fi

tag=$([ "$withsec" = 1 ] && echo full || echo settings)
echo "Content-Type: application/gzip"
echo "Content-Disposition: attachment; filename=enodia-$tag-$ts.tar.gz"
echo "Cache-Control: no-store"
echo ""
( cd "$ENODIA_STATE" && tar -cz $present 2>/dev/null )
