#!/bin/sh
# cgi-bin/action — управляющие действия панели (Фаза 2). Зовётся ТОЛЬКО POST-ом из
# самой панели (за HTTP-Basic). Каждое действие — это вызов СУЩЕСТВУЮЩЕГО безопасного
# скрипта; пользовательский ввод НИКОГДА не попадает в shell-команду (имя действия лишь
# выбирает ветку case, а аргументы скрипта захардкожены). Сами скрипты держат fail-open
# (safety_off при смерти VPS), так что «уронить интернет» действие не способно.
#
# Защита:
#  - только POST (GET/прочее -> отказ);
#  - CSRF-токен синхронизатора (сверка с /tmp/enodia-panel-token, его выдаёт cgi-bin/token);
#  - белый список действий; неизвестное -> отказ;
#  - тело <= 32 КБ (запас под загрузку конфига base64-ом; обычные действия — сотни байт).
#  - 2FA-гейт (totp.sh) — см. разбор в cgi-bin/status; включён = знать пароль панели мало.
[ -f /data/usr/app/enodia/totp.sh ] && { TOTP_LIB=1; . /data/usr/app/enodia/totp.sh; totp_gate_deny; }
echo "Content-Type: application/json; charset=utf-8"
echo "Cache-Control: no-store"
echo ""

ENODIA_DIR=/data/usr/app/enodia
ENODIA_BIN=${ENODIA_BIN:-/data/usr/app/enodia-bin}
ENODIA_STATE=${ENODIA_STATE:-/data/usr/app/enodia-state}
TOKFILE=/tmp/enodia-panel-token
SWITCH_LOCK=/tmp/enodia-switching.lock

# Где лежит бинарь — ЕДИНСТВЕННЫЙ ответ у store-lib. Пре-чеки ниже («xray не установлен»,
# «nfqws не установлен») судили по резидентному пути и с внешним накопителем ОТКАЗЫВАЛИ на
# рабочем компоненте: включить Zapret из панели было нельзя вовсе, хотя ⋮-меню его предлагало
# (`ready` считает transport.sh, а он store-aware). Гард `[ -f ]` обязателен: провалившийся `.`
# в busybox ash убивает шелл на месте, и шим ниже был бы мёртвым кодом.
if [ -f "$ENODIA_DIR/store-lib.sh" ]; then . "$ENODIA_DIR/store-lib.sh"; fi
command -v bin_path >/dev/null 2>&1 || bin_path() { printf '%s' "$ENODIA_BIN/$1"; }

fail() { printf '{"ok":false,"code":1,"msg":"%s"}\n' "$1"; exit 0; }

# jesc/jtrim — «вывод скрипта → строка внутри JSON». Живут в json-lib.sh: конвейер нужен ещё
# в cgi-bin/data (4 ветки), cgi-bin/2fa (3) и web-ui.sh, а общего файла у этой четвёрки нет
# (action/data сорсят store-lib, 2fa — totp.sh, web-ui — nf-i18n) — поэтому у примитива свой дом.
# Разбор трёх ловушек (байтовая обрезка UTF-8, нечётный `\` на границе, сырой TAB) — в шапке либы.
# ШИМ = ПРЕЖНЕЕ поведение этого файла: либа не доехала (старая установка) — ведём себя как раньше,
# а не падаем. Гард `[ -f ]` обязателен: провалившийся `.` в busybox ash убивает шелл на месте.
if [ -f "$ENODIA_DIR/json-lib.sh" ]; then . "$ENODIA_DIR/json-lib.sh"; fi
command -v jesc >/dev/null 2>&1 || {
	jtrim() { cat; }
	jesc() { tr -d '\033\r' | sed 's/\[[0-9;]*m//g' | tr '\n\t' '  ' | cut -c1-"$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
}

# dom_ok (dns-lib.sh) — «годится ли строка как домен в конфиге dnsmasq». Здесь она нужна как
# ВХОДНОЙ гард панели: поле «добавить домен» принимало что угодно длиной без потолка, а метка
# длиннее 63 символов роняет ВЕСЬ конфиг демона — то есть одна опечатка в поле оставляла всю сеть
# без DNS (класс «домен → IP», разобранный 15.08.2026). Владельцы (domain.sh/groups.sh) проверяют
# у себя тоже — здесь мы лишь отвечаем человеку сразу и понятной строкой.
# Сорсинг стоит 5 мс на POST (замерено на AX3600, самом слабом из поддержанных) — на фоне
# нескольких форков самого действия это ничто. Шим = ПРАВИЛО, а не прежнее поведение.
if [ -f "$ENODIA_DIR/dns-lib.sh" ]; then . "$ENODIA_DIR/dns-lib.sh"; fi
command -v dom_ok >/dev/null 2>&1 || {
	dom_ok() { [ -n "$1" ] && [ "${#1}" -le 253 ] || return 1
	           printf '%s' "$1" | grep -qE '^[A-Za-z0-9_-]{1,63}(\.[A-Za-z0-9_-]{1,63})*$'; }
}

# Ручной switch «побеждает» авто-failover. Пока панель переключает транспорт/сервер, держим
# switching-lock: watchdog его чтит (`[ -e лок ] && exit 0` в watchdog.sh), а xray/hy2
# cmd_failover прерывают перебор, увидев лок между итерациями. Снимаем на выходе CGI (процесс
# короткоживущий → лок не «залипает»). Иначе (инцидент 2026-07-09) юзерский выбор сервера гонялся
# с циклом cmd_failover, который переписывал .xray-active на каждой итерации, и не применялся.
# ЧУЖОЙ лок не трогаем (идиома take_switch_lock из transport.sh, она же в proto-install.sh):
# прежняя форма `: > лок` + безусловный `rm` в trap СНИМАЛА лок ЧУЖОГО владельца — клик по
# «переключить транспорт» посреди установки компонентов открывал сторожу дорогу в середину чужой
# операции. Замер: старая форма чужой лок сносила, новая — оставляет.
SWITCH_LOCK_MINE=0
hold_switch() {
	[ -e "$SWITCH_LOCK" ] || { : > "$SWITCH_LOCK" 2>/dev/null && SWITCH_LOCK_MINE=1; }
	trap 'drop_switch' EXIT INT TERM
}
drop_switch() { _rc=$?; [ "$SWITCH_LOCK_MINE" = 1 ] && rm -f "$SWITCH_LOCK" 2>/dev/null; return "$_rc"; }

[ "$REQUEST_METHOD" = "POST" ] || fail "только POST"

len=${CONTENT_LENGTH:-0}
case "$len" in ''|*[!0-9]*) len=0 ;; esac
{ [ "$len" -gt 0 ] && [ "$len" -le 32768 ]; } || fail "пустой или слишком большой запрос"
body=$(head -c "$len")

field() { echo "$body" | tr '&' '\n' | grep "^$1=" | head -1 | cut -d= -f2-; }
# urldecode для значений из формы (%XX и '+'). Применяем к ПОЛЬЗОВАТЕЛЬСКИМ полям
# (ip/cidr/domain/ifaces) ПЕРЕД строгой валидацией regex'ом — даже если декод
# пропустит мусор, валидация его отобьёт; в shell-команду уходит только то, что
# прошло whitelisted-regex.
# ПЕРВЫМ ДЕЛОМ УДВАИВАЕМ ОБРАТНЫЙ СЛЭШ, и только потом делаем из `%XX` последовательность `\xXX`:
# `printf %b` разворачивает ЛЮБЫЕ escape-последовательности, а не только наши. Пароль `C:\new`
# приезжал в роутер как `C:` + перевод строки (замерено на BE7000 23.08.2026), `pa$s\tab` — с
# табуляцией вместо `\t`. Инъекции тут нет (значения уходят в кавычках), но данные молча портятся,
# и человек видит это лишь как «панель не принимает мой пароль». Порядок в sed ЖЁСТКИЙ: удвой
# слэши ДО подстановки `\x`, иначе удвоятся и свои собственные, и `%5C` перестанет давать слэш.
# Копия этой строки живёт в cgi-bin/backup (общего файла у двух CGI нет — см. шапку json-lib.sh);
# побайтовое равенство копий стережёт C37.
urldecode() { printf '%b' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/+/ /g; s/%\(..\)/\\x\1/g')"; }
tok=$(field token)
act=$(field action)

echo "$tok" | grep -qE '^[0-9a-f]+$' || fail "нет токена"
{ [ -s "$TOKFILE" ] && [ "$tok" = "$(cat "$TOKFILE")" ]; } || fail "неверный токен (перезагрузи панель)"

# Запуск скрипта с ЗАХАРДкоженными аргументами, возврат JSON {ok,code,msg}.
run() {
	s="$1"; shift
	raw=$(sh "$ENODIA_DIR/$s" "$@" 2>&1); code=$?
	# Весь разбор текста — в jesc (ANSI, переводы строк/табы, эскейп, безопасная обрезка).
	msg=$(printf '%s' "$raw" | jesc 1000)
	printf '{"ok":%s,"code":%s,"msg":"%s"}\n' "$([ "$code" -eq 0 ] && echo true || echo false)" "$code" "$msg"
	exit 0
}

# Фоновый запуск БЕЗ nohup. На этом busybox НЕТ ни nohup, ни setsid — прежний
# `nohup sh … &` молча падал ("nohup: not found"), и фоновая задача (смена набора /
# обновление) НЕ стартовала вовсе: CGI успевал записать state=RUNNING, а скрипт не
# запускался → статус залипал в RUNNING навсегда. start-stop-daemon -b делает
# setsid (новая сессия) → процесс переживает завершение CGI/uhttpd. -m -p <pidfile>
# ОБЯЗАТЕЛЬНЫ: без них -x /bin/sh матчит ВСЕ процессы sh и даёт ложное «already
# running». Пид-файл чистим перед стартом (защита от устаревшего). Фолбэк — ( … & ).
spawn_bg() {  # spawn_bg <pidfile> <argv для /bin/sh…>:  spawn_bg /tmp/x.pid scr.sh apply X  |  spawn_bg /tmp/x.pid -c "cmd"
	pf="$1"; shift
	rm -f "$pf" 2>/dev/null
	if [ -x /sbin/start-stop-daemon ]; then
		start-stop-daemon -S -b -m -p "$pf" -x /bin/sh -- "$@" >/dev/null 2>&1
	else
		( sh "$@" >/dev/null 2>&1 & )
	fi
}

# ЕДИНАЯ точка запуска ДВИЖКА КОМПОНЕНТОВ (packages.sh) из панели: карточка «Компоненты»,
# кнопки «Установить» у DoH/HTTPS и установка/удаление Zapret ходят СЮДА.
# Зачем: те кнопки раньше звали fetch-bin сами — свой лог, свой лок и НИ ОДНОЙ проверки места,
# хотя свободных на /data бывает 4 МБ. Две такие кнопки, нажатые подряд, гарантированно давали
# ENOSPC посреди закачки; а снятие nfqws мимо движка уносило доп-выход, который на нём висит
# (гард «несёт выход» живёт в packages.sh, у кнопки его не было).
# Отказ ДОЛЖЕН приезжать синхронно: план считаем ДО фонового запуска, иначе причина оседает в
# логе, а человек видит бодрое «запущено» и пустой прогресс.
pkg_bg() {  # pkg_bg <ставим|-> <снимаем|-> <сообщение об успехе>
	[ -f "$ENODIA_DIR/packages.sh" ] || fail "packages.sh не установлен (обнови скрипты с GitHub)"
	pst=$(cat "$ENODIA_STATE/.proto-install.state" 2>/dev/null | tr -d ' \r\n')
	# Лок — КАТАЛОГ (mkdir атомарен, без TOCTOU), поэтому проверка именно -d: с прежним `-f`
	# гард не срабатывал НИКОГДА, и второй клик обнулял лог уже идущей установки.
	# RUNNING без живого лока = осиротевший статус (ребут посреди операции) — не блокируем,
	# иначе панель залипает навсегда.
	[ "$pst" = RUNNING ] && [ -d /tmp/proto-install.lock ] && fail "установка компонентов уже идёт — дождись завершения"
	pplan=$(sh "$ENODIA_DIR/packages.sh" plan "$1" "$2" 2>/dev/null | grep '^{' | tail -1)
	case "$pplan" in
		*'"ok":true'*) : ;;
		*)
			# Причина — словами движка: сперва гард удаления, потом ошибка плана, иначе место.
			pwhy=$(printf '%s' "$pplan" | sed -n 's/.*"why":"\([^"]*\)".*/\1/p')
			[ -n "$pwhy" ] || pwhy=$(printf '%s' "$pplan" | sed -n 's/.*"errors":\["\([^"]*\)".*/\1/p')
			[ -n "$pwhy" ] || pwhy="не хватает места на флеше — сними что-нибудь в карточке «Компоненты»"
			fail "$pwhy" ;;
	esac
	echo RUNNING > "$ENODIA_STATE/.proto-install.state"
	: > "$ENODIA_STATE/.proto-install.log"
	spawn_bg /tmp/proto-install.pid "$ENODIA_DIR/packages.sh" apply "$1" "$2"
	printf '{"ok":true,"code":0,"msg":"%s"}\n' "$3"
	exit 0
}

# clampint <raw> <default> <min> <max> — оставить цифры, подставить дефолт, зажать в диапазон.
clampint() {
	v=$(printf '%s' "$1" | tr -cd '0-9'); [ -n "$v" ] || v="$2"
	[ "$v" -lt "$3" ] && v="$3"; [ "$v" -gt "$4" ] && v="$4"; echo "$v"
}

# Анти-SSRF для ссылок (подписки + источники списков) и работа с реестром подписок живут в
# ОДНОМ месте — subs-lib.sh. Здесь была ВТОРАЯ копия `sub_host_public`, побайтово равная
# библиотечной: ровно та заготовка, из которой вырос «stale lists-lib» (первая же правка гарда
# — например, дыра с `http://[::1]:8088/` — чинилась бы в одной копии из двух).
# Нет файла (дрейф деплоя) — fail-closed: отказать в добавлении ссылки безопаснее, чем ходить
# root-curl'ом вообще без гарда. Шимы ниже определены ДО подключения, чтобы библиотека их
# перекрыла.
sub_host_public() { return 1; }
sub_names_keep_other() { _snf="${2:-$ENODIA_STATE/.sub-names}"; [ -f "$_snf" ] && grep -v "^sub-$1-" "$_snf"; return 0; }
if [ -f "$ENODIA_DIR/subs-lib.sh" ]; then . "$ENODIA_DIR/subs-lib.sh"; fi

# КТО ВЛАДЕЛ АДРЕСОМ В МОМЕНТ ЗАВЕДЕНИЯ ПРАВИЛА. Все правила проекта ключуются по IPv4, а адрес
# устройству лишь ОДОЛЖЕН на срок аренды: телефон с privacy-MAC переподключается, получает другой
# адрес — и правило остаётся на прежнем, то есть у устройства политики больше нет, а у соседа,
# занявшего адрес, появилась чужая. Отметку кладём здесь, потому что панель — единственное место,
# где правила заводят; читает её cgi-bin/data и показывает предупреждение в карточке устройства.
# Без библиотеки (старая установка) — молча ничего не пишем: поведение остаётся прежним.
if [ -f "$ENODIA_DIR/lease-lib.sh" ]; then . "$ENODIA_DIR/lease-lib.sh"; fi
command -v owner_note >/dev/null 2>&1 || owner_note() { return 0; }

# del_sub_configs <tag> — удалить конфиги ПОДПИСКИ <tag>, НЕ задев соседние. Теги подписок
# могут быть ПРЕФИКСАМИ друг друга («liberty» ⊂ «liberty-vpn»), а «-» разделяет и внутри тега →
# голый глоб sub-<tag>-*.json смёл бы и «sub-<tag>-vpn-*.json» соседа. Владелец файла = ДЛИНЕЙШИЙ
# тег-префикс среди ВСЕХ тегов .subs (зеркало ownerTag() в index.html). Удаляем лишь свои.
del_sub_configs() {
	_t="$1"; TAB=$(printf '\t')
	_tags="$_t"; [ -f "$ENODIA_STATE/.subs" ] && _tags="$_tags $(cut -d"$TAB" -f1 "$ENODIA_STATE/.subs" 2>/dev/null)"
	# ДВА каталога: подписка бывает смешанной (vless/vmess/trojan/ss ложатся xray-JSON'ом,
	# hysteria2 — YAML'ом), и удаление подписки обязано уносить оба — иначе hy2-конфиги
	# остаются сиротами с именем несуществующей подписки.
	for _f in "$ENODIA_STATE"/xray-configs/sub-"$_t"-*.json "$ENODIA_STATE"/hy2-configs/sub-"$_t"-*.yaml; do
		[ -e "$_f" ] || continue
		_b=$(basename "$_f"); _own=""; _ol=-1
		for _g in $_tags; do
			case "$_b" in sub-"$_g"-*) _gl=${#_g}; [ "$_gl" -gt "$_ol" ] && { _own="$_g"; _ol=$_gl; } ;; esac
		done
		[ "$_own" = "$_t" ] && rm -f "$_f" 2>/dev/null
	done
}

# --- Менеджер источников списков (lists-update.sh) ---------------------------
# Категории-whitelist для generic-верб src_*. tunnel-cidr — маршрутизация (CIDR через VPN);
# adblock/ipblock — блокировка, zapret-cidr — пул десинка ПО IP, zapret-dom — свой пул десинка ПО
# ДОМЕНАМ (все четыре off по умолчанию). tunnel-domains/bypass-ip — задел (реестр держит).
_valid_lcat() { case "$1" in tunnel-cidr|tunnel-domains|bypass-ip|adblock|ipblock|zapret-cidr|zapret-dom) return 0 ;; *) return 1 ;; esac; }
# Категории с мастер-тумблером (block_enable) + их подпись для сообщения. Верб исторически назван
# block_enable, но по смыслу это «включить опциональную категорию источников» — пулы десинка это не
# блокировка, поэтому текст берём отсюда, а не хардкодим «Блокировка».
_lcat_switchable() { case "$1" in adblock|ipblock|zapret-cidr|zapret-dom) return 0 ;; *) return 1 ;; esac; }
_lcat_label() { case "$1" in zapret-cidr) echo "Пул десинка по IP" ;; zapret-dom) echo "Свой пул десинка по доменам" ;; *) echo "Блокировка" ;; esac; }
# Нормализация введённого домена — ОДНО место на все пути (одиночное правило, пачка, любой клиент).
# Режем схему/путь/www и ВЕДУЩУЮ маску «*.».
# ПОЧЕМУ маска режется, а не поддерживается: она не нужна — dnsmasq в `ipset=/дом/сет` матчит домен
# И ВСЕ его поддомены сам, т.е. `ya.ru` уже накрывает mail.ya.ru и a.b.ya.ru (на этом стоит весь
# re-filter-список). До этого `*.ya.ru` просто отлетал в «недопустимый домен» (валидатор ниже не
# пускает «*»), и со стороны выглядело, будто маски «не работают», хотя они подразумеваются всегда.
# Режем ИМЕННО ЗДЕСЬ, ДО валидации: «*» не должен доехать до domain.sh — там имя подставляется в
# sed-выражение (`/^ipset=\/$1\/.*/d`), где «*» стал бы метасимволом регулярки.
norm_domain() { printf '%s' "$1" | sed 's|^https\?://||; s|/.*$||; s/^\*\.//; s/^www\.//'; }
# Пакетное добавление доменов «в туннель» из stdin (текст/файл/URL) — через domain.sh (он персистит
# и переигрывается на boot). Каждая строка чистится от схемы/пути/www/маски и валидируется как домен.
# ОДНИМ вызовом `add-many`, а не `add` на домен: у `add` полный цикл применения (рестарт dnsmasq +
# пересборка сета + `conntrack -F`) и стоит он ЧЕТЫРЕ секунды — замерено на BE7000. Пачка из 30
# доменов прежним путём = две минуты синхронного CGI, тридцать обрывов DNS у ВСЕЙ сети и таймаут
# запроса; человек видит «сбой», а роутер в это время всё ещё молотит.
bulk_domains() {
	_bt="/tmp/bulk-dom.$$"
	tr ',; \t\r' '\n\n\n\n\n' > "$_bt"
	_n=$(sh "$ENODIA_DIR/domain.sh" add-many < "$_bt" 2>/dev/null | tail -1)
	case "$_n" in
		''|*[!0-9]*)
			# Дрейф деплоя: domain.sh без add-many (старее панели) — прежний путь, медленный, но рабочий.
			_n=0
			while read -r _raw || [ -n "$_raw" ]; do
				_d=$(norm_domain "$_raw")
				dom_ok "$_d" || continue
				echo "$_d" | grep -qE '\.[A-Za-z]{2,}$' || continue
				sh "$ENODIA_DIR/domain.sh" add "$_d" >/dev/null 2>&1 && _n=$((_n + 1))
			done < "$_bt" ;;
	esac
	rm -f "$_bt" 2>/dev/null
	echo "$_n"
}
# Пакетное «мимо VPN» из stdin — через apply-bypass.sh add-dst (персист + boot-replay).
bulk_dsts() {
	_n=0
	for _c in $(tr ',;\r\n' '    '); do
		echo "$_c" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$' || continue
		sh "$ENODIA_DIR/apply-bypass.sh" add-dst "$_c" >/dev/null 2>&1 && _n=$((_n + 1))
	done
	echo "$_n"
}

case "$act" in
	ping)        printf '{"ok":true,"code":0,"msg":"pong"}\n'; exit 0 ;;
	vpn_on)      run vpn-toggle.sh on ;;
	vpn_off)     run vpn-toggle.sh off ;;
	repair)      run vpn-toggle.sh repair ;;
	switch_awg)    hold_switch; run transport.sh switch awg ;;
	switch_xray)   hold_switch; run transport.sh switch xray ;;
	switch_hy2)    hold_switch; run transport.sh switch hy2 ;;
	switch_byedpi) hold_switch; run transport.sh switch byedpi ;;
	# zapret — 5-й транспорт (десинк направо БЕЗ VPS): switch гасит туннель, весь трафик
	# напрямую, заблок-категории пробивает nfqws. Гард — бинарь должен быть установлен.
	switch_zapret) [ -x "$(bin_path nfqws)" ] || fail "nfqws не установлен — поставь его в «Компонентах»"; hold_switch; run transport.sh switch zapret ;;

	# --- Перезагрузка роутера. Фоном с задержкой, чтобы CGI успел ответить панели до разрыва.
	reboot)
		spawn_bg /tmp/panel-reboot.pid -c "sleep 2; reboot"
		printf '{"ok":true,"code":0,"msg":"Роутер перезагружается… панель вернётся через ~40-60 с (обнови страницу)."}\n'
		exit 0 ;;

	# --- SSH-КОНСОЛЬ (root). Полный доступ ПО ЯВНОМУ ВЫБОРУ пользователя: команда исполняется
	# как есть (sh -c) с правами root — это НЕ инъекция, а назначение фичи (гейт = HTTP-Basic +
	# CSRF-токен + доверенная LAN). Предупреждение об осторожности показывает панель. Неинтерактивно
	# (один запрос/ответ): интерактивные команды вроде top/vi не годятся. timeout рубит зависшую
	# команду (иначе висел бы весь запрос). Вывод (stdout+stderr) чистим от ANSI, экранируем для
	# JSON, переносы -> \n, кап ~100 КБ.
	console)
		cmd=$(urldecode "$(field cmd)")
		[ -n "$cmd" ] || fail "пустая команда"
		# busybox timeout здесь СТАРОГО синтаксиса: `timeout -t СЕК CMD` (новый `timeout СЕК CMD`
		# падает «can't execute '60'»). Детектим по успеху -t; иначе без таймаута.
		TO=""; if timeout -t 1 true >/dev/null 2>&1; then TO="timeout -t 60"; fi
		out=$($TO sh -c "$cmd" 2>&1); code=$?
		esc=$(printf '%s' "$out" | tr -d '\033\r' | sed 's/\[[0-9;]*m//g' | tr '\t' ' ' | head -c 100000 | jtrim | sed 's/\\/\\\\/g; s/"/\\"/g' | awk '{printf "%s\\n",$0}')
		printf '{"ok":%s,"code":%s,"out":"%s"}\n' "$([ "$code" -eq 0 ] && echo true || echo false)" "$code" "$esc"
		exit 0 ;;

	# --- РЕЖИМ ПОДДЕРЖКИ: временный обратный SSH-туннель разработчику (support.sh). Тестер жмёт
	# кнопку → роутер сам инициирует исходящее к VPS-релею (пробивает CGNAT), поверхность = SSH :22,
	# E2E-шифрование, авто-экспайр. support.sh печатает свой JSON-статус на stdout ({active,port,
	# expires_in} | {active:0,error}) и возвращает 0/1 → пробрасываем его как "status", ok=по коду.
	# Аутентификация: стоячий .support-key (приватные сборки, поле не нужно) ИЛИ одноразовый кред из
	# поля (per-session) → env SUPPORT_PW (в argv НЕ уходит — ps виден). ttl опционален (support.sh
	# сам клэмпит до cap 2ч; деф. 30 мин).
	support_on)
		ttl=$(field ttl); case "$ttl" in ''|*[!0-9]*) ttl=1800 ;; esac
		cred=$(urldecode "$(field cred)")
		[ -n "$cred" ] && export SUPPORT_PW="$cred"
		raw=$(sh "$ENODIA_DIR/support.sh" up "$ttl" 2>/dev/null); code=$?
		unset SUPPORT_PW
		# support.sh обязан печатать на stdout ТОЛЬКО JSON; подстраховка — берём последнюю {…}-строку.
		# Грабля: busybox `start-stop-daemon -K` пишет "stopped process…"/"no process… none killed" в
		# STDOUT (не stderr) → строка протекала в $out → битый JSON → фронт ловил catch «сбой запроса»,
		# хотя туннель реально поднимался/гасился. Гард держит контракт «CGI всегда отдаёт валидный JSON».
		out=$(printf '%s\n' "$raw" | grep '^{' | tail -n1)
		printf '{"ok":%s,"code":%s,"status":%s}\n' "$([ "$code" -eq 0 ] && echo true || echo false)" "$code" "${out:-null}"
		exit 0 ;;
	support_off)
		raw=$(sh "$ENODIA_DIR/support.sh" down 2>/dev/null)
		out=$(printf '%s\n' "$raw" | grep '^{' | tail -n1)   # тот же гард — только JSON-строка (см. support_on)
		printf '{"ok":true,"code":0,"status":%s}\n' "${out:-null}"
		exit 0 ;;
	# --- РЕЖИМ ПОДДЕРЖКИ через «код поддержки» (широкая сборка БЕЗ данных релея в билде). Тестер
	# вставляет base64-код от разработчика (`BE7SUP1 IP PORT USER PASSWORD`). Код уходит в support.sh
	# open-code ЧЕРЕЗ STDIN (не argv/env — пароль не светится в ps). support.sh провижнит релей
	# (.support-relay — координаты не секрет) и поднимает туннель паролем; ничего серверного в
	# билде/репе не хранится. Тот же контракт + гард «только {…}-строка», что у support_on.
	support_open)
		ttl=$(field ttl); case "$ttl" in ''|*[!0-9]*) ttl=1800 ;; esac
		scode=$(urldecode "$(field code)")
		[ -n "$scode" ] || fail "пустой код поддержки"
		raw=$(printf '%s' "$scode" | sh "$ENODIA_DIR/support.sh" open-code "$ttl" 2>/dev/null); rc=$?
		out=$(printf '%s\n' "$raw" | grep '^{' | tail -n1)
		printf '{"ok":%s,"code":%s,"status":%s}\n' "$([ "$rc" -eq 0 ] && echo true || echo false)" "$rc" "${out:-null}"
		exit 0 ;;
	# --- НАСТРОЙКИ панели (.prefs, key=value). Ключ — строгий whitelist (в файл уходит только
	# проверенное имя ключа), значение валидируется по типу ключа. Атомарная запись: переписать
	# без старой строки ключа + добавить новую. Чтение — cgi-bin/data section=prefs. Расширяемо:
	# новый knob = ветка валидации тут + строка чтения в emit_prefs.
	set_pref)
		k=$(field key); v=$(urldecode "$(field val)")
		case "$k" in
			egress_url)      echo "$v" | grep -qE '^https://[A-Za-z0-9._~-]+(/[A-Za-z0-9._~/-]*)?$' || fail "URL должен быть https://хост[/путь] (буквы, цифры, . _ ~ - /)" ;;
			sort_after_test) case "$v" in 0|1) : ;; *) fail "значение 0 или 1" ;; esac ;;
			del_dead_after_test) case "$v" in 0|1) : ;; *) fail "значение 0 или 1" ;; esac ;;
			autoping_min)    case "$v" in 0|5|10|15) : ;; *) fail "значение 0/5/10/15" ;; esac ;;
			balancer)        case "$v" in 0|1) : ;; *) fail "значение 0 или 1" ;; esac ;;
			theme)           case "$v" in auto|light|dark) : ;; *) fail "значение auto/light/dark" ;; esac ;;
			lang)            case "$v" in ru|en) : ;; *) fail "значение ru/en" ;; esac ;;
			*) fail "неизвестная настройка" ;;
		esac
		P="$ENODIA_STATE/.prefs"; tmp="$P.$$"
		{ [ -f "$P" ] && grep -v "^$k=" "$P"; printf '%s=%s\n' "$k" "$v"; } > "$tmp" 2>/dev/null && mv "$tmp" "$P" || { rm -f "$tmp" 2>/dev/null; fail "не удалось сохранить настройку"; }
		printf '{"ok":true,"code":0,"msg":"настройка сохранена"}\n'
		exit 0 ;;

	# --- РЕАЛЬНЫЙ тест xray-конфига (не пинг): xray-test.sh поднимает конфиг на временном socks
	# и проверяет фактический выход в интернет. Печатает свой JSON {ok,ip,ms|msg}. Имя — строгий
	# whitelist (в shell не уходит ничего, кроме прошедшего regex имени файла конфига).
	test_xray_server)
		[ -f "$ENODIA_DIR/xray-test.sh" ] || fail "xray-test.sh не установлен (обнови панель)"
		[ -x "$(bin_path xray)" ]  || fail "xray не установлен"
		name=$(urldecode "$(field name)")
		echo "$name" | grep -qE '^[A-Za-z0-9._-]{1,80}$' || fail "плохое имя конфига"
		[ -f "$ENODIA_STATE/xray-configs/$name.json" ] || fail "конфиг не найден"
		# Необязательный порт временного socks: панель шлёт разные (10812..10819) для ПАРАЛЛЕЛЬНОГО
		# теста группы серверов подписки. Строго валидируем (порт идёт в sed/netstat скрипта).
		port=$(field port); case "$port" in 1081[2-9]) : ;; *) port=10812 ;; esac
		sh "$ENODIA_DIR/xray-test.sh" "$name" "$port"
		exit 0 ;;

	# --- ТЕСТ СКОРОСТИ xray-конфига: качает известный размер через socks конфига → Мбит/с.
	# Тот же xray-test.sh в режиме speed (DRY). Жжёт реальный трафик (через VPS) → это РАЗОВОЕ
	# действие по кнопке, не часть «проверить все». Многопоточно (streams/dur, скрипт капит).
	speedtest_xray_server)
		[ -f "$ENODIA_DIR/xray-test.sh" ] || fail "xray-test.sh не установлен (обнови панель)"
		[ -x "$(bin_path xray)" ]  || fail "xray не установлен"
		name=$(urldecode "$(field name)")
		echo "$name" | grep -qE '^[A-Za-z0-9._-]{1,80}$' || fail "плохое имя конфига"
		[ -f "$ENODIA_STATE/xray-configs/$name.json" ] || fail "конфиг не найден"
		port=$(field port); case "$port" in 1081[2-9]) : ;; *) port=10812 ;; esac
		streams=$(field streams); case "$streams" in ''|*[!0-9]*) streams=4 ;; esac
		dur=$(field dur); case "$dur" in ''|*[!0-9]*) dur=12 ;; esac
		sh "$ENODIA_DIR/xray-test.sh" speed "$name" "$port" "$streams" "$dur"
		exit 0 ;;

	# --- Статические DNS-hosts (оверрайд домен→IP): dns-hosts.sh валидирует домен/IP и пишет
	# живой conf + reload. add печатает «ok» или сообщение об ошибке (exit != 0). del безопасен.
	dns_host_add)
		[ -f "$ENODIA_DIR/dns-hosts.sh" ] || fail "dns-hosts.sh не установлен (обнови панель)"
		dom=$(urldecode "$(field domain)"); ip=$(urldecode "$(field ip)")
		out=$(sh "$ENODIA_DIR/dns-hosts.sh" add "$dom" "$ip" 2>&1)
		case "$out" in
			ok) printf '{"ok":true,"code":0,"msg":"DNS-host добавлен"}\n' ;;
			*)  fail "${out:-не удалось добавить}" ;;
		esac
		exit 0 ;;
	dns_host_del)
		[ -f "$ENODIA_DIR/dns-hosts.sh" ] || fail "dns-hosts.sh не установлен (обнови панель)"
		dom=$(urldecode "$(field domain)")
		sh "$ENODIA_DIR/dns-hosts.sh" del "$dom" >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"DNS-host удалён"}\n'; exit 0 ;;

	# --- Раздельный резолв рунета (.ru/.рф/.su напрямую через RF-резолвер). dns-split.sh пишет
	# живой conf + reload dnsmasq. Только вкл/выкл (резолвер хардкод Яндекс — надёжный RF-дефолт).
	split_runet_on)
		[ -f "$ENODIA_DIR/dns-split.sh" ] || fail "dns-split.sh не установлен (обнови панель)"
		sh "$ENODIA_DIR/dns-split.sh" on >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"раздельный резолв рунета включён"}\n'; exit 0 ;;
	split_runet_off)
		[ -f "$ENODIA_DIR/dns-split.sh" ] || fail "dns-split.sh не установлен (обнови панель)"
		sh "$ENODIA_DIR/dns-split.sh" off >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"раздельный резолв рунета выключен"}\n'; exit 0 ;;

	# --- Сеть/MTU: MTU туннеля AmneziaWG (awg0) + блок клиентского IPv6-интернета. net-tune.sh
	# применяет флаги (.tun-mtu / .ipv6-block) и переигрывается heal.sh на буте.
	set_tun_mtu)
		[ -f "$ENODIA_DIR/net-tune.sh" ] || fail "net-tune.sh не установлен (обнови панель)"
		mtu=$(field mtu | tr -cd '0-9')
		[ -n "$mtu" ] || fail "нет значения MTU"
		{ [ "$mtu" -ge 1280 ] && [ "$mtu" -le 1500 ]; } 2>/dev/null || fail "MTU вне диапазона 1280..1500"
		echo "$mtu" > "$ENODIA_STATE/.tun-mtu"
		sh "$ENODIA_DIR/net-tune.sh" mtu >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"MTU awg0 = %s"}\n' "$mtu"; exit 0 ;;
	# Потолок кучи Go у демонов AmneziaWG. Значение ПРИМЕНЯЕТСЯ СТАРТОМ демона (на лету потолок
	# не меняется) ⇒ здесь только пишем флаг и честно говорим об этом в ответе; несущую сами не
	# роняем — рвать соединения всему дому ради настройки нельзя.
	set_go_memlimit)
		[ -f "$ENODIA_DIR/net-tune.sh" ] || fail "net-tune.sh не установлен (обнови панель)"
		gv=$(field value | tr -cd 'a-z0-9')
		case "$gv" in
			auto)   rm -f "$ENODIA_STATE/.go-memlimit" 2>/dev/null; gm="автоматически" ;;
			off)    echo off > "$ENODIA_STATE/.go-memlimit"; gm="без ограничения" ;;
			[0-9]*) { [ "$gv" -ge 16 ] && [ "$gv" -le 512 ]; } 2>/dev/null || fail "значение вне диапазона 16..512 МиБ"
			        echo "$gv" > "$ENODIA_STATE/.go-memlimit"; gm="$gv МиБ" ;;
			*)      fail "нет значения" ;;
		esac
		printf '{"ok":true,"code":0,"msg":"потолок памяти: %s — вступит в силу при следующем подъёме туннеля"}\n' "$gm"; exit 0 ;;
	ipv6_block_on)
		[ -f "$ENODIA_DIR/net-tune.sh" ] || fail "net-tune.sh не установлен (обнови панель)"
		: > "$ENODIA_STATE/.ipv6-block"
		sh "$ENODIA_DIR/net-tune.sh" ipv6 >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"IPv6-интернет клиентам заблокирован"}\n'; exit 0 ;;
	ipv6_block_off)
		[ -f "$ENODIA_DIR/net-tune.sh" ] || fail "net-tune.sh не установлен (обнови панель)"
		rm -f "$ENODIA_STATE/.ipv6-block" 2>/dev/null
		sh "$ENODIA_DIR/net-tune.sh" ipv6 >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"IPv6-интернет клиентам разрешён"}\n'; exit 0 ;;

	# --- Шифрованный DNS (DoH): тумблер + выбор резолвера. Слой doh-lib.sh (supervise локального
	# https_dns_proxy + каталог резолверов). Live-переигрыш DNS активного транспорта — через
	# transport.sh dns (единый верб): каждый DNS-сеттер плагина проходит через doh_apply_dns, поэтому
	# on ставит dnsmasq→127.0.0.1#5053 + марку резолвера, off возвращает прежний путь БАЙТ-В-БАЙТ.
	# Пока бинарь не вендорен — тумблер персистится, но doh_enabled=false ⇒ реального эффекта нет
	# (безопасно): карточка честно покажет «бинарь не установлен».
	doh_on)
		[ -f "$ENODIA_DIR/doh-lib.sh" ] || fail "doh-lib.sh не установлен (обнови панель)"
		ENODIA_DIR="$ENODIA_DIR"; . "$ENODIA_DIR/doh-lib.sh"
		echo on > "$ENODIA_STATE/.doh-on"
		sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1   # переиграть DNS активного транспорта → локальный DoH-прокси + марка резолвера
		if doh_installed; then
			printf '{"ok":true,"code":0,"msg":"Шифрованный DNS включён (резолвер: %s)"}\n' "$(doh_resolver_name)"; exit 0
		fi
		printf '{"ok":true,"code":0,"msg":"Включено, но бинарь DoH ещё не установлен — шифрование заработает после установки"}\n'; exit 0 ;;
	doh_off)
		[ -f "$ENODIA_DIR/doh-lib.sh" ] || fail "doh-lib.sh не установлен (обнови панель)"
		ENODIA_DIR="$ENODIA_DIR"; . "$ENODIA_DIR/doh-lib.sh"
		doh_resolver_mark del; doh_resolver_bypass del   # снять форс-марку/RETURN :443 текущего резолвера
		doh_stop                                          # погасить локальный прокси
		rm -f "$ENODIA_STATE/.doh-on" 2>/dev/null                  # ДО reapply: doh_apply_dns теперь вернёт 1 → прежний путь транспорта
		sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1
		# В прямом режиме (zapret/byedpi/fail-open) reapply мог тут же поднять DoH ЗАНОВО по авто-режиму —
		# честно об этом сказать, иначе «выключил, а он работает» выглядит багом.
		if command -v doh_auto_active >/dev/null 2>&1 && doh_auto_active; then
			printf '{"ok":true,"code":0,"msg":"Тумблер выключен; в прямом режиме DNS остаётся шифрованным (авто-режим)"}\n'; exit 0
		fi
		printf '{"ok":true,"code":0,"msg":"Шифрованный DNS выключен"}\n'; exit 0 ;;
	# Авто-режим: включать DoH САМ, когда туннеля нет (zapret/byedpi/fail-open) — там dnsmasq иначе
	# форвардит плейн UDP:53 и ISP может травить DNS. Дефолт вкл; функциональная проба в doh_apply_dns
	# откатит на прежний DNS, если резолвер недостижим. [[doh-direct-modes-backlog]]
	set_doh_auto)
		[ -f "$ENODIA_DIR/doh-lib.sh" ] || fail "doh-lib.sh не установлен (обнови панель)"
		ENODIA_DIR="$ENODIA_DIR"; . "$ENODIA_DIR/doh-lib.sh"
		v=$(field value | tr -cd 'a-z')
		case "$v" in on|off) : ;; *) fail "ожидается on|off" ;; esac
		if [ "$v" = off ]; then
			echo off > "$ENODIA_STATE/.doh-auto"
			doh_auto_active && doh_auto_rollback   # авто держит DNS прямо сейчас → снять до reapply
			sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1
			printf '{"ok":true,"code":0,"msg":"Авто-DNS в прямых режимах выключен"}\n'; exit 0
		fi
		rm -f "$ENODIA_STATE/.doh-auto" 2>/dev/null          # отсутствие файла = разрешено (дефолт)
		sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"Авто-DNS в прямых режимах включён"}\n'; exit 0 ;;
	set_doh_resolver)
		[ -f "$ENODIA_DIR/doh-lib.sh" ] || fail "doh-lib.sh не установлен (обнови панель)"
		ENODIA_DIR="$ENODIA_DIR"; . "$ENODIA_DIR/doh-lib.sh"
		r=$(field resolver | tr -cd 'a-z0-9')
		case " $(doh_resolver_list) " in *" $r "*) : ;; *) fail "неизвестный резолвер" ;; esac
		nid=$(field nextdns_id | tr -cd 'a-f0-9' | cut -c1-16)
		[ "$r" = nextdns ] && [ -z "$nid" ] && fail "для NextDNS укажите ID профиля"
		# --- СВОЙ резолвер: разобрать ввод и ПОСЧИТАТЬ ЯКОРЯ ДО единой правки состояния ---
		# Разбор и валидация — в doh-lib (doh_custom_parse), здесь только длина: поле приходит из
		# сети, и обрезать его до разбора дешевле, чем гонять регексп по мегабайту.
		cu=""; cs=""; cips=""
		if [ "$r" = custom ]; then
			# urldecode ОБЯЗАТЕЛЕН: панель шлёт значение через encodeURIComponent, и без декода
			# сюда приходит `https%3A%2F%2F…` — строгий разбор такое отвергает ЦЕЛИКОМ, то есть
			# поле не работало бы вовсе ни с одним адресом. Порядок «декод → обрезка» сознателен:
			# режем то, что человек ввёл, а не проценты. Пробелы НЕ трогаем — их края снимет
			# doh_custom_parse, а внутренние обязаны уронить разбор (см. его шапку).
			cin=$(urldecode "$(field custom_url | cut -c1-900)" | cut -c1-300)
			[ -n "$cin" ] || fail "укажите адрес своего резолвера"
			cp=$(doh_custom_parse "$cin") || fail "адрес не похож на резолвер: ждём https://хост/путь, tls://хост, имя или IP"
			cu=$(printf '%s' "$cp" | cut -f1); cs=$(printf '%s' "$cp" | cut -f2); ch=$(printf '%s' "$cp" | cut -f3)
			# DoT предъявляет имя в SNI, и `-s` у dot-proxy обязателен ⇒ голый IP с ним несовместим.
			# Говорим это ДО того, как что-то поменяли: иначе человек получил бы откат вместо ответа.
			[ "$(doh_proto)" = dot ] && [ -z "$cs" ] && fail "для DoT нужно ИМЯ резолвера (у IP нечего предъявить в SNI) — введите имя или переключите протокол на DoH"
			# Якоря считаем ЗДЕСЬ, пока DNS ещё держит ПРЕЖНИЙ (рабочий) резолвер — после переключения
			# резолвить было бы уже нечем. Пустой набор = отказ: без якорей в прямом режиме запросы к
			# резолверу попадут под десинк, то есть мы своими руками положим DNS всему дому.
			if [ -n "$cs" ]; then
				# Конвейер якорей — ОДИН на двоих (doh-lib::doh_anchor_ips), он же канонизирует
				# набор сортировкой: иначе первый же перерезолв в стороже объявил бы «адреса
				# сменились» лишь потому, что резолвер отдал те же A-записи в другом порядке.
				cips=$(doh_anchor_ips "$cs")
				[ -n "$cips" ] || fail "не удалось узнать адреса $cs — проверьте имя (сейчас DNS ещё работает через прежний резолвер)"
			else
				cips="$ch"
			fi
		fi
		# Прежний резолвер запоминаем ДО перезаписи: недостижимый новый откатим на него (проба ниже).
		prev=$(doh_resolver_name); prevnid=$(cat "$ENODIA_STATE/.doh-nextdns-id" 2>/dev/null)
		prevcu=$(cat "$ENODIA_STATE/.doh-custom-url" 2>/dev/null); prevcs=$(cat "$ENODIA_STATE/.doh-custom-sni" 2>/dev/null)
		prevcips=$(cat "$ENODIA_STATE/.doh-custom-ips" 2>/dev/null)
		# Teardown :443-правил СТАРОГО резолвера ДО записи нового (guard знает лишь текущий резолвер —
		# иначе марка/RETURN прежнего IP останутся висеть в mangle OUTPUT).
		doh_resolver_mark del; doh_resolver_bypass del
		echo "$r" > "$ENODIA_STATE/.doh-resolver"
		[ "$r" = nextdns ] && echo "$nid" > "$ENODIA_STATE/.doh-nextdns-id"
		# Своё — тремя файлами разом: URL (DoH), имя (SNI для DoT; пусто у литерала) и якоря.
		# Порядок «teardown выше → запись здесь → расстановка ниже» обязателен: правила снимаются
		# по ТЕКУЩЕМУ содержимому .doh-custom-ips, и переписать его раньше teardown значило бы
		# оставить марку/RETURN прежних адресов висеть в mangle навсегда.
		if [ "$r" = custom ]; then
			echo "$cu" > "$ENODIA_STATE/.doh-custom-url"
			echo "$cs" > "$ENODIA_STATE/.doh-custom-sni"
			echo "$cips" > "$ENODIA_STATE/.doh-custom-ips"
		fi
		# Под новый резолвер: DoH активен (тумблер ИЛИ авто держит DNS) → перезапустить прокси + переиграть
		# DNS (добавит марку/RETURN :443 НОВОГО резолвера). Выключен → просто персист, применится при включении.
		if doh_enabled || { command -v doh_auto_active >/dev/null 2>&1 && doh_auto_active; }; then
			doh_restart
			sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1
			# ФУНКЦИОНАЛЬНАЯ ПРОБА нового резолвера: dnsmasq уже смотрит на прокси с НОВЫМ URL — не
			# отвечает (недостижим/заблокирован ISP/битый NextDNS-ID) ⇒ вернуть ПРЕЖНИЙ резолвер, DNS
			# всего дома не рвём (симметрия авто-режима doh_apply_dns, только откат на резолвер, не на plain).
			# Заодно проба ГРЕЕТ TCP+TLS+HTTP/2 первого запроса — без неё пару секунд после смены клиенты
			# ловили «Try again» (та же грабля, что при включении тумблера, см. doh_apply_dns).
			# 4 попытки, а не дефолтные 2: холодная сессия к новому резолверу бывает медленной
			# (таймаут+перебор anycast-IP), а ложный откат выглядит как «резолвер не работает».
			if ! doh_probe 4; then
				doh_resolver_mark del; doh_resolver_bypass del
				echo "$prev" > "$ENODIA_STATE/.doh-resolver"
				if [ -n "$prevnid" ]; then echo "$prevnid" > "$ENODIA_STATE/.doh-nextdns-id"; else rm -f "$ENODIA_STATE/.doh-nextdns-id" 2>/dev/null; fi
				# Своё возвращаем ЦЕЛИКОМ, включая якоря: прежний резолвер тоже мог быть своим, и
				# полуоткат (имя старое, адреса новые) оставил бы правила на чужих IP.
				if [ -n "$prevcu" ]; then
					echo "$prevcu" > "$ENODIA_STATE/.doh-custom-url"; echo "$prevcs" > "$ENODIA_STATE/.doh-custom-sni"
					echo "$prevcips" > "$ENODIA_STATE/.doh-custom-ips"
				else
					rm -f "$ENODIA_STATE/.doh-custom-url" "$ENODIA_STATE/.doh-custom-sni" "$ENODIA_STATE/.doh-custom-ips" 2>/dev/null
				fi
				doh_restart
				sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1
				# ПРИЧИНА, а не «не отвечает». Отказ по сертификату выглядит для человека так же
				# («не работает»), но чинится совсем иначе — и такой отказ бывает ПЛАВАЮЩИМ: на
				# железе 14.08.2026 dns.comss.one по DoH прошёл 2 раза из 3, а по DoT — всегда.
				# Единственный, кто знает правду, — лог демона; ловим сигнатуру mbedTLS в свежем
				# хвосте (лог мы только что переписали рестартом, старое сюда не попадёт).
				why=""
				grep -q 'BADCERT_CN_MISMATCH' /tmp/doh.log 2>/dev/null && \
					why=" (сертификат резолвера не принят; у этого адреса такое бывает через раз — попробуйте протокол DoT)"
				[ -z "$why" ] && grep -q 'BADCERT' /tmp/doh.log 2>/dev/null && \
					why=" (сертификат резолвера не прошёл проверку)"
				# «возвращён custom» человеку ничего не говорит, когда прежний тоже был своим.
				pname="$prev"; [ "$prev" = custom ] && pname="прежний адрес"
				fail "резолвер $r не отвечает$why — возвращён $pname"
			fi
		fi
		printf '{"ok":true,"code":0,"msg":"Резолвер DoH: %s"}\n' "$r"; exit 0 ;;

	# --- Протокол шифрованного DNS: doh (HTTPS/:443) | dot (TLS/:853, наш dot-proxy). Зеркало
	# set_doh_resolver: teardown обоих портов (del в либе proto-agnostic), персист, при активном
	# DNS — перезапуск под новый бинарь + функциональная проба с откатом на прежний протокол.
	set_doh_proto)
		[ -f "$ENODIA_DIR/doh-lib.sh" ] || fail "doh-lib.sh не установлен (обнови панель)"
		ENODIA_DIR="$ENODIA_DIR"; . "$ENODIA_DIR/doh-lib.sh"
		v=$(field value | tr -cd 'a-z')
		case "$v" in doh|dot) : ;; *) fail "ожидается doh|dot" ;; esac
		prev=$(doh_proto)
		[ "$v" = "$prev" ] && { printf '{"ok":true,"code":0,"msg":"Протокол шифрованного DNS: %s"}\n' "$v"; exit 0; }
		[ -x "$(doh_bin_for "$v")" ] || fail "бинарь для $v не установлен — нажмите «Установить» в карточке"
		# Свой резолвер, введённый ГОЛЫМ IP,c DoT несовместим (в SNI нечего предъявить, а `-s`
		# обязателен). Сказать это ДО переключения — иначе doh_start молча не поднимется, проба
		# провалится и человек увидит откат вместо причины.
		[ "$v" = dot ] && [ "$(doh_resolver_name)" = custom ] && [ -z "$(dot_resolver_sni)" ] && \
			fail "у своего резолвера указан IP — для DoT нужно ИМЯ (или оставьте DoH)"
		doh_resolver_mark del; doh_resolver_bypass del
		echo "$v" > "$ENODIA_STATE/.doh-proto"
		if doh_enabled || { command -v doh_auto_active >/dev/null 2>&1 && doh_auto_active; }; then
			doh_restart
			sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1
			# Попыток больше дефолта: у DoT холодный старт стоит 3 с таймаута на IP + 3 с backoff,
			# и одиночная проба ложно объявляла «протокол не заработал» (железо 2026-07-27).
			if ! doh_probe 4; then
				doh_resolver_mark del; doh_resolver_bypass del
				echo "$prev" > "$ENODIA_STATE/.doh-proto"
				doh_restart
				sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1
				fail "протокол $v не заработал (резолвер не отвечает; :853 может резать провайдер) — возвращён $prev"
			fi
		fi
		printf '{"ok":true,"code":0,"msg":"Протокол шифрованного DNS: %s"}\n' "$v"; exit 0 ;;

	# --- Доустановка бинарей DoH ПО ВОЗДУХУ. Установка с ПК несёт их в payload, но обновившиеся
	# из панели (apply-scripts тянет только скрипты из манифеста) остаются без бинаря — карточка
	# честно пишет «не установлен», а поставить было нечем.
	# Ставит ДВИЖОК (packages.sh, связка doh = https-dns-proxy + dot-proxy): качаем ОБА
	# недостающих одной кнопкой — протокол переключается пикером, и «Установить» не должен
	# зависеть от текущего выбора. Арку и порог обрыва берёт fetch-bin из bin-manifest.txt
	# (у https-dns-proxy арки различаются в 27 раз, ручное число неизбежно врало одной из них).
	doh_fetch_bin)
		[ -x "$(bin_path https-dns-proxy)" ] && [ -x "$(bin_path dot-proxy)" ] && \
			{ printf '{"ok":true,"code":0,"msg":"Бинари DoH уже установлены"}\n'; exit 0; }
		pkg_bg doh - "Скачиваю компоненты шифрованного DNS…" ;;

	# --- Доступ к панели: HTTPS (panel-tls) и вход снаружи по WAN. Вся логика — в web-ui.sh
	# (он владеет и терминатором, и правилом в input_wan_rule); тут только валидация ввода и
	# ЧЕСТНЫЙ вердикт по факту: вербы печатают человеческий текст, поэтому итог перепроверяем
	# вербом json, а не парсингом сообщения (текст переводится/меняется — состояние нет).
	panel_tls_on)
		[ -f "$ENODIA_DIR/web-ui.sh" ] || fail "web-ui.sh не установлен (обнови панель)"
		[ -x "$(bin_path panel-tls)" ] || fail "бинарь panel-tls не установлен — сперва «Установить»"
		p=$(field port | tr -cd '0-9')
		if [ -n "$p" ]; then
			[ "$p" -gt 0 ] 2>/dev/null && [ "$p" -lt 65536 ] || fail "порт вне диапазона 1..65535"
		fi
		out=$(sh "$ENODIA_DIR/web-ui.sh" tls-on $p 2>&1 | jesc 200)
		st=$(sh "$ENODIA_DIR/web-ui.sh" json 2>/dev/null | grep '^{' | tail -1)
		case "$st" in *'"tls_running":true'*) : ;; *) fail "HTTPS не поднялся: $out" ;; esac
		printf '{"ok":true,"code":0,"msg":"HTTPS включён"}\n'; exit 0 ;;
	# СМЕНА ПАРОЛЯ ПАНЕЛИ ИЗ САМОЙ ПАНЕЛИ. До сих пор единственным владельцем был `web-ui.sh
	# setpass` — то есть SSH или ПК-установщик. Для типового «поставил родне/тестеру и настраиваю
	# удалённо» это значило «сменить пароль нечем»: панель отдаётся только по Basic, а Basic
	# меняется мимо панели. Текущий пароль тут спрашивать незачем — мы УЖЕ за Basic (и за 2FA,
	# если она включена), человек ввёл его секунду назад; это ровно та же логика, по которой
	# работает смена пароля в любой веб-панели.
	# Пароль приходит base64 (в нём бывают & и %, а form-поле — плоское), в команду уходит уже
	# декодированным и ПОСЛЕ проверки формы.
	panel_pass)
		[ -f "$ENODIA_DIR/web-ui.sh" ] || fail "web-ui.sh не установлен (обнови панель)"
		np=$(urldecode "$(field pass)" | base64 -d 2>/dev/null | tr -d '\r\n')
		[ -n "$np" ] || fail "пустой пароль"
		# Только печатаемый ASCII без пробелов: пароль уезжает в HTTP-Basic (base64 от
		# «user:pass»), и кириллица там зависит от кодировки, которую выберет БРАУЗЕР — то есть
		# человек рискует задать пароль, которым потом не войдёт. Нижняя граница 8 — панель
		# бывает открыта наружу по HTTPS.
		printf '%s' "$np" | grep -qE '^[!-~]{8,64}$' || fail "пароль: 8..64 символов, латиница/цифры/знаки, без пробелов"
		# ПЕРВЫЙ судья — КОД ВОЗВРАТА setpass, и конвейер с jesc тут разорван нарочно: в нём
		# `$?` принадлежал бы jesc, то есть ЛЮБОЙ отказ (нет бинаря uhttpd, пустой хэш, «No
		# space» на 20-МБ /data) уезжал бы наверх как успех.
		# `--no-restart` обязателен ИМЕННО ОТСЮДА: setpass сам применяет пароль (иначе живая панель
		# пускала бы по старому), но мы — потомок этого же uhttpd, и его смерть унесла бы наш ответ.
		# Перезапуск ниже, отвязанным шагом.
		out=$(sh "$ENODIA_DIR/web-ui.sh" setpass "$np" --no-restart 2>&1); rc=$?
		out=$(printf '%s' "$out" | jesc 200)
		[ "$rc" = 0 ] || fail "пароль не записан: $out"
		# ВТОРОЙ — факт: файл авторизации непуст. Сам по себе он ничего не доказывает (панель,
		# которая нам сейчас отвечает, без него бы не стартовала — условие истинно и ДО смены),
		# но ловит обрыв записи на полном флеше: `printf >` уже усёк файл, а дописать не смог.
		# Без пароля uhttpd не поднимется, и молчаливый рестарт отрезал бы человека от панели.
		[ -s "$ENODIA_DIR/web/uhttpd.conf" ] || fail "файл авторизации пуст — пароль НЕ записан: $out"
		# Пароль uhttpd читает ОДИН РАЗ при старте (-c), поэтому нужен рестарт — но не отсюда:
		# мы сами дочерний процесс этого uhttpd, и убив его сейчас, потеряли бы собственный ответ.
		# Поэтому отвязанный шаг с паузой: ответ уходит в браузер, и только потом панель встаёт
		# заново (та же идиома, что у purge в uninstall_run).
		spawn_bg /tmp/panel-pass.pid -c "sleep 2; sh '$ENODIA_DIR/web-ui.sh' restart"
		printf '{"ok":true,"code":0,"msg":"Пароль изменён. Панель перезапускается — браузер спросит новый пароль."}\n'
		exit 0 ;;
	panel_tls_off)
		[ -f "$ENODIA_DIR/web-ui.sh" ] || fail "web-ui.sh не установлен (обнови панель)"
		sh "$ENODIA_DIR/web-ui.sh" tls-off >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"HTTPS выключен (доступ снаружи снят вместе с ним)"}\n'; exit 0 ;;
	# Перевыпуск сертификата: нужен, если его выписали при неверных часах (RTC на роутере нет)
	# либо сменился hostname. Рвёт текущие HTTPS-сессии — браузер переспросит про самоподписанный.
	panel_tls_cert)
		[ -f "$ENODIA_DIR/web-ui.sh" ] || fail "web-ui.sh не установлен (обнови панель)"
		out=$(sh "$ENODIA_DIR/web-ui.sh" tls-cert 2>&1 | jesc 200)
		st=$(sh "$ENODIA_DIR/web-ui.sh" json 2>/dev/null | grep '^{' | tail -1)
		case "$st" in *'"cert":true'*) : ;; *) fail "сертификат не выписан: $out" ;; esac
		printf '{"ok":true,"code":0,"msg":"Сертификат перевыпущен"}\n'; exit 0 ;;
	# ОТКРЫТИЕ ПОРТА В ИНТЕРНЕТ. Гарды живут в web-ui.sh (без HTTPS не открываем вовсе), тут
	# добавляем честный ответ про CGNAT: правило встанет, но снаружи не достучаться — молчать об
	# этом нельзя, иначе человек будет искать поломку у себя.
	panel_wan_on)
		[ -f "$ENODIA_DIR/web-ui.sh" ] || fail "web-ui.sh не установлен (обнови панель)"
		out=$(sh "$ENODIA_DIR/web-ui.sh" wan-on 2>&1 | jesc 200)
		st=$(sh "$ENODIA_DIR/web-ui.sh" json 2>/dev/null | grep '^{' | tail -1)
		case "$st" in *'"wan_rule":true'*) : ;; *) fail "$out" ;; esac
		case "$st" in
			*'"wan_kind":"private"'*) printf '{"ok":true,"code":0,"msg":"Правило поставлено, но WAN-адрес приватный (CGNAT) — снаружи не откроется"}\n' ;;
			*) printf '{"ok":true,"code":0,"msg":"Доступ снаружи открыт"}\n' ;;
		esac
		exit 0 ;;
	panel_wan_off)
		[ -f "$ENODIA_DIR/web-ui.sh" ] || fail "web-ui.sh не установлен (обнови панель)"
		sh "$ENODIA_DIR/web-ui.sh" wan-off >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"Доступ снаружи закрыт"}\n'; exit 0 ;;
	# Доустановка panel-tls ПО ВОЗДУХУ — та же схема, что doh_fetch_bin: обновившиеся из панели
	# (apply-scripts везёт только скрипты манифеста) иначе остались бы без бинаря и без способа
	# его получить. Ставит движок — он же считает место (panel-tls мелкий, но на 4 свободных МБ
	# «мелкий» решает не глазомер, а резерв).
	panel_tls_fetch_bin)
		[ -x "$(bin_path panel-tls)" ] && { printf '{"ok":true,"code":0,"msg":"Бинарь HTTPS уже установлен"}\n'; exit 0; }
		pkg_bg tls - "Скачиваю компонент HTTPS…" ;;

	# --- «Доступ домой»: роутер как VPN-СЕРВЕР (vpn-server.sh) ------------------
	# Направление обратное всему остальному: не роутер идёт к VPS, а телефон приходит к роутеру.
	# id пира строгий 2..9 (последний октет подсети), имя НЕ валидируем — vpn-server.sh хранит его
	# base64 и в команду не подставляет (та же схема, что у слотов). Итог сверяем вербом json:
	# вербы печатают человеческий текст, а он переводится — состояние надёжнее.
	vpnsrv_on)
		[ -f "$ENODIA_DIR/vpn-server.sh" ] || fail "vpn-server.sh не установлен (обнови скрипты роутера)"
		out=$(sh "$ENODIA_DIR/vpn-server.sh" up 2>&1 | jesc 300)
		st=$(sh "$ENODIA_DIR/vpn-server.sh" json 2>/dev/null | grep '^{' | tail -1)
		case "$st" in *'"running":true'*) ;; *) fail "сервер не поднялся: $out" ;; esac
		# Серый WAN — правило встанет, но снаружи не достучаться. Молчать нельзя: человек будет
		# искать поломку в телефоне (тот же довод, что у доступа к панели снаружи).
		case "$st" in
			*'"wan_private":true'*) printf '{"ok":true,"code":0,"msg":"Сервер поднят, но WAN-адрес приватный (CGNAT) — снаружи не подключиться"}\n' ;;
			*) printf '{"ok":true,"code":0,"msg":"Доступ домой включён"}\n' ;;
		esac
		exit 0 ;;
	vpnsrv_off)
		[ -f "$ENODIA_DIR/vpn-server.sh" ] || fail "vpn-server.sh не установлен (обнови скрипты роутера)"
		sh "$ENODIA_DIR/vpn-server.sh" down >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"Доступ домой выключен"}\n'; exit 0 ;;
	vpnsrv_peer_add)
		[ -f "$ENODIA_DIR/vpn-server.sh" ] || fail "vpn-server.sh не установлен (обнови скрипты роутера)"
		name=$(urldecode "$(field name)")
		[ -n "$name" ] || fail "нужно имя устройства"
		raw=$(sh "$ENODIA_DIR/vpn-server.sh" peer-add "$name" 2>&1)
		# Берём МАШИННУЮ строку «id⇥ip», а не человеческий текст (урок groups.sh new).
		TABC=$(printf '\t')
		line=$(printf '%s\n' "$raw" | grep "$TABC" | head -1)
		nid=$(printf '%s' "$line" | cut -f1); nip=$(printf '%s' "$line" | cut -f2)
		case "$nid" in 2|3|4|5|6|7|8|9) ;; *) fail "$(printf '%s' "$raw" | jesc 200)" ;; esac
		printf '{"ok":true,"code":0,"id":%s,"ip":"%s","msg":"Устройство добавлено"}\n' "$nid" "$nip"; exit 0 ;;
	vpnsrv_peer_del|vpnsrv_peer_mode|vpnsrv_peer_lan|vpnsrv_peer_toggle|vpnsrv_peer_rename|vpnsrv_peer_conf)
		[ -f "$ENODIA_DIR/vpn-server.sh" ] || fail "vpn-server.sh не установлен (обнови скрипты роутера)"
		pid=$(field id); case "$pid" in 2|3|4|5|6|7|8|9) ;; *) fail "битый id устройства" ;; esac
		case "$act" in
			vpnsrv_peer_del)  run vpn-server.sh peer-del "$pid" ;;
			vpnsrv_peer_mode) md=$(field mode); case "$md" in split|vpn|direct) ;; *) fail "режим: split|vpn|direct" ;; esac
			                  run vpn-server.sh peer-mode "$pid" "$md" ;;
			vpnsrv_peer_lan)  en=$(field enabled); case "$en" in 0|1) ;; *) fail "нужно 0|1" ;; esac
			                  run vpn-server.sh peer-lan "$pid" "$([ "$en" = 1 ] && echo on || echo off)" ;;
			vpnsrv_peer_toggle) en=$(field enabled); case "$en" in 0|1) ;; *) fail "нужно 0|1" ;; esac
			                  run vpn-server.sh peer-toggle "$pid" "$([ "$en" = 1 ] && echo on || echo off)" ;;
			vpnsrv_peer_rename) nm=$(urldecode "$(field name)"); [ -n "$nm" ] || fail "нужно имя"
			                  run vpn-server.sh peer-rename "$pid" "$nm" ;;
			# Конфиг несёт ПРИВАТНЫЙ КЛЮЧ телефона: отдаём base64-ом одним полем (переводы строк в
			# JSON на busybox не заэкранировать), а показывает его панель — за Basic + 2FA.
			vpnsrv_peer_conf)
				raw=$(sh "$ENODIA_DIR/vpn-server.sh" peer-conf "$pid" 2>/dev/null)
				case "$raw" in *'[Interface]'*) ;; *) fail "конфиг не собран — не определён внешний адрес?" ;; esac
				printf '{"ok":true,"code":0,"conf_b64":"%s"}\n' "$(printf '%s' "$raw" | base64 | tr -d '\n')"; exit 0 ;;
		esac ;;
	# Адрес для клиентских конфигов вручную: DDNS-имя вместо голого IP (конфиг телефона тогда не
	# протухает при смене WAN-адреса). Пустое значение = вернуться к автодетекту.
	vpnsrv_endpoint)
		[ -f "$ENODIA_DIR/vpn-server.sh" ] || fail "vpn-server.sh не установлен (обнови скрипты роутера)"
		h=$(urldecode "$(field host)" | tr -d ' \t\r\n')
		case "$h" in '') ;; *[!A-Za-z0-9.:_-]*) fail "в адресе есть недопустимые символы" ;; esac
		run vpn-server.sh endpoint-set "$h" ;;

	# --- Периодичность обновления списков источников (iplist + включённые adblock/ipblock). update-sched.sh
	# владеет cron-строкой iplist-update.sh и маркером .update-interval (переживает ребут/переустановку).
	set_update_interval)
		[ -f "$ENODIA_DIR/update-sched.sh" ] || fail "update-sched.sh не установлен (обнови панель)"
		iv=$(field interval | tr -cd 'a-z0-9')
		case "$iv" in off|6h|12h|daily|weekly) : ;; *) fail "неизвестный интервал" ;; esac
		got=$(sh "$ENODIA_DIR/update-sched.sh" set "$iv" 2>/dev/null)
		printf '{"ok":true,"code":0,"msg":"расписание обновления списков: %s"}\n' "$got"; exit 0 ;;

	# --- Периодичность HEADLESS-обновления подписок (subs-update.sh update по cron). Отдельная
	# задача того же владельца cron (update-sched.sh job `subs`), маркер .subs-interval. Дефолт
	# off: подписка ходит по ЧУЖОЙ ссылке, включать это за пользователя молча — не наше решение.
	set_subs_interval)
		[ -f "$ENODIA_DIR/update-sched.sh" ] || fail "update-sched.sh не установлен (обнови панель)"
		[ -f "$ENODIA_DIR/subs-update.sh" ] || fail "subs-update.sh не установлен (обнови скрипты роутера)"
		iv=$(field interval | tr -cd 'a-z0-9')
		case "$iv" in off|6h|12h|daily|weekly) : ;; *) fail "неизвестный интервал" ;; esac
		got=$(sh "$ENODIA_DIR/update-sched.sh" set subs "$iv" 2>/dev/null)
		printf '{"ok":true,"code":0,"msg":"автообновление подписок: %s"}\n' "$got"; exit 0 ;;
	# Прогон подписок ПРЯМО СЕЙЧАС тем же путём, что у cron (не браузерным разбором). Это же
	# зовёт ⟳ в списке серверов: правила «какой выход взять из пула» и «как назвать файл» живут
	# в subs-update.sh, и вторая (браузерная) их копия тасовала серверы по файлам на каждом
	# ручном обновлении. Необязательная метка = обновить ОДНУ подписку (кнопка ⟳ у неё), без
	# метки = все (кнопка в «Настройках»). Фоном: разбор десятков серверов дольше таймаута CGI.
	subs_update_now)
		[ -f "$ENODIA_DIR/subs-update.sh" ] || fail "subs-update.sh не установлен (обнови скрипты роутера)"
		[ -s "$ENODIA_STATE/.subs" ] || fail "подписок нет — добавьте подписку в списке серверов"
		tag=$(field tag)
		if [ -n "$tag" ]; then
			echo "$tag" | grep -qE '^[a-z0-9-]{1,16}$' || fail "плохая метка подписки"
			TAB=$(printf '\t')
			grep -q "^$tag$TAB" "$ENODIA_STATE/.subs" 2>/dev/null || fail "подписка не найдена"
			spawn_bg /tmp/subs-update-cgi.pid "$ENODIA_DIR/subs-update.sh" update "$tag"
		else
			spawn_bg /tmp/subs-update-cgi.pid "$ENODIA_DIR/subs-update.sh" update
		fi
		printf '{"ok":true,"code":0,"msg":"обновляю подписки на роутере — результат появится через минуту"}\n'; exit 0 ;;

	# --- Раскладка панели (порядок/свёрнутость секций + порядок подписок) → .panel-layout.
	# Персист НА РОУТЕРЕ (а не localStorage), чтобы раскладка ехала за юзером между устройствами.
	# БЕЗОПАСНОСТЬ: блоб — JSON-массивы тегов/id ([A-Za-z0-9_.-], спец-тег __own__), пишется в файл
	# и позже отдаётся cgi-bin/data verbatim ВНУТРЬ JSON-ответа. В shell-команду не уходит (только
	# в файл). Строгий whitelist символов (лишь JSON-структура + токены, без \\ / переводов строк /
	# %-мусора после декода) + потолок длины → нельзя ни сломать наш JSON, ни протащить шелл-инъекцию.
	save_layout)
		data=$(urldecode "$(field data)")
		printf '%s' "$data" | grep -qE '^[][{}",:_.A-Za-z0-9 -]{2,4096}$' || fail "плохой формат раскладки"
		printf '%s' "$data" > "$ENODIA_STATE/.panel-layout.new" 2>/dev/null \
			&& mv "$ENODIA_STATE/.panel-layout.new" "$ENODIA_STATE/.panel-layout" 2>/dev/null \
			|| fail "не удалось сохранить раскладку"
		printf '{"ok":true}\n'; exit 0 ;;

	# --- Десинк-аргументы ByeDPI (ciadpi) → .byedpi-args. БЕЗОПАСНОСТЬ: эти args идут
	# НЕквотированно в `exec ciadpi … $args` (transport-byedpi.sh spawn_byedpi), поэтому
	# СТРОГО ограничиваем charset ASCII-флагами ciadpi (буквы/цифры/пробел/+ , . : / = _ -),
	# отсекая shell-метасимволы ($ ; | & ` ( ) < > " ' \ * ? и пр.) = защита от инъекции.
	# Пусто → вернуть авто-дефолт (rm файла). Применяем сразу, если ByeDPI активен (reload
	# перезапускает только ciadpi, несущая не рвётся); иначе сохраняем — применится при up.
	# Поле slot=2|3|4 (опц.) переводит ту же ветку на стратегию ДОП-ВЫХОДА (.byedpi-args-s<id>):
	# у каждого byedpi-выхода свой ciadpi со своим десинком, и подбирать его надо отдельно от
	# основной несущей. Валидация/charset/перезапуск — ОДИН код на оба случая (разъехались бы).
	# Пул проб браузер-свипа: список строк `url⇥w⇥h` (base64 — URL несут / ? & и в form-поле
	# резались бы). Цель = slot: пусто (основная несущая byedpi) · 2|3|4 (доп-выход) · zapret
	# (общий nfqws). Пустой список = пул снят, и свип у этой цели идти НЕ будет: вшитых наборов
	# больше нет — мерить домены, про которые неизвестно, едут ли они через десинк, значит врать.
	# Схему пускаем ТОЛЬКО https: DPI режет TLS-хэндшейк по SNI, и проба по открытому http
	# мерила бы совсем другой путь, а «красным» выглядела бы как заслуга DPI.
	# Ссылка бывает двух видов — на картинку (сверяем размер) и на корень сайта (сверяем сам факт
	# соединения); вид выводит панель ИЗ ССЫЛКИ, отдельного поля здесь намеренно нет.
	set_probe_pool)
		psl=$(field slot); case "$psl" in ''|2|3|4|zapret) ;; *) fail "битый id выхода" ;; esac
		pf="$ENODIA_STATE/.probe-pool"
		case "$psl" in '') ;; zapret) pf="$ENODIA_STATE/.probe-pool-zapret" ;; *) pf="$ENODIA_STATE/.probe-pool-s$psl" ;; esac
		raw=$(urldecode "$(field data)" | base64 -d 2>/dev/null | tr -d '\r')
		if [ -z "$raw" ]; then
			rm -f "$pf"
			printf '{"ok":true,"code":0,"msg":"пул проб очищен — свип не сможет идти, пока пул не собран"}\n'; exit 0
		fi
		: > "$pf.new" || fail "не удалось сохранить пул проб"
		n=0
		while IFS="$(printf '\t')" read -r u w h; do
			[ -n "$u" ] || continue
			case "$u" in https://*) ;; *) continue ;; esac
			printf '%s' "$u" | grep -qE '^https://[A-Za-z0-9._~:/?#@!$&+,;=%-]+$' || continue
			case "$w" in ''|*[!0-9]*) w=0 ;; esac
			case "$h" in ''|*[!0-9]*) h=0 ;; esac
			printf '%s\t%s\t%s\n' "$u" "$w" "$h" >> "$pf.new"
			n=$((n+1))
			[ "$n" -ge 40 ] && break        # кап: свип гоняет пул на КАЖДУЮ стратегию
		done <<EOF
$raw
EOF
		[ "$n" -gt 0 ] || { rm -f "$pf.new"; fail "ни одной годной ссылки (нужны https://…)"; }
		mv "$pf.new" "$pf" || fail "не удалось сохранить пул проб"
		printf '{"ok":true,"code":0,"msg":"пул проб сохранён: %s","n":%s}\n' "$n" "$n"; exit 0 ;;
	set_byedpi_args)
		bsl=$(field slot); case "$bsl" in ''|2|3|4) ;; *) fail "битый id выхода" ;; esac
		af="$ENODIA_STATE/.byedpi-args"; [ -n "$bsl" ] && af="$ENODIA_STATE/.byedpi-args-s$bsl"
		args=$(urldecode "$(field args)")
		args=$(printf '%s' "$args" | tr '\r\n' '  ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/[[:space:]]\{1,\}/ /g')
		if [ -z "$args" ]; then
			rm -f "$af"
			msg="Десинк-аргументы сброшены на авто-набор"
		else
			echo "$args" | grep -qE '^[A-Za-z0-9 +,.:/=_-]+$' || fail "недопустимые символы — разрешены только флаги ciadpi (буквы, цифры, пробел, + , . : / = _ -)"
			printf '%s\n' "$args" > "$af.new" && mv "$af.new" "$af" || fail "не удалось сохранить аргументы"
			msg="Десинк-аргументы сохранены"
			# Ядро BE7000 без CONFIG_TCP_MD5SIG → -S/md5sig вырезается плагином при запуске (см.
			# transport-byedpi.sh strip_unsupported). Предупреждаем, чтобы не было сюрприза.
			case " $args " in *" -S "*|*--md5sig*) msg="$msg (флаг -S/md5sig ядром не поддержан — будет проигнорирован)" ;; esac
		fi
		if [ -n "$bsl" ]; then
			# slot-reload перезапускает ТОЛЬКО ciadpi выхода (hev/xtun/маршрут живы); выход выключен
			# → плагин сам ответит no-op, стратегия применится при включении.
			sh "$ENODIA_DIR/transport-byedpi.sh" slot-reload "$bsl" >/dev/null 2>&1 && msg="$msg, ciadpi выхода №$bsl перезапущен" || msg="$msg, но перезапуск ciadpi выхода не удался (см. журнал)"
		else
			cur=$(cat "$ENODIA_STATE/.transport" 2>/dev/null | tr -d ' \r\n')
			if [ "$cur" = byedpi ]; then
				sh "$ENODIA_DIR/transport-byedpi.sh" reload >/dev/null 2>&1 && msg="$msg, ciadpi перезапущен" || msg="$msg, но перезапуск ciadpi не удался (см. статус)"
			else
				msg="$msg (применится при включении ByeDPI)"
			fi
		fi
		printf '{"ok":true,"code":0,"msg":"%s"}\n' "$msg"; exit 0 ;;
	set_server)
		name=$(field name)
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя сервера"
		[ -f "$ENODIA_STATE/configs/$name.conf" ] || fail "нет конфига $name"
		# ТРАФИК СЕЙЧАС НЕСЁТ ДРУГОЙ ТРАНСПОРТ ⇒ СТЕЙДЖИМ, а не переключаем. Ровно так уже
		# ведут себя соседи (set_xray_server/set_hy2_server: «НЕ роняет чужую несущую»), и
		# AmneziaWG был единственным исключением — а цена исключения высокая. switch-vpn.sh
		# СНАЧАЛА отпускает текущую несущую и лишь потом поднимает awg; не поднялся — откат
		# невозможен, если прежнего awg.conf не было (типовой случай: awg только что доставили
		# из «Компонентов»), и остаётся safety_off, то есть НИ ОДНОГО работающего транспорта.
		# Разбор с тестером 14.08.2026: «после попытки установить авг теперь даже хистерия не
		# запускается», а панель при этом продолжала писать «нужен конфиг» — потому что awg.conf
		# так и не появился, и `transport_ready awg` оставался false.
		# Включение самого транспорта — отдельный, ЯВНЫЙ жест в «Транспорт VPN» наверху панели.
		_ct=$(cat "$ENODIA_STATE/.transport" 2>/dev/null | tr -d ' \r\n')
		if [ -n "$_ct" ] && [ "$_ct" != awg ]; then
			raw=$(sh "$ENODIA_DIR/switch-vpn.sh" stage "$name" 2>&1); code=$?
			msg=$(printf '%s' "$raw" | jesc 600)
			if [ "$code" -eq 0 ]; then
				printf '{"ok":true,"code":0,"msg":"Конфиг %s выбран для AmneziaWG. Чтобы пойти через него, включи AmneziaWG в «Транспорт VPN» наверху панели."}\n' "$name"
			else
				printf '{"ok":false,"code":%s,"msg":"%s"}\n' "$code" "$msg"
			fi
			exit 0
		fi
		run switch-vpn.sh "$name" ;;

	# --- Активировать xray/hy2-конфиг по имени (зеркало Set-ActiveXray/Hy2Config). --
	# Копируем выбранный конфиг в рабочий (xray.json / hysteria.yaml) + пишем .*-active.
	# Несущую ПЕРЕЗАПУСКАЕМ только если этот транспорт сейчас активен (иначе просто
	# стейджим конфиг — применится при switch на него). НЕ роняет чужую несущую.
	set_xray_server)
		name=$(field name)
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя"
		[ -f "$ENODIA_STATE/xray-configs/$name.json" ] || fail "нет xray-конфига $name"
		hold_switch    # выбор сервера побеждает авто-failover (иначе цикл cmd_failover затирал .xray-active)
		cp "$ENODIA_STATE/xray-configs/$name.json" "$ENODIA_STATE/xray.json" 2>/dev/null \
			&& chmod 600 "$ENODIA_STATE/xray.json" 2>/dev/null \
			&& echo "$name" > "$ENODIA_STATE/.xray-active" || fail "не удалось активировать $name"
		if [ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null)" = xray ]; then
			# Вывод `up` НЕ глотаем. ЗАЧЕМ (жалоба тестера 13.08.2026 «минуту подключается»):
			# подъём по ИМЕНИ может ждать резолва десятками секунд и печатает про это ровно
			# здесь — «резолв server-host … попытка N не удалась». С `>/dev/null` этих строк не
			# видел НИКТО: ни человек в панели, ни диаг-архив, и минута молчания читалась как
			# «панель зависла». Провал `up` теперь тоже честный отказ, а не «ok» поверх мёртвой
			# несущей. jesc — единственный конвейер «вывод скрипта → строка в JSON» (json-lib.sh).
			sh "$ENODIA_DIR/xray-transport.sh" down >/dev/null 2>&1
			raw=$(sh "$ENODIA_DIR/xray-transport.sh" up 2>&1); rc=$?
			# Берём ТОЛЬКО строки про причину: на успехе cmd_up печатает ещё и cmd_status, а он
			# в тост не нужен. Причина кладётся в msg, а не в отдельное поле: postAction в панели
			# показывает msg и в тосте, и в журнале действий, а лишних полей он не читает.
			why=$(printf '%s\n' "$raw" | grep -E 'резолв|зарезолвил|удал|встан' | tail -2 | jesc 200)
			if [ "$rc" = 0 ]; then
				if [ -n "$why" ]; then
					printf '{"ok":true,"code":0,"msg":"Xray-конфиг %s активен, несущая перезапущена. %s"}\n' "$name" "$why"
				else
					printf '{"ok":true,"code":0,"msg":"Xray-конфиг %s активен, несущая перезапущена"}\n' "$name"
				fi
			else
				printf '{"ok":false,"code":%s,"msg":"Xray-конфиг %s активен, но несущая НЕ поднялась. %s"}\n' "$rc" "$name" "${why:-подробности в логе транспорта}"
			fi
		else
			printf '{"ok":true,"code":0,"msg":"Xray-конфиг %s сохранён активным (применится при переключении на Xray)"}\n' "$name"
		fi
		exit 0 ;;
	set_hy2_server)
		name=$(field name)
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя"
		[ -f "$ENODIA_STATE/hy2-configs/$name.yaml" ] || fail "нет hy2-конфига $name"
		hold_switch    # выбор сервера побеждает авто-failover (зеркало set_xray_server)
		cp "$ENODIA_STATE/hy2-configs/$name.yaml" "$ENODIA_STATE/hysteria.yaml" 2>/dev/null \
			&& chmod 600 "$ENODIA_STATE/hysteria.yaml" 2>/dev/null \
			&& echo "$name" > "$ENODIA_STATE/.hy2-active" || fail "не удалось активировать $name"
		if [ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null)" = hy2 ]; then
			sh "$ENODIA_DIR/transport-hy2.sh" down >/dev/null 2>&1
			raw=$(sh "$ENODIA_DIR/transport-hy2.sh" up 2>&1); rc=$?   # причину не глотаем — зеркало set_xray_server
			why=$(printf '%s\n' "$raw" | grep -E 'резолв|зарезолвил|удал|встан' | tail -2 | jesc 200)
			if [ "$rc" = 0 ]; then
				if [ -n "$why" ]; then
					printf '{"ok":true,"code":0,"msg":"Hysteria2-конфиг %s активен, несущая перезапущена. %s"}\n' "$name" "$why"
				else
					printf '{"ok":true,"code":0,"msg":"Hysteria2-конфиг %s активен, несущая перезапущена"}\n' "$name"
				fi
			else
				printf '{"ok":false,"code":%s,"msg":"Hysteria2-конфиг %s активен, но несущая НЕ поднялась. %s"}\n' "$rc" "$name" "${why:-подробности в логе транспорта}"
			fi
		else
			printf '{"ok":true,"code":0,"msg":"Hysteria2-конфиг %s сохранён активным (применится при переключении на Hysteria2)"}\n' "$name"
		fi
		exit 0 ;;

	# --- Удалить конфиг (зеркало Action-Delete*Config в ПК-меню). Гард: нельзя удалить
	# конфиг, который СЕЙЧАС несёт трафик. awg: .active особый (его читают switch/heal при
	# подъёме несущей) → активный не удаляем вовсе. xray/hy2: блок лишь когда активен И этот
	# транспорт включён; при удалении активного чистим и маркер .*-active. Имя — strict-regex
	# (того же класса, что в set_*_server), `/` исключён → traversal невозможен.
	del_server)
		name=$(field name)
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя сервера"
		[ -f "$ENODIA_STATE/configs/$name.conf" ] || fail "нет конфига $name"
		active=$(cat "$ENODIA_STATE/.active" 2>/dev/null | tr -d ' \r\n')
		[ "$name" = "$active" ] && fail "нельзя удалить активный конфиг ($name) — сначала переключись на другой"
		rm -f "$ENODIA_STATE/configs/$name.conf" \
			&& printf '{"ok":true,"code":0,"msg":"awg-конфиг %s удалён"}\n' "$name" \
			|| fail "не удалось удалить $name"
		exit 0 ;;
	del_xray_server)
		name=$(field name)
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя"
		[ -f "$ENODIA_STATE/xray-configs/$name.json" ] || fail "нет xray-конфига $name"
		active=$(cat "$ENODIA_STATE/.xray-active" 2>/dev/null | tr -d ' \r\n')
		{ [ "$name" = "$active" ] && [ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null)" = xray ]; } \
			&& fail "это активный конфиг при включённом Xray — сначала переключись на другой транспорт"
		rm -f "$ENODIA_STATE/xray-configs/$name.json"
		[ "$name" = "$active" ] && rm -f "$ENODIA_STATE/.xray-active"
		printf '{"ok":true,"code":0,"msg":"xray-конфиг %s удалён"}\n' "$name"; exit 0 ;;
	del_hy2_server)
		name=$(field name)
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя"
		[ -f "$ENODIA_STATE/hy2-configs/$name.yaml" ] || fail "нет hy2-конфига $name"
		active=$(cat "$ENODIA_STATE/.hy2-active" 2>/dev/null | tr -d ' \r\n')
		{ [ "$name" = "$active" ] && [ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null)" = hy2 ]; } \
			&& fail "это активный конфиг при включённой Hysteria2 — сначала переключись на другой транспорт"
		rm -f "$ENODIA_STATE/hy2-configs/$name.yaml"
		[ "$name" = "$active" ] && rm -f "$ENODIA_STATE/.hy2-active"
		printf '{"ok":true,"code":0,"msg":"hy2-конфиг %s удалён"}\n' "$name"; exit 0 ;;

	# --- Полный редактор конфига (гибрид «форма + сырой режим» в панели) ------------
	# get_config_raw: отдаёт ВЕСЬ файл конфига base64-ом (вкл. секреты — uuid/ключи/пароль:
	# владельцу роутера под токеном это ок; наружу без токена не уходит, в diag/бэкап-без-
	# секретов — нет). Фронт строит из него форму (config→params) ИЛИ показывает как сырой JSON.
	get_config_raw)
		kind=$(field kind); name=$(urldecode "$(field name)")
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя"
		case "$kind" in
			xray) cfg="$ENODIA_STATE/xray-configs/$name.json" ;;
			hy2)  cfg="$ENODIA_STATE/hy2-configs/$name.yaml" ;;
			*) fail "неизвестный тип (xray/hy2)" ;;
		esac
		[ -f "$cfg" ] || fail "нет конфига $name"
		b=$(base64 < "$cfg" | tr -d '\r\n')
		printf '{"ok":true,"code":0,"content":"%s"}\n' "$b"; exit 0 ;;
	# save_config_raw: пишет ПОЛНЫЙ конфиг (из формы — пересобран фронтом, или сырой текст).
	# Валидация: xray → JSON через jsonfilter (на роутере есть) + наличие outbound-протокола;
	# hy2 → наличие server:. Атомарно (.new+mv). Если конфиг активен и транспорт его несёт —
	# копируем в живой xray.json/hysteria.yaml и перезапускаем несущую (как edit_*_server).
	save_config_raw)
		kind=$(field kind); name=$(urldecode "$(field name)")
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя"
		case "$kind" in
			xray) cfg="$ENODIA_STATE/xray-configs/$name.json"; live="$ENODIA_STATE/xray.json";     act="$ENODIA_STATE/.xray-active"; tsh="xray-transport.sh"; tname=xray ;;
			hy2)  cfg="$ENODIA_STATE/hy2-configs/$name.yaml";  live="$ENODIA_STATE/hysteria.yaml"; act="$ENODIA_STATE/.hy2-active";  tsh="transport-hy2.sh";  tname=hy2 ;;
			*) fail "неизвестный тип (xray/hy2)" ;;
		esac
		[ -f "$cfg" ] || fail "нет конфига $name (сначала загрузи)"
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null | tr -d '\r')
		[ -n "$content" ] || fail "пустой или битый конфиг (base64)"
		printf '%s' "$content" > "$cfg.new" || { rm -f "$cfg.new"; fail "не удалось записать"; }
		if [ "$kind" = xray ]; then
			if command -v jsonfilter >/dev/null 2>&1; then
				ov=$(jsonfilter -i "$cfg.new" -e '@.outbounds[*].protocol' 2>/dev/null)
				[ -n "$ov" ] || { rm -f "$cfg.new"; fail "невалидный JSON (проверь скобки и запятые)"; }
				echo "$ov" | grep -qE 'vless|vmess|trojan|shadowsocks' || { rm -f "$cfg.new"; fail "нет outbound-протокола (vless/vmess/trojan/ss)"; }
			else
				grep -q '"outbounds"' "$cfg.new" || { rm -f "$cfg.new"; fail "нет outbounds в JSON"; }
				grep -qE '"protocol"[[:space:]]*:[[:space:]]*"(vless|vmess|trojan|shadowsocks)"' "$cfg.new" || { rm -f "$cfg.new"; fail "нет outbound-протокола"; }
			fi
		else
			grep -qE '^[[:space:]]*server:' "$cfg.new" || { rm -f "$cfg.new"; fail "нет server: в YAML"; }
		fi
		mv "$cfg.new" "$cfg" && chmod 600 "$cfg" || { rm -f "$cfg.new"; fail "не удалось сохранить"; }
		active=$(cat "$act" 2>/dev/null | tr -d ' \r\n')
		if [ "$name" = "$active" ]; then
			cp "$cfg" "$live" 2>/dev/null && chmod 600 "$live"
			if [ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null | tr -d ' \r\n')" = "$tname" ]; then
				# Между down и up несущей НЕТ: тик сторожа в это окно читает «health провалился» и
				# уводит транспорт в cross-failover — правка конфига активного сервера сама себя
				# отменяла бы. Соседи (set_xray_server/set_hy2_server) лок держат, эта ветка — нет.
				hold_switch
				sh "$ENODIA_DIR/$tsh" down >/dev/null 2>&1
				raw=$(sh "$ENODIA_DIR/$tsh" up 2>&1); rc=$?          # причину не глотаем — зеркало set_xray_server
				why=$(printf '%s\n' "$raw" | grep -E 'резолв|зарезолвил|удал|встан' | tail -2 | jesc 200)
				if [ "$rc" = 0 ]; then
					if [ -n "$why" ]; then
						printf '{"ok":true,"code":0,"msg":"Конфиг %s сохранён, несущая перезапущена. %s"}\n' "$name" "$why"
					else
						printf '{"ok":true,"code":0,"msg":"Конфиг %s сохранён, несущая перезапущена"}\n' "$name"
					fi
				else
					printf '{"ok":false,"code":%s,"msg":"Конфиг %s сохранён, но несущая НЕ поднялась. %s"}\n' "$rc" "$name" "${why:-подробности в логе транспорта}"
				fi
				exit 0
			fi
		fi
		printf '{"ok":true,"code":0,"msg":"Конфиг %s сохранён"}\n' "$name"; exit 0 ;;

	# --- Загрузка конфига с устройства пользователя (как drag-drop на десктопе). ----
	# Контент приходит base64-ом в поле content (фронт читает файл FileReader-ом). Тип
	# (awg/xray/hy2) задаёт каталог И расширение; имя — strict-regex. НЕ активируем —
	# просто кладём файл (активация — отдельным set_*_server). Запись атомарна (.new+mv).
	upload_config)
		kind=$(field kind)
		name=$(urldecode "$(field name)")
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя файла"
		case "$kind" in
			awg)  dir="$ENODIA_STATE/configs";      ext=conf ;;
			xray) dir="$ENODIA_STATE/xray-configs"; ext=json ;;
			hy2)  dir="$ENODIA_STATE/hy2-configs";  ext=yaml ;;
			*)    fail "неизвестный тип конфига" ;;
		esac
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null)
		[ -n "$content" ] || fail "пустой или битый конфиг (base64)"
		# Мягкая валидация по типу — отбить явный мусор/не тот файл.
		case "$kind" in
			awg)  printf '%s' "$content" | grep -q '\[Interface\]'        || fail "не похоже на awg-конфиг (нет [Interface])" ;;
			xray) printf '%s' "$content" | grep -q '"outbounds"'          || fail "не похоже на xray JSON (нет outbounds)" ;;
			hy2)  printf '%s' "$content" | grep -qE '^[[:space:]]*server:' || fail "не похоже на hy2 YAML (нет server:)" ;;
		esac
		mkdir -p "$dir" 2>/dev/null
		dst="$dir/$name.$ext"
		if printf '%s' "$content" | tr -d '\r' > "$dst.new" && mv "$dst.new" "$dst" && chmod 600 "$dst"; then
			printf '{"ok":true,"code":0,"msg":"Конфиг %s сохранён (%s) — активируй в списке серверов"}\n' "$name" "$kind"
		else
			rm -f "$dst.new" 2>/dev/null
			fail "не удалось записать файл"
		fi
		exit 0 ;;

	# --- VLESS-подписки: URL-подписки живут НА РОУТЕРЕ ($ENODIA_STATE/.subs) --------------
	# Почему на роутере, а не в localStorage браузера: панелью рулят с разных устройств
	# (телефон/планшет/ПК), а localStorage — per-browser → подписку было видно/обновляемо
	# только с того устройства, где импортнули. Файл .subs = строки "tag⇥url⇥label"
	# (⇥=TAB, label последним — может содержать пробелы; url/tag валидированы regex'ом).
	# URL — это КРЕД: наружу (list / бэкап-без-секретов / diag-dump) НЕ отдаём; обновление
	# идёт по tag, роутер сам подставляет url (кред по проводу назад не гуляет). Секреты
	# конфигов подписки (server/uuid/Reality-ключ) и так уже лежат на роутере — .subs не
	# крупнее того, что есть.
	#
	# save_sub: upsert строки (импорт персистит url ОДИН раз). fetch_sub: тянет тело по tag
	# (обход CORS браузера — curl'ит РОУТЕР), отдаёт base64 (разбор base64/plaintext/
	# JSON-массив + vless://→xray JSON делает БРАУЗЕР; busybox JSON не собираем). Тело качаем
	# В ФАЙЛ, а не в $var: часть панелей (durev) отдаёт gzip'ом БЕЗУСЛОВНО, NUL-байты gzip
	# обрезали бы shell-переменную; od в busybox НЕТ — не читаем магию, а ПРОБУЕМ разжать
	# (удалось+непусто ⇒ был gzip). del_sub: снять ТОЛЬКО конфиги по метке (зовёт refresh/
	# import для идемпотентной перезаливки — строку .subs НЕ трогает). remove_sub: полное
	# снятие (конфиги + строка .subs) для кнопки удаления подписки.
	save_sub)
		tag=$(field tag)
		url=$(urldecode "$(field url)")
		label=$(urldecode "$(field label)")
		echo "$tag" | grep -qE '^[a-z0-9-]{1,16}$' || fail "плохая метка подписки"
		echo "$url" | grep -qE '^https?://[^[:space:]]+$' || fail "не URL (нужен http(s)://…)"
		sub_host_public "$url" || fail "URL ведёт на приватный/локальный адрес — так нельзя (SSRF)"
		TAB=$(printf '\t')
		label=$(printf '%s' "$label" | tr -d '\t\r\n'); [ -n "$label" ] || label="$tag"
		{ [ -f "$ENODIA_STATE/.subs" ] && grep -v "^$tag$TAB" "$ENODIA_STATE/.subs"
		  printf '%s\t%s\t%s\n' "$tag" "$url" "$label"; } > "$ENODIA_STATE/.subs.new" 2>/dev/null
		mv "$ENODIA_STATE/.subs.new" "$ENODIA_STATE/.subs" && chmod 600 "$ENODIA_STATE/.subs" 2>/dev/null
		printf '{"ok":true,"code":0,"msg":"подписка сохранена"}\n'; exit 0 ;;
	# rename_sub: сменить ТОЛЬКО отображаемое имя (label) подписки. tag и конфиги sub-<tag>-*
	# не трогаем (tag = внутренний ключ, фиксирован; переименование меняет лишь показ).
	rename_sub)
		tag=$(field tag)
		label=$(urldecode "$(field label)")
		echo "$tag" | grep -qE '^[a-z0-9-]{1,16}$' || fail "плохая метка подписки"
		label=$(printf '%s' "$label" | tr -d '\t\r\n'); [ -n "$label" ] || fail "пустое имя"
		[ -f "$ENODIA_STATE/.subs" ] || fail "подписка не найдена"
		TAB=$(printf '\t')
		url=$(grep "^$tag$TAB" "$ENODIA_STATE/.subs" | head -1 | cut -d"$TAB" -f2)
		[ -n "$url" ] || fail "подписка не найдена"
		{ grep -v "^$tag$TAB" "$ENODIA_STATE/.subs"; printf '%s\t%s\t%s\n' "$tag" "$url" "$label"; } > "$ENODIA_STATE/.subs.new" 2>/dev/null
		mv "$ENODIA_STATE/.subs.new" "$ENODIA_STATE/.subs" && chmod 600 "$ENODIA_STATE/.subs" 2>/dev/null
		printf '{"ok":true,"code":0,"msg":"подписка переименована"}\n'; exit 0 ;;
	# edit_sub_url: сменить ССЫЛКУ подписки (url в .subs), сохранив label. Метка/конфиги не трогаем;
	# перетягивание серверов — отдельным refresh из панели. SSRF-гард как в save_sub.
	edit_sub_url)
		tag=$(field tag)
		url=$(urldecode "$(field url)")
		echo "$tag" | grep -qE '^[a-z0-9-]{1,16}$' || fail "плохая метка подписки"
		echo "$url" | grep -qE '^https?://[^[:space:]]+$' || fail "не URL (нужен http(s)://…)"
		sub_host_public "$url" || fail "URL ведёт на приватный/локальный адрес — так нельзя (SSRF)"
		TAB=$(printf '\t')
		[ -f "$ENODIA_STATE/.subs" ] && grep -q "^$tag$TAB" "$ENODIA_STATE/.subs" || fail "подписка не найдена"
		label=$(grep "^$tag$TAB" "$ENODIA_STATE/.subs" | head -1 | cut -d"$TAB" -f3-); [ -n "$label" ] || label="$tag"
		{ grep -v "^$tag$TAB" "$ENODIA_STATE/.subs"; printf '%s\t%s\t%s\n' "$tag" "$url" "$label"; } > "$ENODIA_STATE/.subs.new" 2>/dev/null
		mv "$ENODIA_STATE/.subs.new" "$ENODIA_STATE/.subs" && chmod 600 "$ENODIA_STATE/.subs" 2>/dev/null
		printf '{"ok":true,"code":0,"msg":"ссылка обновлена"}\n'; exit 0 ;;
	fetch_sub)
		tag=$(field tag)
		echo "$tag" | grep -qE '^[a-z0-9-]{1,16}$' || fail "плохая метка подписки"
		TAB=$(printf '\t')
		url=$(grep "^$tag$TAB" "$ENODIA_STATE/.subs" 2>/dev/null | head -1 | cut -d"$TAB" -f2)
		echo "$url" | grep -qE '^https?://[^[:space:]]+$' || fail "подписка не найдена на роутере"
		# Одна копия закачки: тело тянет subs-update.sh (тот же путь, которым ходит cron) —
		# иначе панельный и headless-путь разъехались бы по гарду/gzip-детекту. Ниже — прежний
		# инлайн как фолбэк на случай дрейфа деплоя (скрипт ещё не залит).
		# Гард `-f`, а не `-x`: зовём через `sh`, и снятый бит выполнения ТИХО уводил бы панель
		# на фолбэк-путь вместо общего (класс Б7-2).
		if [ -f "$ENODIA_DIR/subs-update.sh" ]; then
			data=$(sh "$ENODIA_DIR/subs-update.sh" fetch "$tag" 2>/dev/null)
			[ -n "$data" ] || fail "подписка недоступна или пустая"
			printf '{"ok":true,"code":0,"data":"%s"}\n' "$data"; exit 0
		fi
		sub_host_public "$url" || fail "URL подписки ведёт на приватный/локальный адрес — отказ (SSRF)"
		# Дрейф деплоя (subs-update.sh ещё не залит) — тянем тем же ОБЩИМ слоем. Свой curl здесь
		# был ТРЕТЬЕЙ копией закачки, и уже разошёлся с оригиналом: без проверки КАЖДОГО редиректа
		# и без потолка на распаковку gzip.
		tmp="/tmp/enodia-sub.$$"
		sub_fetch "$url" "$tmp" || { rm -f "$tmp"; fail "подписка недоступна или пустая"; }
		data=$(base64 < "$tmp" | tr -d '\r\n'); rm -f "$tmp"
		printf '{"ok":true,"code":0,"data":"%s"}\n' "$data"; exit 0 ;;
	del_sub)
		tag=$(field tag)
		echo "$tag" | grep -qE '^[a-z0-9-]{1,16}$' || fail "плохая метка подписки"
		del_sub_configs "$tag"
		printf '{"ok":true,"code":0,"msg":"конфиги подписки сняты"}\n'; exit 0 ;;
	remove_sub)
		tag=$(field tag)
		echo "$tag" | grep -qE '^[a-z0-9-]{1,16}$' || fail "плохая метка подписки"
		del_sub_configs "$tag"   # снять конфиги ДО чистки строки .subs (нужен полный набор тегов)
		if [ -f "$ENODIA_STATE/.subs" ]; then
			TAB=$(printf '\t'); grep -v "^$tag$TAB" "$ENODIA_STATE/.subs" > "$ENODIA_STATE/.subs.new" 2>/dev/null
			mv "$ENODIA_STATE/.subs.new" "$ENODIA_STATE/.subs" 2>/dev/null
		fi
		# Имена снимаем ПО ВЛАДЕЛЬЦУ, а не по префиксу (та же причина, что у del_sub_configs:
		# «liberty» ⊂ «liberty-vpn» — голый грep уносил карту имён соседней подписки).
		if [ -f "$ENODIA_STATE/.sub-names" ]; then
			sub_names_keep_other "$tag" > "$ENODIA_STATE/.sub-names.new" 2>/dev/null
			mv "$ENODIA_STATE/.sub-names.new" "$ENODIA_STATE/.sub-names" 2>/dev/null
		fi
		# …и карту выбранных выходов (.sub-picks, владелец — subs-update.sh): она ключуется теми же
		# именами, и осиротевшие строки жили бы в ней вечно.
		if [ -f "$ENODIA_STATE/.sub-picks" ]; then
			sub_names_keep_other "$tag" "$ENODIA_STATE/.sub-picks" > "$ENODIA_STATE/.sub-picks.new" 2>/dev/null
			mv "$ENODIA_STATE/.sub-picks.new" "$ENODIA_STATE/.sub-picks" 2>/dev/null
		fi
		printf '{"ok":true,"code":0,"msg":"подписка удалена"}\n'; exit 0 ;;
	# set_sub_names: настоящие имена серверов подписки (эмодзи/флаги/юникод — как в v2rayNG).
	# В имя ФАЙЛА такое не кладём (спецсимволы ломают глоб/скрипты), поэтому сырой remark
	# храним отдельно: .sub-names = строки "sub-<tag>-<файл>⇥<remark>". names = base64 этих
	# строк (эмодзи проходят как UTF-8). Пакетно заменяем строки, чей ВЛАДЕЛЕЦ — этот tag.
	set_sub_names)
		tag=$(field tag)
		echo "$tag" | grep -qE '^[a-z0-9-]{1,16}$' || fail "плохая метка подписки"
		names=$(urldecode "$(field names)")
		NM="$ENODIA_STATE/.sub-names"
		# Блок панели приезжает как join('\n') — БЕЗ хвостового перевода строки, и файл после
		# браузерного ⟳ оставался без него. Читатели на busybox идут `while read`, а тот теряет
		# последнюю строку без \n (замер: 3 строки → 2 итерации) — то есть ПОСЛЕДНИЙ сервер
		# подписки терял своё настоящее имя. `awk '{print}'` дописывает перевод строки любому
		# последнему полю и ничего не меняет, если он уже есть.
		{ sub_names_keep_other "$tag"
		  printf '%s' "$names" | base64 -d 2>/dev/null | awk '{print}'; } > "$NM.new" 2>/dev/null
		mv "$NM.new" "$NM" 2>/dev/null
		printf '{"ok":true,"code":0,"msg":"имена сохранены"}\n'; exit 0 ;;
	# save_checks: кэш проверок серверов (пинг/скорость). Панель шлёт ВЕСЬ кэш (data=b64 TSV
	# key⇥st⇥ms⇥method⇥cdn⇥mbps⇥kind⇥ts). Полная замена — это хинты производительности, не критич-
	# ные данные (last-writer-wins). Валидируем построчно (ключ + 8 полей), кап 2000 строк.
	save_checks)
		raw=$(urldecode "$(field data)" | base64 -d 2>/dev/null)
		TAB=$(printf '\t')
		F="$ENODIA_STATE/.srv-checks"
		printf '%s\n' "$raw" | awk -F"$TAB" 'NR<=2000 && NF>=8 && $1 ~ /^(awg|xray|hy2)\|[A-Za-z0-9._-]+$/{print}' > "$F.new" 2>/dev/null
		mv "$F.new" "$F" 2>/dev/null && chmod 600 "$F" 2>/dev/null
		printf '{"ok":true,"code":0}\n'; exit 0 ;;

	# --- Устройства: режим конкретного IP (split / bypass / force / desync) -----------
	# Каждый режим взаимоисключающий: перед установкой нового снимаем
	# противоположную метку (apply-bypass идемпотентен; снятие безвредно).
	# desync («целиком в десинк») снимает противоположные САМ, в движке: его половины — ACCEPT
	# «мимо VPN» и NFQUEUE по источнику, и разводить это по двум вызовам отсюда значило бы
	# оставить окно, где устройство уже не в VPN, но ещё и не в десинке.
	dev_split|dev_bypass|dev_force|dev_desync)
		ip=$(urldecode "$(field ip)")
		echo "$ip" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || fail "недопустимый IP"
		# Отметку владельца ставим ДО применения: `run` заканчивается `exit`, после него кода нет.
		# Для dev_split не ставим — это снятие режима, а не заведение правила.
		[ "$act" = dev_split ] || owner_note "$ip" >/dev/null 2>&1
		case "$act" in
			dev_split)  sh "$ENODIA_DIR/apply-bypass.sh" del-ip "$ip" >/dev/null 2>&1; run apply-bypass.sh force-del-ip "$ip" ;;
			dev_bypass) sh "$ENODIA_DIR/apply-bypass.sh" force-del-ip "$ip" >/dev/null 2>&1; run apply-bypass.sh add-ip "$ip" ;;
			dev_desync) run apply-bypass.sh desync-add-ip "$ip" ;;
			# slot — необязателен: пусто/0 = основной туннель, s2|s3|s4 = доп-выход.
			# Выключенный выход движок сам уводит на основной (гейт в rebuild_force).
			dev_force)  slot=$(field slot); case "$slot" in s[234]) ;; *) slot="" ;; esac
			            sh "$ENODIA_DIR/apply-bypass.sh" del-ip "$ip" >/dev/null 2>&1; run apply-bypass.sh force-add-ip "$ip" "$slot" ;;
		esac ;;

	# --- Устройство «мимо VPN»: пускать ли по нему МОИ ручные правила -----------
	# ACCEPT выреза обрывает всю mangle ⇒ у такого устройства мертвы и добавленные вручную
	# домены/адреса/группы «в VPN». Тумблер поднимает их обратно отдельной ступенью выше
	# выреза (движок — apply-bypass.sh keep-*, цепочка VPN_KEEP). Гейт «устройство реально
	# в вырезе» держит движок, CGI только валидирует IP.
	dev_keep)
		ip=$(urldecode "$(field ip)")
		echo "$ip" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || fail "недопустимый IP"
		case "$(field on)" in
			1|on|true) owner_note "$ip" >/dev/null 2>&1; run apply-bypass.sh keep-add-ip "$ip" ;;
			*)         run apply-bypass.sh keep-del-ip "$ip" ;;
		esac ;;

	# --- Устройство: свои адреса назначения (цепочка VPN_DEV) -----------------
	# «Этому ТВ ютуб — через выход №3, остальным как обычно». Общие списки/группы/гео действуют на
	# ВСЮ сеть, а тумблер «мои правила действуют» (dev_keep) включает их для устройства ОПТОМ —
	# выбора адресов для ОДНОГО источника не было ни у чего.
	# Хранит правила groups.sh (группа с непустым src, вербы dev-add/dev-del), цепочку держит
	# apply-bypass.sh. CGI только валидирует ввод: значение уезжает в подстановку, мусор туда
	# пускать нельзя. Направление панель шлёт СЛОВАРЁМ ПОРТ-ПРАВИЛ (vpn|direct|block|sN) — один
	# язык на оба экрана; в язык движка (dir + слот отдельным полем) переводим здесь.
	dev_dst_add|dev_dst_del)
		ip=$(urldecode "$(field ip)")
		echo "$ip" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || fail "недопустимый IP"
		val=$(urldecode "$(field val)" | tr -d ' \t\r')
		echo "$val" | grep -qE '^[A-Za-z0-9._:/-]{1,200}$' || fail "нужен домен или IP/подсеть"
		if [ "$act" = dev_dst_del ]; then
			run groups.sh dev-del "$ip" "$val"
		else
			dir=$(field dir)
			echo "$dir" | grep -qE '^(vpn|direct|block|s[234])$' || fail "куда: в VPN, напрямую, блокировать или в доп-выход"
			slot=0
			case "$dir" in
				s[234]) slot=${dir#s}; dir=vpn ;;
				direct) dir=bypass ;;
			esac
			owner_note "$ip" >/dev/null 2>&1
			run groups.sh dev-add "$ip" "$dir" "$slot" "$val"
		fi ;;

	# --- Устройства: правила по портам (цепочка VPN_PORTS) --------------------
	# «У этого устройства ВОТ ЭТИ порты идут не туда, куда остальной его трафик»: режим
	# устройства выше (split/bypass/force) отвечает за трафик ЦЕЛИКОМ, а p2p-игры и
	# голосовые сервисы иногда требуют развести протоколы по разным путям. Четвёртое
	# направление `block` — «не выпускать вовсе», его главный потребитель QUIC (udp/443):
	# ByeDPI — socks-прокси, то есть только TCP, и QUIC уезжает мимо десинка. Владелец
	# правил и порядка цепочек — apply-bypass.sh; CGI только валидирует ввод (значения
	# уезжают в подстановку iptables, мусор туда пускать нельзя).
	port_add|port_del)
		ip=$(urldecode "$(field ip)")
		[ "$ip" = any ] || echo "$ip" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || fail "недопустимый IP"
		proto=$(field proto)
		echo "$proto" | grep -qE '^(udp|tcp|both)$' || fail "протокол: udp, tcp или оба"
		# пробел после запятой человек ставит руками — режем ДО валидации, иначе честный
		# ввод «3478-3480, 7600» отбивался бы как мусор
		ports=$(urldecode "$(field ports)" | tr -d ' \t\r')
		[ "$ports" = all ] || echo "$ports" | grep -qE '^[0-9]{1,5}(-[0-9]{1,5})?(,[0-9]{1,5}(-[0-9]{1,5})?)*$' \
			|| fail "порты: 443, 3478-3480 или «все»"
		if [ "$act" = port_add ]; then
			dir=$(field dir)
			echo "$dir" | grep -qE '^(vpn|direct|block|s[234])$' || fail "куда: в VPN, напрямую, блокировать или в доп-выход"
			# `any` — правило на всю сеть, а не на устройство: владельца у него нет.
			[ "$ip" = any ] || owner_note "$ip" >/dev/null 2>&1
			run apply-bypass.sh port-add "$ip" "$proto" "$ports" "$dir"
		else
			run apply-bypass.sh port-del "$ip" "$proto" "$ports"
		fi ;;

	# --- Устройства: закрепить адрес (DHCP-резервация) ------------------------
	# ЗАЧЕМ КНОПКА. Правила проекта ключуются по IPv4, а адрес выдаётся на срок аренды: устройство
	# переподключилось — адрес другой, правило осталось на старом. Закрепление говорит dnsmasq
	# «этому MAC всегда вот этот адрес» и тем фиксирует связку, на которой держится вся политика.
	# MAC берёт сам движок (нынешний владелец адреса) — панель его не присылает: одно место, где
	# решают «кому принадлежит адрес», это lease-lib, и второй копии этого решения быть не должно.
	dhcp_pin|dhcp_unpin)
		ip=$(urldecode "$(field ip)")
		echo "$ip" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || fail "недопустимый IP"
		[ -f "$ENODIA_DIR/dhcp-static.sh" ] || fail "закрепление адресов недоступно (обнови скрипты с GitHub)"
		if [ "$act" = dhcp_pin ]; then run dhcp-static.sh add "$ip"; else run dhcp-static.sh del "$ip"; fi ;;

	# --- Наблюдение за трафиком устройства («Что запрашивает устройство») -----
	# devwatch.sh включает/выключает dnsmasq query-log на КОРОТКОЕ окно (verbose на весь LAN —
	# постоянно не держим; авто-выключение по таймеру). Печатает СВОЙ JSON {ok,watching,secs_left}
	# → echo как есть (не через run(), чтобы не оборачивать в {ok,code,msg}). Чтение (домены/conntrack)
	# — read-only в cgi-bin/data section=devtraffic. Кнопка «→ мимо VPN» по IP = существующий dst_bypass.
	# Гард на файл обязателен: ответ этих двух веток — ЧУЖОЙ JSON (печатает devwatch.sh), и без
	# файла CGI отдаёт ПУСТОЕ тело. Пустое тело фронт читает как «сбой запроса» — без причины на
	# экране, хотя причина известна («скрипт не залит»).
	devwatch_start)
		[ -f "$ENODIA_DIR/devwatch.sh" ] || fail "devwatch.sh не установлен (обнови скрипты роутера)"
		secs=$(clampint "$(field secs)" 60 10 300)
		sh "$ENODIA_DIR/devwatch.sh" start "$secs"; exit 0 ;;
	devwatch_stop)
		[ -f "$ENODIA_DIR/devwatch.sh" ] || fail "devwatch.sh не установлен (обнови скрипты роутера)"
		sh "$ENODIA_DIR/devwatch.sh" stop; exit 0 ;;
	# --- Сайты/домены ---------------------------------------------------------
	# ТРИ состояния одного домена, один хозяин (domain.sh): в VPN / мимо VPN / нет правила.
	# dom_bypass раньше резолвил домен и клал СНИМОК A-записей в плоский .bypass-dst — снимок
	# протухал (CDN крутит адреса), отменить «по домену» было нечем, а индикатор маршрута его не
	# видел (правило-то оставалось «в VPN») → «нажал мимо, а на странице ничего не изменилось».
	# Теперь это обычное правило `ipset=/дом/enodia_bypass` — динамика, персист и симметричная отмена.
	domain_add|domain_del|dom_bypass|domain_block)
		# norm_domain — тот же нормализатор, что у пачки (схема/путь/www/ведущая «*.»): маска
		# `*.ya.ru` = `ya.ru`, поддомены у dnsmasq и так входят. Снятие правила нормализуем ТЕМ ЖЕ
		# вызовом — иначе `*.ya.ru` не совпал бы со строкой, записанной как `ya.ru`, и правило не снялось бы.
		dom=$(norm_domain "$(urldecode "$(field domain)")")
		# dom_ok, а не «только разрешённые знаки»: прежний регекс не имел ПОТОЛКА длины, и домен
		# с меткой >63 символов уезжал в конфиг dnsmasq, который демон целиком отвергает (замер —
		# в шапке dom_ok). Панель показывала «правило сохранено», а сеть теряла DNS на ребуте.
		dom_ok "$dom" || fail "недопустимый домен (буквы, цифры, точка и дефис; часть между точками — до 63 знаков)"
		case "$act" in
			domain_add)   run domain.sh add "$dom" ;;
			dom_bypass)   run domain.sh bypass "$dom" ;;
			domain_block) run domain.sh block "$dom" ;;   # address=/дом/0.0.0.0 + :: (обе семьи), см. domain.sh
			*)            run domain.sh remove "$dom" ;;
		esac ;;
	# У адреса те же ТРИ состояния, что у домена: в VPN (dst_vpn) / мимо VPN (dst_bypass) /
	# правила нет (dst_unbypass, dst_unvpn — снять). Направление переключается одним вербом:
	# apply-bypass сам снимает противоположное правило, чтобы адрес не оказался разом и в
	# вырезе, и в маркировке.
	dst_bypass|dst_unbypass|dst_vpn|dst_unvpn)
		cidr=$(urldecode "$(field cidr)")
		echo "$cidr" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$' || fail "недопустимый IP/подсеть"
		case "$act" in
			dst_bypass)   run apply-bypass.sh add-dst "$cidr" ;;
			dst_unbypass) run apply-bypass.sh del-dst "$cidr" ;;
			dst_vpn)      run apply-bypass.sh add-vpn-dst "$cidr" ;;
			*)            run apply-bypass.sh del-vpn-dst "$cidr" ;;
		esac ;;

	# --- Именованные группы правил (groups.sh) --------------------------------
	# id/направление/флаг валидируем здесь строгим regex'ом, имя и члены НЕ валидируем —
	# groups.sh сам их санирует (san/is_dom/is_cidr) и в shell-команду не подставляет.
	# Члены едут base64-блобом (как bulk_*): в них переводы строк, а тело формы — urlencoded.
	grp_add)
		dir=$(field dir); case "$dir" in vpn|bypass) ;; *) fail "направление: в VPN или мимо VPN" ;; esac
		name=$(urldecode "$(field name)")
		[ -n "$name" ] || fail "нужно имя группы"
		run groups.sh add "$dir" "$name" ;;
	grp_new)
		# Мастер импорта routing-правил из подписки (Ф4): группа + её состав ОДНИМ действием
		# (иначе фронт слал бы grp_add, вытаскивал id из человеческого сообщения и слал grp_members —
		# два do_apply на каждую из N групп). Ответ МАШИННЫЙ: {"ok",…,"id":"gN","n":<членов>};
		# человеческий текст строит панель (её строки и так переводятся i18n-слоем).
		dir=$(field dir); case "$dir" in vpn|bypass) ;; *) fail "направление: в VPN или мимо VPN" ;; esac
		slot=$(field slot); case "$slot" in ''|0) slot=0 ;; 2|3|4) ;; *) fail "доп-выход: 0, 2, 3 или 4" ;; esac
		name=$(urldecode "$(field name)"); [ -n "$name" ] || fail "нужно имя группы"
		# Состав едет base64-блобом (как grp_members/bulk_*): в нём переводы строк, а тело формы urlencoded.
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null)
		raw=$(printf '%s' "$content" | sh "$ENODIA_DIR/groups.sh" new "$dir" "$slot" "$name" 2>&1); code=$?
		last=$(printf '%s' "$raw" | tail -n 1)
		gid=$(printf '%s' "$last" | cut -f1); gn=$(printf '%s' "$last" | cut -f2)
		case "$gid" in g[0-9]*) ;; *) fail "не удалось создать группу" ;; esac
		case "$gn" in ''|*[!0-9]*) gn=0 ;; esac
		printf '{"ok":%s,"code":%s,"id":"%s","n":%s}\n' \
			"$([ "$code" -eq 0 ] && echo true || echo false)" "$code" "$gid" "$gn"
		exit 0 ;;
	grp_del|grp_rename|grp_dir|grp_slot|grp_toggle|grp_members)
		gid=$(field id)
		echo "$gid" | grep -qE '^g[0-9]+$' || fail "битый id группы"
		case "$act" in
			grp_del)    run groups.sh del "$gid" ;;
			grp_rename) name=$(urldecode "$(field name)"); [ -n "$name" ] || fail "нужно имя группы"
			            run groups.sh rename "$gid" "$name" ;;
			grp_dir)    dir=$(field dir); case "$dir" in vpn|bypass) ;; *) fail "направление: в VPN или мимо VPN" ;; esac
			            run groups.sh dir "$gid" "$dir" ;;
			grp_slot)   slot=$(field slot); case "$slot" in 0|2|3|4) ;; *) fail "доп-выход: 0, 2, 3 или 4" ;; esac
			            run groups.sh slot "$gid" "$slot" ;;
			grp_toggle) en=$(field enabled); case "$en" in 0|1) ;; *) fail "нужно 0|1" ;; esac
			            run groups.sh toggle "$gid" "$en" ;;
			grp_members)
				content=$(urldecode "$(field content)" | base64 -d 2>/dev/null)
				# Пустой блоб = «очистить группу», это законно (не fail): группу оставляем,
				# членов убираем. groups.sh set-members читает stdin и пересобирает всё сам.
				raw=$(printf '%s' "$content" | sh "$ENODIA_DIR/groups.sh" set-members "$gid" 2>&1); code=$?
				msg=$(printf '%s' "$raw" | jesc 1000)
				printf '{"ok":%s,"code":%s,"msg":"%s"}\n' "$([ "$code" -eq 0 ] && echo true || echo false)" "$code" "$msg"
				exit 0 ;;
		esac ;;

	# --- Доп-выходы (слоты мульти-транспорта, slots.sh) -----------------------
	# id — строгий 2|3|4; транспорт/fallback — whitelist; config — имя файла (^[A-Za-z0-9._-]+$)
	# или '-' (нет конфига). Имя НЕ валидируем — slots.sh хранит его base64 и в eval не подставляет.
	slot_add)
		name=$(urldecode "$(field name)")
		[ -n "$name" ] || fail "нужно имя выхода"
		tpt=$(field transport); case "$tpt" in awg|xray|hy2|byedpi|zapret) ;; *) fail "неизвестный транспорт" ;; esac
		cfg=$(field config); [ -n "$cfg" ] || cfg='-'
		case "$cfg" in '-') ;; *[!A-Za-z0-9._-]*) fail "битое имя конфига" ;; esac
		fb=$(field fallback); case "$fb" in main|direct) ;; *) fb=main ;; esac
		run slots.sh add "$name" "$tpt" "$cfg" "$fb" ;;
	slot_toggle|slot_del|slot_set)
		sid=$(field id); case "$sid" in 2|3|4) ;; *) fail "битый id выхода" ;; esac
		case "$act" in
			slot_toggle) en=$(field enabled); case "$en" in 0|1) ;; *) fail "нужно 0|1" ;; esac
			             if [ "$en" = 1 ]; then run slots.sh enable "$sid"; else run slots.sh disable "$sid"; fi ;;
			slot_del)    run slots.sh del "$sid" ;;
			slot_set)    fld=$(field field); val=$(urldecode "$(field value)")
			             case "$fld" in
			                 name)      [ -n "$val" ] || fail "нужно имя"; run slots.sh set "$sid" name "$val" ;;
			                 transport) case "$val" in awg|xray|hy2|byedpi|zapret) ;; *) fail "неизвестный транспорт" ;; esac
			                            run slots.sh set "$sid" transport "$val" ;;
			                 config)    [ -n "$val" ] || val='-'; case "$val" in '-') ;; *[!A-Za-z0-9._-]*) fail "битое имя конфига" ;; esac
			                            run slots.sh set "$sid" config "$val" ;;
			                 fallback)  case "$val" in main|direct) ;; *) fail "fallback: main|direct" ;; esac
			                            run slots.sh set "$sid" fallback "$val" ;;
			                 *) fail "поле: name|transport|config|fallback" ;;
			             esac ;;
		esac ;;
	slot_pool)
		# «Свой пул…» на десинк-выходе: создать «в VPN»-группу, СРАЗУ привязанную к слоту
		# (домены юзер добавит в редакторе группы). id строгий 2|3|4; имя не валидируем —
		# groups.sh санирует (san) и в eval не подставляет.
		sid=$(field id); case "$sid" in 2|3|4) ;; *) fail "битый id выхода" ;; esac
		name=$(urldecode "$(field name)")
		[ -n "$name" ] || fail "нужно имя пула"
		run groups.sh add-bound "$sid" "$name" ;;

	# --- Wi-Fi: режим SSID по его iface'ам (split / bypass / force) — 3 позиции,
	# как у устройств. Каждый iface ВАЛИДИРУЕМ (^wl[0-9]+$) И проверяем hostapd-конфиг.
	# Режимы взаимоисключающие: перед новым снимаем противоположные метки (add-if=мимо VPN
	# в VPN_EXCLUDE, force-add-if=целиком в VPN в VPN_FORCE; apply-bypass идемпотентен).
	# wifi_unbypass — легаси-алиас старого фронта (= wifi_split, «вернуть в VPN»).
	wifi_split|wifi_bypass|wifi_force|wifi_unbypass)
		raw=$(urldecode "$(field ifaces)")
		any=0; doneifs=""
		for ifc in $(echo "$raw" | tr ',' ' '); do
			echo "$ifc" | grep -qE '^wl[0-9]+$' || continue
			[ -f "/var/run/hostapd-$ifc.conf" ] || continue
			case "$act" in
				wifi_bypass) sh "$ENODIA_DIR/apply-bypass.sh" force-del-if "$ifc" >/dev/null 2>&1; sh "$ENODIA_DIR/apply-bypass.sh" add-if "$ifc" >/dev/null 2>&1 ;;
				wifi_force)  sh "$ENODIA_DIR/apply-bypass.sh" del-if "$ifc" >/dev/null 2>&1; sh "$ENODIA_DIR/apply-bypass.sh" force-add-if "$ifc" >/dev/null 2>&1 ;;
				*)           sh "$ENODIA_DIR/apply-bypass.sh" del-if "$ifc" >/dev/null 2>&1; sh "$ENODIA_DIR/apply-bypass.sh" force-del-if "$ifc" >/dev/null 2>&1 ;;
			esac
			any=1; doneifs="$doneifs $ifc"
		done
		[ "$any" = 1 ] || fail "нет валидных Wi-Fi интерфейсов"
		# Сброс — через ct-lib.sh (владелец один): на ядре 4.4 утилиты conntrack в прошивке нет,
		# и голая строка была тихим no-op — режим Wi-Fi менялся только для НОВЫХ соединений.
		ENODIA_DIR="$ENODIA_DIR"; if [ -f "$ENODIA_DIR/ct-lib.sh" ]; then . "$ENODIA_DIR/ct-lib.sh"; fi
		if command -v ct_flush >/dev/null 2>&1; then ct_flush; else conntrack -F >/dev/null 2>&1; fi
		w=$(case "$act" in wifi_bypass) echo "мимо VPN";; wifi_force) echo "целиком в VPN";; *) echo "раздельно";; esac)
		printf '{"ok":true,"code":0,"msg":"Wi-Fi (%s): %s"}\n' "$w" "$doneifs"; exit 0 ;;
	# Гостевая 192.168.33.0/24 — те же 3 режима. guest_unbypass — легаси-алиас (= guest_split).
	guest_split|guest_unbypass) sh "$ENODIA_DIR/apply-bypass.sh" force-guest-off >/dev/null 2>&1; run apply-bypass.sh guest-off ;;
	guest_bypass)               sh "$ENODIA_DIR/apply-bypass.sh" force-guest-off >/dev/null 2>&1; run apply-bypass.sh guest-on ;;
	guest_force)                sh "$ENODIA_DIR/apply-bypass.sh" guest-off >/dev/null 2>&1; run apply-bypass.sh force-guest-on ;;

	# --- Уведомления ----------------------------------------------------------
	notify_on)  rm -f "$ENODIA_STATE/.notify-off"; printf '{"ok":true,"code":0,"msg":"Уведомления включены"}\n'; exit 0 ;;
	notify_off) : > "$ENODIA_STATE/.notify-off"; printf '{"ok":true,"code":0,"msg":"Уведомления выключены"}\n'; exit 0 ;;
	notify_test)
		[ -s "$ENODIA_STATE/notify.conf" ] || fail "почта не настроена (нет notify.conf) — задай в установщике с ПК"
		grep -q '^SMTP_PASS=.' "$ENODIA_STATE/notify.conf" 2>/dev/null || fail "не заполнен SMTP_PASS — настрой почту в установщике"
		# Тема — в форме «КОД: …»: ровно её `notify.sh` прогоняет через router_relabel и подставляет
		# РЕАЛЬНУЮ модель. Без двоеточия тестер с AX3600 получал письмо «BE7000 web test» — проверка
		# почты первым делом сообщала о чужом роутере.
		raw=$(sh "$ENODIA_DIR/notify.sh" 'BE7000: web test' 'Panel test email - notifications work.' 2>&1); code=$?
		if [ "$code" -eq 0 ]; then
			printf '{"ok":true,"code":0,"msg":"Письмо отправлено (250 queued) — проверь почту и Спам"}\n'
		else
			m=$(printf '%s' "$raw" | jesc 400)
			printf '{"ok":false,"code":%s,"msg":"SMTP отказ: %s"}\n' "$code" "$m"
		fi
		exit 0 ;;

	# --- Настройка почты из панели. notify.conf СОРСИТСЯ (`. notify.conf`) → пишем
	# БЕЗ кавычек (как десктоп), но СТРОГО валидируем поля: пароль без пробелов/шелл-
	# метасимволов (RHS присваивания не сплитится/не глобится, но пробел/`;`/`$`/бэктик
	# сломали бы sourcing/инъекция). Пустой пароль → сохраняем ПРЕЖНИЙ (не затираем).
	# ⚠️ пароль идёт по LAN в открытом HTTP — фронт предупреждает.
	write_notify_conf)
		host=$(urldecode "$(field host)"); port=$(urldecode "$(field port)")
		user=$(urldecode "$(field user)"); to=$(urldecode "$(field to)")
		pass=$(urldecode "$(field pass)"); tls=$(field tls)
		[ -n "$host" ] || host=smtp.yandex.ru
		echo "$host" | grep -qE '^[A-Za-z0-9.-]+$'                  || fail "SMTP_HOST: только буквы/цифры/точки/дефис"
		echo "$port" | grep -qE '^[0-9]+$'                         || port=465
		echo "$user" | grep -qE '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$' || fail "SMTP_USER: нужен email"
		echo "$to"   | grep -qE '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$' || fail "MAIL_TO: нужен email"
		# Шифрование: implicit (465, сразу TLS) / starttls (587/25, апгрейд) / auto (по порту в notify.sh).
		case "$tls" in implicit|starttls) ;; *) tls=auto ;; esac
		if [ -n "$pass" ]; then
			echo "$pass" | grep -qE '^[A-Za-z0-9._@!#%^*+=:~-]+$' || fail "пароль: недопустимые символы (без пробелов/кавычек/шелл-знаков; экзотический — задай в установщике с ПК)"
		else
			pass=$(sed -n 's/^SMTP_PASS=//p' "$ENODIA_STATE/notify.conf" 2>/dev/null | head -1)
			[ -n "$pass" ] || fail "пароль пуст и прежнего нет — введи пароль приложения"
		fi
		{ echo "# notify.conf — записан веб-панелью"; echo "SMTP_HOST=$host"; echo "SMTP_PORT=$port"; echo "SMTP_TLS=$tls";
		  echo "SMTP_USER=$user"; echo "SMTP_PASS=$pass"; echo "MAIL_TO=$to"; } > "$ENODIA_STATE/notify.conf.new" \
			&& mv "$ENODIA_STATE/notify.conf.new" "$ENODIA_STATE/notify.conf" && chmod 600 "$ENODIA_STATE/notify.conf" \
			|| { rm -f "$ENODIA_STATE/notify.conf.new"; fail "не удалось записать notify.conf"; }
		printf '{"ok":true,"code":0,"msg":"Почта сохранена (%s) — отправь тест-письмо"}\n' "$user"; exit 0 ;;

	# --- Центр уведомлений: журнал событий. Читается через data?section=events;
	# здесь только две записи — отметка «прочитано» (одна на весь журнал) и очистка.
	# Формат хранения знает events.sh, CGI в него не лезет.
	events_read|events_clear)
		[ -f "$ENODIA_DIR/events.sh" ] || fail "журнал событий недоступен — обнови скрипты роутера"
		case "$act" in
			events_read)  sh "$ENODIA_DIR/events.sh" mark-read >/dev/null 2>&1; printf '{"ok":true,"code":0,"msg":"Отмечено прочитанным"}\n' ;;
			events_clear) sh "$ENODIA_DIR/events.sh" clear     >/dev/null 2>&1; printf '{"ok":true,"code":0,"msg":"Журнал событий очищен"}\n' ;;
		esac
		exit 0 ;;

	# --- Режим VPN: авто-failover (две оси) — простые записи флагов (туннель НЕ трогают,
	# меняют лишь поведение watchdog). home без .failover-home → ставим текущий .active.
	set_failover)
		mode=$(field mode); esc=$(field esc)
		case "$mode" in off|sticky|home) ;; *) fail "режим: off|sticky|home" ;; esac
		case "$esc"  in cross|direct) ;; *) esc=cross ;; esac
		echo "$mode" > "$ENODIA_STATE/.failover-mode"
		echo "$esc"  > "$ENODIA_STATE/.failover-escalate"
		if [ "$mode" = home ] && [ ! -s "$ENODIA_STATE/.failover-home" ]; then
			a=$(cat "$ENODIA_STATE/.active" 2>/dev/null | tr -d ' \r\n'); [ -n "$a" ] && echo "$a" > "$ENODIA_STATE/.failover-home"
		fi
		printf '{"ok":true,"code":0,"msg":"Failover: режим %s, при исчерпании протокола — %s"}\n' "$mode" "$esc"; exit 0 ;;
	# full-tunnel («весь трафик через VPN») — apply-bypass безопасен (safety_off снимает).
	full_tunnel_on)  run apply-bypass.sh full-tunnel on ;;
	full_tunnel_off) run apply-bypass.sh full-tunnel off ;;

	# --- Списки IP: обновить сейчас / сменить источник / режим кастомного файла. -----
	# iplist.conf переживает ребут; источник недоступен → маршрутизация НЕ падает.
	iplist_update) run iplist-update.sh ;;
	set_iplist_source)
		src=$(field src); url=$(urldecode "$(field url)"); sites=$(urldecode "$(field sites)")
		# Сохраняем кастом-режим (его правит отдельное действие), переписываем источник.
		mode=$(sed -n 's/^IPLIST_CUSTOM_MODE=//p' "$ENODIA_STATE/iplist.conf" 2>/dev/null | head -1 | tr -d '"\\')
		uline=""; sline=""
		case "$src" in
			all)   : ;;  # ни URL, ни sites — дефолт (весь cidr4 opencck)
			sites) echo "$sites" | grep -qE '^[A-Za-z0-9 ._-]+$' || fail "сайты: домены через пробел"; sline="IPLIST_SITES=\"$sites\"" ;;
			url)   echo "$url" | grep -qE '^https?://[A-Za-z0-9./?=&_:%@-]+$' || fail "URL: http(s):// и безопасные символы"; uline="IPLIST_URL=\"$url\"" ;;
			*) fail "источник: all|sites|url" ;;
		esac
		{ echo "# iplist.conf — записан веб-панелью"; [ -n "$uline" ] && echo "$uline"; [ -n "$sline" ] && echo "$sline";
		  [ -n "$mode" ] && echo "IPLIST_CUSTOM_MODE=\"$mode\""; } > "$ENODIA_STATE/iplist.conf.new" \
			&& mv "$ENODIA_STATE/iplist.conf.new" "$ENODIA_STATE/iplist.conf" \
			|| { rm -f "$ENODIA_STATE/iplist.conf.new"; fail "не удалось записать iplist.conf"; }
		printf '{"ok":true,"code":0,"msg":"Источник списка IP: %s (применится при обновлении)"}\n' "$src"; exit 0 ;;
	set_iplist_custom_mode)
		mode=$(field mode)
		case "$mode" in off|only|merge) ;; *) fail "режим: off|only|merge" ;; esac
		# read-modify-write: сохраняем URL/SITES, меняем/убираем IPLIST_CUSTOM_MODE.
		url=$(sed -n   's/^IPLIST_URL=//p'   "$ENODIA_STATE/iplist.conf" 2>/dev/null | head -1)
		sites=$(sed -n 's/^IPLIST_SITES=//p' "$ENODIA_STATE/iplist.conf" 2>/dev/null | head -1)
		{ echo "# iplist.conf — записан веб-панелью"; [ -n "$url" ] && echo "IPLIST_URL=$url"; [ -n "$sites" ] && echo "IPLIST_SITES=$sites";
		  [ "$mode" != off ] && echo "IPLIST_CUSTOM_MODE=\"$mode\""; } > "$ENODIA_STATE/iplist.conf.new" \
			&& mv "$ENODIA_STATE/iplist.conf.new" "$ENODIA_STATE/iplist.conf" \
			|| { rm -f "$ENODIA_STATE/iplist.conf.new"; fail "не удалось записать iplist.conf"; }
		printf '{"ok":true,"code":0,"msg":"Кастомный список: режим %s (обнови список, чтобы применить)"}\n' "$mode"; exit 0 ;;
	upload_custom_iplist)
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null)
		[ -n "$content" ] || fail "пустой или битый файл (base64)"
		# Валидация: каждая непустая/некомментарий строка — IPv4 или CIDR.
		bad=$(printf '%s' "$content" | tr -d '\r' | grep -vE '^[[:space:]]*(#.*)?$' | grep -vE '^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?[[:space:]]*$' | head -1)
		[ -z "$bad" ] || fail "строка не IPv4/CIDR: $bad"
		printf '%s' "$content" | tr -d '\r' > "$ENODIA_STATE/iplist.custom.new" && mv "$ENODIA_STATE/iplist.custom.new" "$ENODIA_STATE/iplist.custom" && chmod 600 "$ENODIA_STATE/iplist.custom" \
			|| { rm -f "$ENODIA_STATE/iplist.custom.new"; fail "не удалось записать iplist.custom"; }
		n=$(grep -cE '^[0-9]' "$ENODIA_STATE/iplist.custom" 2>/dev/null); case "$n" in ''|*[!0-9]*) n=0 ;; esac
		printf '{"ok":true,"code":0,"msg":"Кастомный список загружен (%s записей). Включи режим only/merge и обнови."}\n' "$n"; exit 0 ;;

	# NB: верб `proto_install` (фиксированные наборы `awg-xray` и т.п.) отсюда СНЯТ. Панель его не
	# звала с тех пор, как наборы заменила карточка «Компоненты», а держать в CGI ветку, которая
	# качает мегабайты и переключает несущую, но никем не вызывается, — лишняя поверхность.
	# Сам `proto-install.sh` жив и нужен: его зовут CLI и `enodia.py` напрямую по SSH, минуя панель.

	# --- Компоненты à la carte (packages.sh): ОДИН план «поставить X, снять Y» одним прогоном.
	# Почему не два действия install/remove: между прогонами роутер остаётся без транспорта, а на
	# 20-МБ флеше замена (снять Xray → поставить Hysteria2) двумя заходами вообще не влезает.
	# Прогресс и лок — ТЕ ЖЕ .proto-install.{state,log} + /tmp/proto-install.lock, что у смены
	# набора: фронт уже умеет их опрашивать, а «две установки разом» лок и придуман не пускать.
	pkg_apply)
		pins=$(field ins); pdel=$(field del)
		# «-» = ПУСТАЯ сторона плана (так шлёт панель, так же зовётся CLI). Разбираем ДО whitelist'а:
		# дефис не входит в [a-z0-9,] и ловился как «недопустимый список», из-за чего любой план
		# в одну сторону («только поставить» / «только снять») отвергался на входе, а проходила
		# лишь замена сразу в обе. Поймано кликом по живой панели.
		[ "$pins" = "-" ] && pins=""
		[ "$pdel" = "-" ] && pdel=""
		# В shell уходит АРГУМЕНТОМ — только имена связок через запятую, никакого urldecode.
		case "$pins" in *[!a-z0-9,]*) fail "недопустимый список компонентов" ;; esac
		case "$pdel" in *[!a-z0-9,]*) fail "недопустимый список компонентов" ;; esac
		[ -n "$pins$pdel" ] || fail "план пуст — нечего применять"
		pkg_bg "${pins:--}" "${pdel:--}" "Изменение компонентов запущено. Идёт удаление/скачивание — следи за прогрессом." ;;

	# --- ЧИСТКА ФЛЕША (clean.sh — единственная истина «что считается мусором»).
	# Синхронно, а не через pkg_bg: снос пары каталогов занимает доли секунды и НИЧЕГО не
	# качает, значит ни лок установки, ни экран прогресса тут не нужны — а занять общий лок
	# значило бы блокировать установку компонентов на ровном месте.
	# Группы приходят с фронта галочками и проверяются ЗДЕСЬ по белому списку: аргумент уходит
	# в sh, а «снимки» и «логи» — разной цены операции (снимок = страховка на мёртвый источник),
	# поэтому подразумевать их по умолчанию нельзя.
	disk_clean)
		[ -f "$ENODIA_DIR/clean.sh" ] || fail "clean.sh не установлен (обнови скрипты с GitHub)"
		# ГРАБЛЯ (поймана кликом по живой панели): значение ОБЯЗАНО пройти urldecode. Общий
		# фронтовый postAction() гонит параметры через encodeURIComponent, а тот кодирует
		# запятую как %2C — `tr ',' ' '` разделителя не находит и весь список приезжает ОДНИМ
		# токеном «junk%2Cramlogs» ⇒ вечное «неизвестная группа чистки». Соседний pkg_apply
		# работает без декода лишь потому, что собирает тело строкой ВРУЧНУЮ, минуя postAction;
		# декодировать здесь надёжнее, чем полагаться на способ кодирования у вызывающего.
		# Порядок «декод → whitelist» обязателен: проверяем то, что реально уйдёт в sh.
		dgr=$(urldecode "$(field groups)")
		dsel=""
		for g in $(echo "$dgr" | tr ',' ' '); do
			case "$g" in junk|snaps|ramlogs|stocklogs) dsel="$dsel $g" ;; *) fail "неизвестная группа чистки" ;; esac
		done
		[ -n "$dsel" ] || fail "не выбрано, что чистить"
		dout=$(sh "$ENODIA_DIR/clean.sh" clean $dsel 2>/dev/null | grep '^{' | tail -1)
		[ -n "$dout" ] || fail "чистка не отработала"
		printf '%s\n' "$dout"; exit 0 ;;

	# --- ВНЕШНИЙ НАКОПИТЕЛЬ (usb-offload.sh — единственная истина; переезд с проверкой копии).
	# Синхронно, как disk_clean: движок копирует 13 МБ максимум (секунды), НИЧЕГО не качает и
	# несущую не переподнимает, поэтому общий лок установки тут занимать не за что. Прогресса
	# нет намеренно — операция короче, чем время на его отрисовку.
	# Ответ отдаём словами ДВИЖКА (его stdout), а не своими: он один знает, какой бинарь не
	# поехал и почему («не запускается с этой ФС» ≠ «не хватило места»), а вторая формулировка
	# в CGI разошлась бы с первой на первой же правке.
	store_enable|store_disable)
		[ -f "$ENODIA_DIR/usb-offload.sh" ] || fail "usb-offload.sh не установлен (обнови скрипты с GitHub)"
		# Устройство приходит с фронта только у enable (выбор из списка воткнутого) и уходит
		# АРГУМЕНТОМ в sh ⇒ жёсткий whitelist: только /dev/sdXN, ничего другого.
		sdev=$(urldecode "$(field dev)")
		case "$sdev" in
			"") : ;;
			/dev/sd[a-z]|/dev/sd[a-z][0-9]|/dev/sd[a-z][0-9][0-9]) : ;;
			*) fail "неизвестное устройство" ;;
		esac
		if [ "$act" = store_enable ]; then sout=$(sh "$ENODIA_DIR/usb-offload.sh" enable $sdev 2>&1); src=$?
		else sout=$(sh "$ENODIA_DIR/usb-offload.sh" disable 2>&1); src=$?; fi
		# Многострочный отчёт движка в JSON не влезает — берём последнюю содержательную строку:
		# у обоих вербов там либо итог, либо причина отказа. Эскейп кавычек/бэкслешей — тем же
		# выражением, что в run(): в тексте движка попадаются пути, а не только буквы.
		smsg=$(printf '%s\n' "$sout" | grep -v '^ *$' | tail -1 | jesc 500)
		[ -n "$smsg" ] || smsg="накопитель: готово"
		[ "$src" = 0 ] || fail "$smsg"
		printf '{"ok":true,"code":0,"msg":"%s"}\n' "$smsg"; exit 0 ;;

	# --- УДАЛЕНИЕ (uninstall.sh — единственная истина; своей логики снятия здесь НЕТ).
	# Два уровня: deactivate (снять VPN, панель и файлы оставить) и purge (стереть всё).
	# ТРИ вещи, без которых это действие опасно:
	#  1) ФРАЗА-ПОДТВЕРЖДЕНИЕ приезжает с фронта и сверяется ЗДЕСЬ: одного «клика по красной
	#     кнопке» для необратимой операции мало, а проверка только во фронте не защищает вовсе;
	#  2) запуск ОТВЯЗАННЫЙ (spawn_bg): purge гасит наш же uhttpd — доработать в рамках запроса
	#     мы не успеем, CGI обязан ответить ДО того, как его убьют;
	#  3) ответ отдаём СРАЗУ и честно говорим, что панель сейчас исчезнет (при purge) — иначе
	#     человек видит «сеть недоступна» и думает, что сломал роутер.
	uninstall_run)
		[ -f "$ENODIA_DIR/uninstall.sh" ] || fail "uninstall.sh не установлен (обнови скрипты с GitHub)"
		umode=$(field mode)
		uphrase=$(urldecode "$(field phrase)")
		case "$umode" in deactivate|purge) : ;; *) fail "неизвестный режим удаления" ;; esac
		# Фраза — РАЗНАЯ на два режима (перепутать уровни страшнее, чем промахнуться кнопкой)
		# и принимается в ОБОИХ языках панели: англоязычному вводить «УДАЛИТЬ ВСЁ» нечем.
		if [ "$umode" = purge ]; then uok1="УДАЛИТЬ ВСЁ"; uok2="DELETE ALL"
		else uok1="ОТКЛЮЧИТЬ"; uok2="TURN OFF"; fi
		{ [ "$uphrase" = "$uok1" ] || [ "$uphrase" = "$uok2" ]; } || fail "фраза подтверждения не совпала — ничего не тронуто"
		ust=$(cat "$ENODIA_STATE/.uninstall.state" 2>/dev/null | tr -d ' \r\n')
		# RUNNING без ЖИВОГО процесса = осиротевший статус: файл лежит на флеше и переживает всё,
		# поэтому одна прерванная попытка (ребут посреди деактивации) блокировала бы кнопку
		# НАВСЕГДА, а другого способа снять VPN из панели нет. Тот же приём, что в pkg_bg выше.
		if [ "$ust" = RUNNING ]; then
			upid=$(cat /tmp/uninstall.pid 2>/dev/null | tr -d ' \r\n')
			case "$upid" in ''|*[!0-9]*) upid="" ;; esac
			[ -n "$upid" ] && kill -0 "$upid" 2>/dev/null && fail "удаление уже идёт"
		fi
		spawn_bg /tmp/uninstall.pid "$ENODIA_DIR/uninstall.sh" "$umode"
		if [ "$umode" = purge ]; then
			printf '{"ok":true,"code":0,"msg":"Полное удаление запущено. Панель сейчас закроется — это нормально. Отчёт останется в /data/enodia-uninstall.log"}\n'
		else
			printf '{"ok":true,"code":0,"msg":"Деактивация запущена. VPN снимется, панель останется работать."}\n'
		fi
		exit 0 ;;

	# --- Апдейтер с GitHub (Ф4). check — быстрая сетевая проверка версии (ничего не меняет).
	# apply-scripts/rollback — на будущее (публичный репо пока отстаёт; downgrade-guard внутри).
	gh_check)
		[ -f "$ENODIA_DIR/gh-update.sh" ] || fail "gh-update.sh не установлен (обнови панель)"
		run gh-update.sh check ;;
	gh_apply_scripts)
		[ -f "$ENODIA_DIR/gh-update.sh" ] || fail "gh-update.sh не установлен"
		st=$(cat "$ENODIA_STATE/.gh-update.state" 2>/dev/null | tr -d ' \r\n')
		[ "$st" = RUNNING ] && [ -f /tmp/gh-update.lock ] && fail "обновление уже идёт"
		echo RUNNING > "$ENODIA_STATE/.gh-update.state"
		spawn_bg /tmp/gh-update.pid -c "touch /tmp/gh-update.lock; sh '$ENODIA_DIR/gh-update.sh' self >'$ENODIA_STATE/.gh-update.log' 2>&1; sh '$ENODIA_DIR/gh-update.sh' apply-scripts >>'$ENODIA_STATE/.gh-update.log' 2>&1; echo DONE >'$ENODIA_STATE/.gh-update.state'; rm -f /tmp/gh-update.lock"
		printf '{"ok":true,"code":0,"msg":"Обновление скриптов запущено (фоном). Потом примени: Починить правила или ребут."}\n'; exit 0 ;;
	gh_rollback)
		[ -f "$ENODIA_DIR/gh-update.sh" ] || fail "gh-update.sh не установлен"
		run gh-update.sh rollback ;;

	# --- Браузер-свип ByeDPI: применяем стратегии ВЖИВУЮ к боевому ciadpi, а реальный браузер
	# грузит ассеты заблок-сайтов через активный ByeDPI (честнее curl-теста — реальный путь hev/QUIC).
	# Цикл драйвит ФРОНТ (begin → apply×N → end). Возможен ТОЛЬКО когда byedpi несёт трафик (иначе
	# браузер пойдёт мимо десинка = бессмысленно). Стратегия (args) санитизируется тем же charset'ом,
	# что set_byedpi_args (идёт неквотированно в exec ciadpi). По end/протуху lock — исходная восстанавливается.
	# ЦЕЛЬ свипа — slot=2|3|4 (ДОП-ВЫХОД со своей стратегией) либо пусто (основная несущая). Гард
	# у них РАЗНЫЙ и это принципиально: основной свип требует «byedpi = активный транспорт», а
	# выход живёт своей несущей и при awg-основном, ему нужно лишь «выход включён».
	byedpi_sweep_begin)
		[ -f "$ENODIA_DIR/transport-byedpi.sh" ] || fail "transport-byedpi.sh не установлен (обнови панель)"
		bsw=$(field slot); case "$bsw" in 2|3|4) ;; *) bsw="" ;; esac
		if [ -n "$bsw" ]; then
			sh "$ENODIA_DIR/slots.sh" list-enabled 2>/dev/null | grep -q "^$bsw	byedpi	" \
				|| fail "браузер-свип выхода возможен только когда выход ВКЛЮЧЁН"
		else
			[ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null | tr -d ' \r\n')" = byedpi ] || fail "браузер-свип возможен только когда ByeDPI несёт трафик — включи ByeDPI вверху панели"
		fi
		sh "$ENODIA_DIR/transport-byedpi.sh" sweep-begin "$bsw" >/dev/null 2>&1 \
			&& printf '{"ok":true,"code":0,"msg":"свип начат"}\n' || fail "не удалось начать свип"
		exit 0 ;;
	byedpi_sweep_apply)
		bsw=$(field slot); case "$bsw" in 2|3|4) ;; *) bsw="" ;; esac
		if [ -n "$bsw" ]; then
			sh "$ENODIA_DIR/slots.sh" list-enabled 2>/dev/null | grep -q "^$bsw	byedpi	" || fail "выход выключен — свип прерван"
		else
			[ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null | tr -d ' \r\n')" = byedpi ] || fail "ByeDPI не активен — свип прерван"
		fi
		args=$(urldecode "$(field args)")
		args=$(printf '%s' "$args" | tr '\r\n' '  ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/[[:space:]]\{1,\}/ /g')
		if [ -n "$args" ]; then
			echo "$args" | grep -qE '^[A-Za-z0-9 +,.:/=_-]+$' || fail "недопустимые символы стратегии"
		fi
		if sh "$ENODIA_DIR/transport-byedpi.sh" sweep-apply "$args" "$bsw" >/dev/null 2>&1; then up=true; else up=false; fi
		printf '{"ok":true,"code":0,"up":%s}\n' "$up"; exit 0 ;;
	byedpi_sweep_end)
		[ -f "$ENODIA_DIR/transport-byedpi.sh" ] || fail "transport-byedpi.sh не установлен"
		bsw=$(field slot); case "$bsw" in 2|3|4) ;; *) bsw="" ;; esac
		sh "$ENODIA_DIR/transport-byedpi.sh" sweep-end "$bsw" >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"свип завершён, исходная стратегия восстановлена"}\n'; exit 0 ;;

	# --- Zapret (десинк-direct, nfqws/NFQUEUE) — 5-й ТРАНСПОРТ (взаимоисключающий с туннелем). -----
	# Включение/переключение НА zapret идёт через switch_zapret (выше). Выключение — zapret_off:
	# вернуться на первый ГОТОВЫЙ не-zapret транспорт (приоритет list: awg→xray→hy2→byedpi), а если
	# туннелей нет вовсе (zapret был единственным обходом) — полный teardown zapret → прямой режим. Прежний
	# zapret_toggle убран: он звал zapret.sh on/off, двигавшие .zapret-on БЕЗ .transport →
	# рассинхрон статуса (панель читает .transport). set-cats: категории (whitelist в zapret.sh).
	# args: стратегия nfqws → .zapret-args, идёт НЕквотированно в `exec nfqws … $args` → СТРОГО
	# charset флагов nfqws (+ @ для токенов фейков @tls/@quic), отсекая shell-метасимволы = защита
	# от инъекции. reload перезапускает только nfqws.
	zapret_off)
		[ -f "$ENODIA_DIR/zapret.sh" ] || fail "zapret.sh не установлен (обнови панель)"
		[ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null | tr -d ' \r\n')" = zapret ] || fail "Zapret не активен"
		# Имя цели берётся из transport.sh list (НЕ пользовательский ввод — только whitelisted
		# транспорты), но всё равно сверяем с белым списком: в shell-команду уходит лишь проверенное.
		tgt=$(sh "$ENODIA_DIR/transport.sh" list 2>/dev/null | grep -vx zapret | head -1)
		case "$tgt" in awg|xray|hy2|byedpi) ;; *) tgt="" ;; esac
		# Нет другого готового транспорта (zapret — единственный обход) → полный teardown zapret-плагина
		# (down: nfqws убит, правила/ipset сняты, DNS на прямой). `vpn-toggle off` СНИМЕТ несущую и сам
		# (с 23.08.2026 он спрашивает `transport.sh marking` и для немаркирующих зовёт down), но эта
		# кнопка про ДРУГОЕ: тумблер «Выключить VPN» снимает ПРОВОДКУ, сохраняя намерение, а здесь
		# человек выключает Zapret СОВСЕМ — значит надо стереть и `.transport`, иначе heal поднимет
		# его обратно на первом же буте. Две семантики, две ветки.
		if [ -n "$tgt" ]; then
			run transport.sh switch "$tgt"
		else
			# down zapret по контракту НЕ трогает .transport → панель (читает .transport) продолжала бы
			# рисовать zapret ВКЛ, а heal на буте воскресил бы его (transport.sh up zapret). Сбрасываем
			# .transport и .zapret-on здесь. run не годится (он exit'ает) — эмитим JSON вручную.
			raw=$(sh "$ENODIA_DIR/transport.sh" down zapret 2>&1); code=$?
			rm -f "$ENODIA_STATE/.transport" "$ENODIA_STATE/.zapret-on" 2>/dev/null
			msg=$(printf '%s' "$raw" | jesc 800)
			printf '{"ok":%s,"code":%s,"msg":"Zapret выключен, прямой режим. %s"}\n' "$([ "$code" -eq 0 ] && echo true || echo false)" "$code" "$msg"
			exit 0
		fi ;;
	set_zapret_args)
		args=$(urldecode "$(field args)")
		args=$(printf '%s' "$args" | tr '\r\n' '  ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/[[:space:]]\{1,\}/ /g')
		if [ -z "$args" ]; then
			rm -f "$ENODIA_STATE/.zapret-args"
			msg="Стратегия сброшена на дефолт"
		else
			echo "$args" | grep -qE '^[A-Za-z0-9 +,.:/=_@-]+$' || fail "недопустимые символы — разрешены флаги nfqws (буквы, цифры, пробел, + , . : / = _ @ -)"
			printf '%s\n' "$args" > "$ENODIA_STATE/.zapret-args.new" && mv "$ENODIA_STATE/.zapret-args.new" "$ENODIA_STATE/.zapret-args" || fail "не удалось сохранить стратегию"
			msg="Стратегия сохранена"
		fi
		if [ -f "$ENODIA_STATE/.zapret-on" ]; then
			sh "$ENODIA_DIR/zapret.sh" reload >/dev/null 2>&1 && msg="$msg, nfqws перезапущен" || msg="$msg, но перезапуск nfqws не удался (см. статус)"
		else
			msg="$msg (применится при включении zapret)"
		fi
		printf '{"ok":true,"code":0,"msg":"%s"}\n' "$msg"; exit 0 ;;

	# NB: вербов `zapret_install`/`zapret_remove` здесь БОЛЬШЕ НЕТ. Ставит и снимает nfqws тот же
	# движок (`pkg_apply` → packages.sh), а ВТОРАЯ точка входа в UI означала вторую дорогу мимо
	# общего плана: цена операции («что освободится», «чего не хватит») там не считалась, и кнопка
	# «Удалить nfqws» однажды уже сносила бинарь из-под живого zapret-выхода. Карточка Zapret
	# осталась на месте — из неё теперь ведёт ссылка в «Компоненты».

	# --- Браузер-свип Zapret: применяем стратегии nfqws ВЖИВУЮ, реальный браузер грузит favicon
	# заблок-сайтов через настоящий форвард (честнее curl с роутера — тот мерил бы путь OUTPUT).
	# Возможен только при включённом zapret. Цикл драйвит ФРОНТ (begin → apply×N → end).
	zapret_sweep_begin)
		[ -f "$ENODIA_DIR/zapret.sh" ] || fail "zapret.sh не установлен (обнови панель)"
		[ -f "$ENODIA_STATE/.zapret-on" ] || fail "браузер-свип возможен только при включённом Zapret — включи вверху карточки"
		sh "$ENODIA_DIR/zapret.sh" sweep-begin >/dev/null 2>&1 \
			&& printf '{"ok":true,"code":0,"msg":"свип начат"}\n' || fail "не удалось начать свип"
		exit 0 ;;
	zapret_sweep_apply)
		[ -f "$ENODIA_STATE/.zapret-on" ] || fail "Zapret выключен — свип прерван"
		args=$(urldecode "$(field args)")
		args=$(printf '%s' "$args" | tr '\r\n' '  ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/[[:space:]]\{1,\}/ /g')
		if [ -n "$args" ]; then
			echo "$args" | grep -qE '^[A-Za-z0-9 +,.:/=_@-]+$' || fail "недопустимые символы стратегии"
		fi
		if sh "$ENODIA_DIR/zapret.sh" sweep-apply "$args" >/dev/null 2>&1; then up=true; else up=false; fi
		printf '{"ok":true,"code":0,"up":%s}\n' "$up"; exit 0 ;;
	zapret_sweep_end)
		[ -f "$ENODIA_DIR/zapret.sh" ] || fail "zapret.sh не установлен"
		sh "$ENODIA_DIR/zapret.sh" sweep-end >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"свип завершён, исходная стратегия восстановлена"}\n'; exit 0 ;;

	# --- Менеджер источников списков (generic по категории) + блокировка рекламы/IP. -----
	# Реестр источников на /data (lists-update.sh). Мутации мгновенные; обновление (закачка) —
	# фоном через spawn_bg, прогресс в lists/<cat>/.update.state (панель опрашивает data?section=sources).
	src_add_url)
		cat=$(field cat); _valid_lcat "$cat" || fail "неизвестная категория"
		url=$(urldecode "$(field url)"); fmt=$(field format); label=$(urldecode "$(field label)")
		echo "$url" | grep -qE '^https?://[A-Za-z0-9./?=&_:%~@+-]+$' || fail "URL: http(s):// и безопасные символы"
		case "$fmt" in auto|cidr|hosts|dnsmasq|adblock|domain) ;; *) fmt=auto ;; esac
		label=$(printf '%s' "$label" | tr -d '\t\r\n"\\' | cut -c1-120)
		sh "$ENODIA_DIR/lists-update.sh" add-url "$cat" "$url" "$fmt" "$label" >/dev/null 2>&1 || fail "не удалось добавить источник"
		# Реконсиляция: сразу пересобрать артефакт под новый реестр (не ждать клиентский дебаунс —
		# он теряется при уходе со страницы → реестр и применённое расходятся). Дедуп по pidfile.
		spawn_bg "/tmp/lists-$cat.pid" "$ENODIA_DIR/lists-update.sh" update "$cat"
		printf '{"ok":true,"code":0,"msg":"Источник добавлен — применяю"}\n'; exit 0 ;;
	src_add_blob)
		cat=$(field cat); _valid_lcat "$cat" || fail "неизвестная категория"
		btype=$(field btype); case "$btype" in file|text) ;; *) fail "тип: file|text" ;; esac
		fmt=$(field format); case "$fmt" in auto|cidr|hosts|dnsmasq|adblock|domain) ;; *) fmt=auto ;; esac
		label=$(urldecode "$(field label)"); label=$(printf '%s' "$label" | tr -d '\t\r\n"\\' | cut -c1-120)
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null)
		[ -n "$content" ] || fail "пустой или битый файл (base64)"
		tmp=/tmp/src-blob.$$; printf '%s' "$content" | tr -d '\r' > "$tmp"
		id=$(sh "$ENODIA_DIR/lists-update.sh" add-blob "$cat" "$btype" "$fmt" "$label" "$tmp" 2>/dev/null); rm -f "$tmp"
		[ -n "$id" ] || fail "не удалось добавить источник"
		spawn_bg "/tmp/lists-$cat.pid" "$ENODIA_DIR/lists-update.sh" update "$cat"   # реконсиляция (см. src_add_url)
		printf '{"ok":true,"code":0,"msg":"Источник добавлен — применяю"}\n'; exit 0 ;;
	src_edit_blob)   # перезаписать содержимое существующего file/text-источника (правка «вставленного текста»)
		cat=$(field cat); _valid_lcat "$cat" || fail "неизвестная категория"
		id=$(field id); echo "$id" | grep -qE '^s[0-9]+$' || fail "плохой id"
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null)
		[ -n "$content" ] || fail "пустой или битый текст (base64)"
		tmp=/tmp/src-blob.$$; printf '%s' "$content" | tr -d '\r' > "$tmp"
		sh "$ENODIA_DIR/lists-update.sh" set-blob "$cat" "$id" "$tmp" >/dev/null 2>&1; rc=$?; rm -f "$tmp"
		[ "$rc" = 0 ] || fail "не удалось сохранить (URL-источник не редактируется здесь)"
		spawn_bg "/tmp/lists-$cat.pid" "$ENODIA_DIR/lists-update.sh" update "$cat"   # реконсиляция под новый текст
		printf '{"ok":true,"code":0,"msg":"Текст обновлён — применяю"}\n'; exit 0 ;;
	src_del)
		cat=$(field cat); _valid_lcat "$cat" || fail "неизвестная категория"
		id=$(field id); echo "$id" | grep -qE '^s[0-9]+$' || fail "плохой id"
		sh "$ENODIA_DIR/lists-update.sh" del "$cat" "$id" >/dev/null 2>&1
		spawn_bg "/tmp/lists-$cat.pid" "$ENODIA_DIR/lists-update.sh" update "$cat"   # реконсиляция: очистить/пересобрать артефакт под пустой/усечённый реестр
		printf '{"ok":true,"code":0,"msg":"Источник удалён — применяю"}\n'; exit 0 ;;
	src_toggle)
		cat=$(field cat); _valid_lcat "$cat" || fail "неизвестная категория"
		id=$(field id); echo "$id" | grep -qE '^s[0-9]+$' || fail "плохой id"
		en=$(field en); case "$en" in 0|1) ;; *) fail "en: 0|1" ;; esac
		sh "$ENODIA_DIR/lists-update.sh" toggle "$cat" "$id" "$en" >/dev/null 2>&1
		spawn_bg "/tmp/lists-$cat.pid" "$ENODIA_DIR/lists-update.sh" update "$cat"   # реконсиляция под изменённый реестр
		printf '{"ok":true,"code":0,"msg":"Источник %s — применяю"}\n' "$([ "$en" = 1 ] && echo включён || echo выключен)"; exit 0 ;;
	src_refresh)
		cat=$(field cat); _valid_lcat "$cat" || fail "неизвестная категория"
		[ -f "$ENODIA_DIR/lists-update.sh" ] || fail "lists-update.sh не установлен (обнови панель)"
		spawn_bg "/tmp/lists-$cat.pid" "$ENODIA_DIR/lists-update.sh" update "$cat"
		printf '{"ok":true,"code":0,"msg":"Обновление запущено (фоном) — следи за прогрессом"}\n'; exit 0 ;;
	# Блокировка: мастер-переключатель категории (adblock/ipblock). Вкл → сразу качаем/применяем фоном.
	block_enable)
		cat=$(field cat); _lcat_switchable "$cat" || fail "категория: adblock|ipblock|zapret-cidr|zapret-dom"
		on=$(field on); case "$on" in 0|1) ;; *) fail "on: 0|1" ;; esac
		if [ "$on" = 1 ]; then
			if [ "$cat" = ipblock ]; then
				# ipblock: guarded-путь (safe-enable = вкл+применить+self-test с авто-откатом, слой 3).
				# Фоном (переживает обрыв SSH). Панель следит за .guard.state через data?section=sources.
				spawn_bg "/tmp/lists-$cat.pid" "$ENODIA_DIR/lists-update.sh" safe-enable "$cat"
				printf '{"ok":true,"code":0,"msg":"Включаю блокировку IP с проверкой связи — откачу автоматически, если оборвётся"}\n'; exit 0
			fi
			sh "$ENODIA_DIR/lists-update.sh" enable "$cat" 1 >/dev/null 2>&1
			spawn_bg "/tmp/lists-$cat.pid" "$ENODIA_DIR/lists-update.sh" update "$cat"
			printf '{"ok":true,"code":0,"msg":"%s включён — идёт загрузка списков"}\n' "$(_lcat_label "$cat")"; exit 0
		fi
		sh "$ENODIA_DIR/lists-update.sh" enable "$cat" 0 >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"%s выключен"}\n' "$(_lcat_label "$cat")"; exit 0 ;;
	block_allow)
		cat=$(field cat); case "$cat" in adblock|ipblock) ;; *) fail "категория: adblock|ipblock" ;; esac
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null)
		tmp=/tmp/allow.$$; printf '%s' "$content" | tr -d '\r' > "$tmp"
		sh "$ENODIA_DIR/lists-update.sh" allow-set "$cat" "$tmp" >/dev/null 2>&1; rm -f "$tmp"
		printf '{"ok":true,"code":0,"msg":"Белый список сохранён (применится при обновлении)"}\n'; exit 0 ;;
	# Пакетное добавление доменов/подсетей (текст/файл base64 или URL) — через domain.sh/apply-bypass.sh.
	bulk_domain)
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null); [ -n "$content" ] || fail "пусто"
		n=$(printf '%s' "$content" | bulk_domains)
		printf '{"ok":true,"code":0,"msg":"Добавлено доменов в туннель: %s"}\n' "$n"; exit 0 ;;
	# Закачка списка — ОБЩИМ слоем subs-lib.sh (sub_fetch). Свой `curl -s` здесь был ЧЕТВЁРТОЙ копией
	# и успел разойтись с оригиналом сразу по четырём пунктам: без `--fail` страница 404 приезжала
	# как «список» (замер: из типовой строки ошибки вытаскивается ДВА «домена» — они молча
	# становились правилами), без `-L` легальная ссылка с редиректом давала «не удалось скачать»,
	# без потолка тело целиком ложилось в переменную (а это ОЗУ роутера), и гард SSRF проверял
	# только ИСХОДНЫЙ адрес. sub_fetch закрывает всё это одним местом (гард на КАЖДОМ хопе).
	bulk_domain_url)
		url=$(urldecode "$(field url)"); echo "$url" | grep -qE '^https?://[A-Za-z0-9./?=&_:%~@+-]+$' || fail "URL: http(s):// и безопасные символы"
		_bu="/tmp/bulk-url.$$"
		sub_fetch "$url" "$_bu" -f || { rm -f "$_bu" 2>/dev/null; fail "не удалось скачать список (недоступен, пустой или адрес запрещён)"; }
		n=$(bulk_domains < "$_bu"); rm -f "$_bu" 2>/dev/null
		printf '{"ok":true,"code":0,"msg":"Добавлено доменов в туннель: %s"}\n' "$n"; exit 0 ;;
	bulk_dst)
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null); [ -n "$content" ] || fail "пусто"
		n=$(printf '%s' "$content" | bulk_dsts)
		printf '{"ok":true,"code":0,"msg":"Выведено мимо VPN: %s"}\n' "$n"; exit 0 ;;
	bulk_dst_url)
		url=$(urldecode "$(field url)"); echo "$url" | grep -qE '^https?://[A-Za-z0-9./?=&_:%~@+-]+$' || fail "URL: http(s):// и безопасные символы"
		_bu="/tmp/bulk-url.$$"
		sub_fetch "$url" "$_bu" -f || { rm -f "$_bu" 2>/dev/null; fail "не удалось скачать список (недоступен, пустой или адрес запрещён)"; }
		n=$(bulk_dsts < "$_bu"); rm -f "$_bu" 2>/dev/null
		printf '{"ok":true,"code":0,"msg":"Выведено мимо VPN: %s"}\n' "$n"; exit 0 ;;

	# --- Гео-категории (geo.sh): страны/сервисы/заблок-в-РФ → в VPN / мимо VPN / блок ---
	# geo_set пишет ТОЛЬКО выбор действия (мгновенно, без сети); сборку сетов зовёт фронт следом:
	# geo_apply (собрать из кэша, докачивая лишь недостающие ключи — дёшево, на смену действия) или
	# geo_update (принудительно перекачать все включённые — кнопка «Обновить списки» и cron).
	geo_set)
		# ВАЖНО: поле выбора называем act, НЕ action — иначе оно КОЛЛИДИРУЕТ с action=geo_set
		# (верб), и field action вернул бы первый матч «geo_set» вместо направления → всегда fail.
		key=$(field key); gact=$(field act)
		# key санируем charset'ом (в shell уходит только [a-z0-9-]); geo.sh set сам сверяет с каталогом.
		echo "$key" | grep -qE '^[a-z0-9-]+$' || fail "недопустимый ключ"
		case "$gact" in vpn|bypass|block|desync|off) ;; *) fail "действие: vpn|bypass|block|desync|off" ;; esac
		[ -f "$ENODIA_DIR/geo.sh" ] || fail "geo.sh не установлен (обнови панель)"
		run geo.sh set "$key" "$gact" ;;
	geo_slot)
		# Привязка гео-категории к доп-выходу (Ф1b, зеркало grp_slot): пишет ТОЛЬКО реестр —
		# пересборку фронт зовёт следом (geo_apply), как после geo_set.
		key=$(field key); slot=$(field slot)
		echo "$key" | grep -qE '^[a-z0-9-]+$' || fail "недопустимый ключ"
		case "$slot" in 0|2|3|4) ;; *) fail "доп-выход: 0, 2, 3 или 4" ;; esac
		[ -f "$ENODIA_DIR/geo.sh" ] || fail "geo.sh не установлен (обнови панель)"
		run geo.sh slot "$key" "$slot" ;;
	geo_preset)
		# Чип-пресет на десинк-выходе (Ф1b): включить/выключить гео-категорию (v2fly-*) с привязкой
		# к слоту одним действием. on=1: set vpn + slot (реестр, синхронно) → фоновая пересборка
		# (do_build медленный при первом резолве v2fly-каталога). on=0: set off. Ключ — узкий
		# whitelist пресетов (v2fly-youtube|discord|telegram), slot строгий 2|3|4.
		key=$(field key); slot=$(field slot); on=$(field on)
		case "$key" in v2fly-youtube|v2fly-discord|v2fly-telegram) ;; *) fail "неизвестный пресет" ;; esac
		case "$slot" in 2|3|4) ;; *) fail "битый выход" ;; esac
		case "$on" in 0|1) ;; *) fail "нужно 0|1" ;; esac
		[ -f "$ENODIA_DIR/geo.sh" ] || fail "geo.sh не установлен (обнови панель)"
		if [ "$on" = 1 ]; then
			sh "$ENODIA_DIR/geo.sh" set "$key" vpn >/dev/null 2>&1
			sh "$ENODIA_DIR/geo.sh" slot "$key" "$slot" >/dev/null 2>&1
		else
			sh "$ENODIA_DIR/geo.sh" set "$key" off >/dev/null 2>&1
		fi
		spawn_bg /tmp/geo.pid "$ENODIA_DIR/geo.sh" apply
		printf '{"ok":true,"code":0,"msg":"%s"}\n' \
			"$([ "$on" = 1 ] && echo 'Привязываю пресет к выходу (фоном)' || echo 'Отвязываю пресет (фоном)')"; exit 0 ;;
	geo_apply)
		[ -f "$ENODIA_DIR/geo.sh" ] || fail "geo.sh не установлен (обнови панель)"
		spawn_bg /tmp/geo.pid "$ENODIA_DIR/geo.sh" apply
		printf '{"ok":true,"code":0,"msg":"Применяю гео-правила (фоном)"}\n'; exit 0 ;;
	geo_update)
		[ -f "$ENODIA_DIR/geo.sh" ] || fail "geo.sh не установлен (обнови панель)"
		spawn_bg /tmp/geo.pid "$ENODIA_DIR/geo.sh" update
		printf '{"ok":true,"code":0,"msg":"Обновление гео-списков запущено (фоном)"}\n'; exit 0 ;;
	geo_provider)
		# выбор провайдера на тип (service→rf-geosite|v2fly, country→ipdeny, blocked→rf-geoip).
		# provider-set сам пересобирает из кэша (каталог ключей типа меняется) — синхронно, дёшево.
		ptype=$(field ptype); pid=$(field pid)
		case "$ptype" in service|country|blocked) ;; *) fail "тип провайдера: service|country|blocked" ;; esac
		echo "$pid" | grep -qE '^[a-z0-9-]+$' || fail "недопустимый провайдер"
		[ -f "$ENODIA_DIR/geo.sh" ] || fail "geo.sh не установлен (обнови панель)"
		run geo.sh provider-set "$ptype" "$pid" ;;
	geo_freshness)
		# фоновое обновление дат апстрим-коммитов (GitHub API) — панель зовёт при открытии модалки.
		[ -f "$ENODIA_DIR/geo.sh" ] || fail "geo.sh не установлен (обнови панель)"
		spawn_bg /tmp/geo-fresh.pid "$ENODIA_DIR/geo.sh" freshness
		printf '{"ok":true,"code":0,"msg":"Обновляю даты апстрима (фоном)"}\n'; exit 0 ;;

	*)           fail "неизвестное действие" ;;
esac
